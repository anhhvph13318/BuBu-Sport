<script>
    function setCookie(cname, cvalue, exdays) {
        const d = new Date();
        d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
        let expires = "expires=" + d.toUTCString();
        document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/";
    }

    function getCookie(cname) {
        let name = cname + "=";
        let ca = document.cookie.split(';');
        for (let i = 0; i < ca.length; i++) {
            let c = ca[i];
            while (c.charAt(0) == ' ') {
                c = c.substring(1);
            }
            if (c.indexOf(name) == 0) {
                return c.substring(name.length, c.length);
            }
        }
        return "";
    }

    function showTranslationLoading() {
        let loadingOverlay = document.getElementById('translation-loading');
        if (!loadingOverlay) {
            loadingOverlay = document.createElement('div');
            loadingOverlay.id = 'translation-loading';
            loadingOverlay.innerHTML = `
                <div class="loading-spinner"></div>
                <div class="loading-text">Please wait...</div>
            `;
            document.body.appendChild(loadingOverlay);
        }
        loadingOverlay.style.display = 'flex';
    }

    function hideTranslationLoading() {
        const loadingOverlay = document.getElementById('translation-loading');
        if (loadingOverlay) {
            loadingOverlay.style.display = 'none';
        }
    }

    // Global translation cache
    const translationCache = {};

    // Function to collect all translatable elements including hidden ones
    function collectAllTranslatableElements() {
        const allElements = [];
        const translationMap = new Map();
        const elementsToExclude = ['SCRIPT', 'STYLE', 'NOSCRIPT', 'IFRAME', 'OBJECT', 'SVG'];

        // Save original visibility state
        const hiddenElements = [];

        // Temporarily make all elements visible to collect hidden ones
        document.querySelectorAll('.dropdown-menu, .cart-dropdown, [style*="display: none"], [style*="display:none"]').forEach(el => {
            if (getComputedStyle(el).display === 'none') {
                hiddenElements.push({
                    element: el,
                    display: el.style.display
                });
                el.style.display = 'block';
                el.dataset.temporarilyVisible = 'true';
            }
        });

        // Helper function to traverse the DOM
        function traverseNodes(node) {
            if (!node || elementsToExclude.includes(node.nodeName)) return;

            // Handle placeholders
            if ((node.nodeName === 'INPUT' || node.nodeName === 'TEXTAREA') &&
                node.placeholder && node.placeholder.trim() !== '') {
                const text = node.placeholder.trim();
                if (text) {
                    if (!translationMap.has(text)) {
                        translationMap.set(text, []);
                    }
                    translationMap.get(text).push({ element: node, type: 'placeholder' });
                }
            }

            // Handle text nodes
            if (node.nodeType === Node.TEXT_NODE &&
                node.textContent &&
                node.textContent.trim() !== '' &&
                node.parentNode.nodeName !== 'I') {
                const text = node.textContent.trim();
                if (text) {
                    if (!translationMap.has(text)) {
                        translationMap.set(text, []);
                    }
                    translationMap.get(text).push({ element: node, type: 'textNode' });
                }
            }

            // Traverse child nodes
            for (let i = 0; i < node.childNodes.length; i++) {
                traverseNodes(node.childNodes[i]);
            }
        }

        // Traverse the entire document
        traverseNodes(document.body);

        // Convert map to array for API processing
        translationMap.forEach((elements, text) => {
            allElements.push({
                text: text,
                elements: elements
            });
        });

        // Restore original visibility
        hiddenElements.forEach(item => {
            item.element.style.display = item.display;
            delete item.element.dataset.temporarilyVisible;
        });

        return allElements;
    }

    function translateWebsite(targetLanguage, forceTranslate = false) {
        return new Promise((resolve, reject) => {
            const apiKey = 'u2VNPSh3LQDFDhifFVHcxawkrkEZpWNThHE8cBXlQEEvB9Xl797jJQQJ99BCACULyCpXJ3w3AAAbACOGEGa2';
            const endpoint = 'https://api.cognitive.microsofttranslator.com/';
            const location = 'global';
            const sourceLanguage = 'vi'; // Always treat Vietnamese as the source language

            // Skip if target language is default or vi
            if (targetLanguage === 'default') {
                // Reset to original content
                resetToOriginalContent();
                setCookie('selectedLanguage', 'default', 30);
                updateLanguageUI('default');
                resolve();
                return;
            }

            if (targetLanguage === 'vi') {
                setCookie('selectedLanguage', 'vi', 30);
                updateLanguageUI('vi');
                resolve();
                return;
            }

            // Cache key based on source-target language pair and URL
            const cacheKey = `${sourceLanguage}-${targetLanguage}-${window.location.pathname}`;

            // Check memory cache first (for faster response)
            if (translationCache[cacheKey] && !forceTranslate) {
                applyTranslations(translationCache[cacheKey]);
                setCookie('selectedLanguage', targetLanguage, 30);
                updateLanguageUI(targetLanguage);
                resolve();
                return;
            }

            // Then check localStorage
            const cachedTranslation = localStorage.getItem(cacheKey);
            if (cachedTranslation && !forceTranslate) {
                const translations = JSON.parse(cachedTranslation);
                translationCache[cacheKey] = translations; // Update memory cache
                applyTranslations(translations);
                setCookie('selectedLanguage', targetLanguage, 30);
                updateLanguageUI(targetLanguage);
                resolve();
                return;
            }

            // Collect all translatable elements including hidden ones
            const allElements = collectAllTranslatableElements();

            // Prepare batches for translation
            const batches = prepareBatches(allElements);

            // Process all batches
            translateBatches(batches, sourceLanguage, targetLanguage, apiKey, endpoint, location)
                .then(translations => {
                    // Apply translations
                    applyTranslations(translations);

                    // Cache translations
                    translationCache[cacheKey] = translations;
                    localStorage.setItem(cacheKey, JSON.stringify(translations));

                    // Update UI
                    setCookie('selectedLanguage', targetLanguage, 30);
                    updateLanguageUI(targetLanguage);
                    resolve(translations);
                })
                .catch(error => {
                    console.error('Translation error:', error);
                    reject(error);
                });
        });
    }

    function resetToOriginalContent() {
        // Reload the page without language parameter
        const url = new URL(window.location.href);
        url.searchParams.delete('lang');
        window.location.href = url.toString();
    }

    function prepareBatches(elements) {
        const maxElementsPerRequest = 100;
        const maxCharactersPerRequest = 5000; // Reduced to ensure we stay within API limits
        const batches = [];
        let currentBatch = [];
        let currentLength = 0;

        elements.forEach(item => {
            const textLength = item.text.length;

            if (currentBatch.length >= maxElementsPerRequest || (currentLength + textLength) > maxCharactersPerRequest) {
                batches.push(currentBatch);
                currentBatch = [];
                currentLength = 0;
            }

            currentBatch.push(item);
            currentLength += textLength;
        });

        if (currentBatch.length > 0) {
            batches.push(currentBatch);
        }

        return batches;
    }

    function translateBatches(batches, sourceLanguage, targetLanguage, apiKey, endpoint, location) {
        return new Promise((resolve, reject) => {
            const translationPromises = batches.map(batch => {
                const textsToTranslate = batch.map(item => ({ text: item.text }));

                return fetch(`${endpoint}/translate?api-version=3.0&from=${sourceLanguage}&to=${targetLanguage}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Ocp-Apim-Subscription-Key': apiKey,
                        'Ocp-Apim-Subscription-Region': location
                    },
                    body: JSON.stringify(textsToTranslate)
                })
                .then(response => {
                    if (!response.ok) {
                        return response.json().then(error => { throw new Error(JSON.stringify(error)); });
                    }
                    return response.json();
                })
                .then(data => {
                    return batch.map((item, index) => ({
                        originalText: item.text,
                        translatedText: data[index].translations[0].text,
                        elements: item.elements
                    }));
                });
            });

            Promise.all(translationPromises)
                .then(results => {
                    resolve(results.flat());
                })
                .catch(error => reject(error));
        });
    }

    function applyTranslations(translations) {
        translations.forEach(item => {
            item.elements.forEach(el => {
                if (el.type === 'placeholder') {
                    el.element.setAttribute('placeholder', item.translatedText);
                } else if (el.type === 'textNode') {
                    el.element.textContent = el.element.textContent.replace(item.originalText, item.translatedText);
                }
            });
        });
    }

    function updateLanguageUI(language) {
        const currentLanguage = document.getElementById('current-language');
        if (language === 'en') {
            currentLanguage.textContent = 'English';
        } else if (language === 'vi') {
            currentLanguage.textContent = 'Tiếng Việt';
        } else {
            currentLanguage.textContent = 'Chọn ngôn ngữ';
        }

        const languageLinks = document.querySelectorAll('#language-menu a');
        languageLinks.forEach(link => {
            const lang = link.getAttribute('data-lang');
            const textSpan = link.querySelector('span:not(.flag-icon)');
            if (lang === 'default') {
                textSpan.textContent = language === 'en' ? 'Choose language' : 'Chọn ngôn ngữ';
            } else if (lang === 'en') {
                textSpan.textContent = language === 'en' ? 'English' : 'English';
            } else if (lang === 'vi') {
                textSpan.textContent = language === 'en' ? 'Vietnamese' : 'Tiếng Việt';
            }
        });
    }

    function setLanguage(language) {
        showTranslationLoading();

        const currentLanguage = getCookie('selectedLanguage') || 'default';

        if (language === currentLanguage) {
            hideTranslationLoading();
            document.getElementById('language-menu').classList.remove('show');
            document.getElementById('language-toggle').classList.remove('active');
            return false;
        }

        const cacheKey = `vi-${language}-${window.location.pathname}`;

        // Clear cache for this language pair if force translating
        if (language !== 'default') {
            delete translationCache[cacheKey];
            localStorage.removeItem(cacheKey);
        }

        translateWebsite(language, true)
            .then(() => {
                hideTranslationLoading();

                // After translation, update links to maintain language during navigation
                if (language !== 'default') {
                    updateLinksWithLanguage(language);
                }
            })
            .catch((error) => {
                console.error('Translation error:', error);
                hideTranslationLoading();
            });

        document.getElementById('language-menu').classList.remove('show');
        document.getElementById('language-toggle').classList.remove('active');
        return false;
    }

    // Add language parameter to all internal links
    function updateLinksWithLanguage(language) {
        if (language === 'default') return;

        document.querySelectorAll('a').forEach(link => {
            const href = link.getAttribute('href');
            if (href && !href.startsWith('http') && !href.startsWith('#') && !href.startsWith('javascript:')) {
                // For internal links
                if (href.includes('?')) {
                    if (!href.includes('lang=')) {
                        link.setAttribute('href', `${href}&lang=${language}`);
                    } else {
                        link.setAttribute('href', href.replace(/lang=[^&]+/, `lang=${language}`));
                    }
                } else {
                    link.setAttribute('href', `${href}?lang=${language}`);
                }
            }
        });
    }

    function preserveLanguage(url, event) {
        event.preventDefault();
        const savedLanguage = getCookie('selectedLanguage') || 'default';

        // Only add language parameter if not default
        if (savedLanguage !== 'default') {
            // Add language parameter to the URL
            if (url.includes('?')) {
                url = `${url}&lang=${savedLanguage}`;
            } else {
                url = `${url}?lang=${savedLanguage}`;
            }
        }

        showTranslationLoading();
        window.location.href = url;
    }

    // Observer to monitor DOM changes and translate new content
    function setupMutationObserver() {
        const targetLanguage = getCookie('selectedLanguage') || 'default';
        if (targetLanguage === 'default' || targetLanguage === 'vi') return; // Skip for default language

        const observer = new MutationObserver((mutations) => {
            let newContent = false;

            mutations.forEach(mutation => {
                if (mutation.addedNodes.length > 0) {
                    mutation.addedNodes.forEach(node => {
                        if (node.nodeType === 1) { // Element node
                            newContent = true;
                        }
                    });
                }
            });

            if (newContent) {
                // Debounce translation to avoid multiple rapid translations
                clearTimeout(window.translationDebounce);
                window.translationDebounce = setTimeout(() => {
                    translateNewContent(targetLanguage);
                }, 300);
            }
        });

        // Start observing the document
        observer.observe(document.body, {
            childList: true,
            subtree: true
        });

        return observer;
    }

    // Translate newly added content
    function translateNewContent(targetLanguage) {
        if (targetLanguage === 'default' || targetLanguage === 'vi') return;

        // Get current cached translations
        const sourceLanguage = 'vi'; // Assuming original content is always in Vietnamese
        const cacheKey = `${sourceLanguage}-${targetLanguage}-${window.location.pathname}`;
        let existingTranslations = translationCache[cacheKey] || [];

        if (!existingTranslations.length) {
            const cachedTranslation = localStorage.getItem(cacheKey);
            if (cachedTranslation) {
                existingTranslations = JSON.parse(cachedTranslation);
                translationCache[cacheKey] = existingTranslations;
            }
        }

        // Collect new elements that need translation
        const newElements = [];
        const existingTexts = new Set(existingTranslations.map(t => t.originalText));

        function traverseNewNodes(node) {
            if (!node) return;
            const elementsToExclude = ['SCRIPT', 'STYLE', 'NOSCRIPT', 'IFRAME', 'OBJECT', 'SVG'];
            if (elementsToExclude.includes(node.nodeName)) return;

            // Handle placeholders
            if ((node.nodeName === 'INPUT' || node.nodeName === 'TEXTAREA') &&
                node.placeholder && node.placeholder.trim() !== '') {
                const text = node.placeholder.trim();
                if (text && !existingTexts.has(text)) {
                    newElements.push({
                        text: text,
                        elements: [{ element: node, type: 'placeholder' }]
                    });
                    existingTexts.add(text);
                }
            }

            // Handle text nodes
            if (node.nodeType === Node.TEXT_NODE &&
                node.textContent &&
                node.textContent.trim() !== '' &&
                node.parentNode.nodeName !== 'I') {
                const text = node.textContent.trim();
                if (text && !existingTexts.has(text)) {
                    newElements.push({
                        text: text,
                        elements: [{ element: node, type: 'textNode' }]
                    });
                    existingTexts.add(text);
                }
            }

            // Traverse child nodes
            if (node.childNodes) {
                for (let i = 0; i < node.childNodes.length; i++) {
                    traverseNewNodes(node.childNodes[i]);
                }
            }
        }

        traverseNewNodes(document.body);

        // If there are new elements to translate
        if (newElements.length > 0) {
            const apiKey = 'u2VNPSh3LQDFDhifFVHcxawkrkEZpWNThHE8cBXlQEEvB9Xl797jJQQJ99BCACULyCpXJ3w3AAAbACOGEGa2';
            const endpoint = 'https://api.cognitive.microsofttranslator.com/';
            const location = 'global';

            // Prepare batches for translation
            const batches = prepareBatches(newElements);

            // Process all batches
            translateBatches(batches, sourceLanguage, targetLanguage, apiKey, endpoint, location)
                .then(newTranslations => {
                    // Apply new translations
                    applyTranslations(newTranslations);

                    // Update cache with new translations
                    const updatedTranslations = [...existingTranslations, ...newTranslations];
                    translationCache[cacheKey] = updatedTranslations;
                    localStorage.setItem(cacheKey, JSON.stringify(updatedTranslations));
                })
                .catch(error => {
                    console.error('Translation error for new content:', error);
                });
        }
    }

    // Handle navigation parameters
    function handleNavigationParameters() {
        const urlParams = new URLSearchParams(window.location.search);
        const langParam = urlParams.get('lang');

        if (langParam) {
            const currentLanguage = getCookie('selectedLanguage') || 'default';

            if (langParam !== currentLanguage) {
                showTranslationLoading();
                setCookie('selectedLanguage', langParam, 30);
                translateWebsite(langParam)
                    .then(() => {
                        hideTranslationLoading();
                        updateLanguageUI(langParam);
                    })
                    .catch(() => hideTranslationLoading());
            }
        }
    }

        function initializeLanguage() {
        // Đặt 'default' làm ngôn ngữ mặc định khi khởi động
        setCookie('selectedLanguage', 'default', 30);
        updateLanguageUI('default');

        // First handle URL parameters if present
        handleNavigationParameters();

        const savedLanguage = getCookie('selectedLanguage');
        if (savedLanguage && savedLanguage !== 'default') {
            updateLanguageUI(savedLanguage);
            if (savedLanguage !== 'vi') {
                showTranslationLoading();
                translateWebsite(savedLanguage)
                    .then(() => {
                        hideTranslationLoading();
                        // After initial translation, set up observer for dynamic content
                        setupMutationObserver();
                        // Add language parameter to all links
                        updateLinksWithLanguage(savedLanguage);
                    })
                    .catch(() => hideTranslationLoading());
            }
        } else {
            updateLanguageUI('default');
        }

        const toggle = document.getElementById('language-toggle');
        const menu = document.getElementById('language-menu');
        toggle.addEventListener('click', (e) => {
            e.preventDefault();
            menu.classList.toggle('show');
            toggle.classList.toggle('active');
        });

        document.addEventListener('click', (e) => {
            if (!toggle.contains(e.target) && !menu.contains(e.target)) {
                menu.classList.remove('show');
                toggle.classList.remove('active');
            }
        });

        // Intercept all clicks on links to ensure language is preserved
        document.addEventListener('click', function(e) {
            // Check if the clicked element is an anchor or contains an anchor
            const anchor = e.target.closest('a');
            if (anchor) {
                const href = anchor.getAttribute('href');
                // Skip external links, javascript links, and hash links
                if (href && !href.startsWith('http') && !href.startsWith('javascript:') && !href.startsWith('#')) {
                    // Check if the link already handles preservation
                    if (!anchor.hasAttribute('onclick') || !anchor.getAttribute('onclick').includes('preserveLanguage')) {
                        e.preventDefault();
                        preserveLanguage(href, e);
                    }
                }
            }
        });
    }

    document.addEventListener('DOMContentLoaded', initializeLanguage);
</script>
