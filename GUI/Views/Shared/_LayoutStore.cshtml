				setCookie("user-id", id, 60);
			}
			setCookie("aId", "@ViewBag.AccountId", 60)
			setCookie("cName", name, 60);
			setCookie("cPhone", phone, 60);
			$('#customer-name').text(name);
			$(".anonymous").hide();
			$(".signed").show();
		</script>
