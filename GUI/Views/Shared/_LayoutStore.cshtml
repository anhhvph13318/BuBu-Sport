<style>
	/* CSS cho dropdown ngôn ngữ */
	.header-links .dropdown {
		position: relative;
		display: inline-block;
	}

	.header-links .dropdown-toggle {
		color: #FFF;
		display: flex;
		align-items: center;
		text-decoration: none;
		padding: 10px;
		transition: all 0.3s;
	}

		.header-links .dropdown-toggle:hover {
			color: #D10024;
		}

		.header-links .dropdown-toggle .fa {
			margin-right: 5px;
		}

	.header-links .dropdown-menu {
		position: absolute;
		top: 100%;
		left: 0;
		background-color: #1E1F29;
		min-width: 160px;
		box-shadow: 0 8px 16px rgba(0,0,0,0.2);
		z-index: 1000;
		display: none;
		border-radius: 4px;
		padding: 5px 0;
		margin-top: 5px;
		border: 1px solid rgba(255,255,255,0.1);
	}

		.header-links .dropdown-menu li {
			display: block;
			width: 100%;
			padding: 0;
		}

			.header-links .dropdown-menu li a {
				color: #FFF;
				padding: 10px 15px;
				display: flex;
				align-items: center;
				text-decoration: none;
				transition: all 0.3s;
			}

				.header-links .dropdown-menu li a:hover {
					background-color: #D10024;
					color: #FFF;
				}

			.header-links .dropdown-menu li .flag-icon {
				margin-right: 8px;
				font-size: 16px;
			}

	.header-links .dropdown:hover .dropdown-menu {
		display: block;
	}

	/* Hiệu ứng mũi tên dropdown */
	.header-links .dropdown-toggle .fa-caret-down {
		margin-left: 5px;
		transition: transform 0.3s;
	}

	.header-links .dropdown:hover .dropdown-toggle .fa-caret-down {
		transform: rotate(180deg);
	}

	/* Thêm hiệu ứng cho ngôn ngữ đang chọn */
	.header-links .dropdown-menu li a.active {
		background-color: rgba(209, 0, 36, 0.2);
	}

	/* Hiệu ứng hiển thị menu */
	@@keyframes fadeIn {
		from

	{
		opacity: 0;
		transform: translateY(-10px);
	}

	to {
		opacity: 1;
		transform: translateY(0);
	}

	}

	.header-links .dropdown:hover .dropdown-menu {
		display: block;
		animation: fadeIn 0.3s forwards;
	}

	/* CSS cho màn hình loading khi dịch */
	#translation-loading {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(0, 0, 0, 0.7);
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		z-index: 9999;
		display: none;
	}

	.loading-spinner {
		width: 50px;
		height: 50px;
		border: 5px solid rgba(255, 255, 255, 0.3);
		border-radius: 50%;
		border-top-color: #D10024;
		animation: spin 1s ease-in-out infinite;
	}

	.loading-text {
		color: white;
		margin-top: 20px;
		font-size: 18px;
	}

	@@keyframes spin {
		to

	{
		transform: rotate(360deg);
	}

	}
</style>
