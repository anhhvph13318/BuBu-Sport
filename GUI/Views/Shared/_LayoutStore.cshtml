<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->

	<title>BuBuSport</title>
	<link rel="apple-touch-icon" sizes="180x180" href="~/Image/LogoBuBu.png">
	<link rel="icon" type="image/png" sizes="64x64" href="~/Image/LogoBuBu.png">
	<link rel="icon" type="image/png" sizes="32x32" href="~/Image/LogoBuBu.png">
	<link rel="manifest" href="~/Image/site.webmanifest">

	<!-- Google font -->
	<link href="https://fonts.googleapis.com/css?family=Montserrat:400,500,700" rel="stylesheet">

	<!-- Bootstrap -->
	@* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
	<link type="text/css" rel="stylesheet" href="~/storefront/css/bootstrap.min.css" />

	<!-- Slick -->
	<link type="text/css" rel="stylesheet" href="~/storefront/css/slick.css" />
	<link type="text/css" rel="stylesheet" href="~/storefront/css/slick-theme.css" />

	<!-- nouislider -->
	<link type="text/css" rel="stylesheet" href="~/storefront/css/nouislider.min.css" />

	<!-- Font Awesome Icon -->
	<link rel="stylesheet" href="~/storefront/css/font-awesome.min.css">

	<!-- Custom stlylesheet -->
	<link type="text/css" rel="stylesheet" href="~/storefront/css/style.css" asp-append-version="true"/>
	<!-- Thêm vào phần head của _LayoutStore.cshtml -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
</head>
<style>
	/* CSS cho dropdown ngôn ngữ */
	.header-links .dropdown {
		position: relative;
		display: inline-block;
	}

	.header-links .dropdown-toggle {
		color: #FFF;
		display: flex;
		align-items: center;
		text-decoration: none;
		padding: 10px;
		transition: all 0.3s;
		cursor: pointer; /* Thêm con trỏ để rõ ràng hơn */
	}

		.header-links .dropdown-toggle:hover {
			color: #D10024;
		}

		.header-links .dropdown-toggle .fa {
			margin-right: 5px;
		}

	.header-links .dropdown-menu {
		position: absolute;
		top: 100%;
		left: 0;
		background-color: #1E1F29;
		min-width: 160px;
		box-shadow: 0 8px 16px rgba(0,0,0,0.2);
		z-index: 1000;
		display: none; /* Ẩn mặc định */
		border-radius: 4px;
		padding: 5px 0;
		margin-top: 5px;
		border: 1px solid rgba(255,255,255,0.1);
	}

    .header-links {
        display: flex;
        align-items: center; /* Căn giữa theo chiều dọc */
        justify-content: flex-end; /* Căn về bên phải */
        gap: 15px; /* Khoảng cách giữa các nút */
    }

        .header-links li {
            display: flex;
            align-items: center;
        }

        .header-links a {
            padding: 8px 12px; /* Điều chỉnh padding để không bị lệch */
            font-size: 12px; /* Đảm bảo kích thước chữ đồng đều */
            line-height: normal; /* Tránh bị kéo giãn */
        }


		.header-links .dropdown-menu.show {
			display: block; /* Hiển thị khi có class 'show' */
			animation: fadeIn 0.3s forwards;
		}

		.header-links .dropdown-menu li {
			display: block;
			width: 100%;
			padding: 0;
		}

			.header-links .dropdown-menu li a {
				color: #FFF;
				padding: 10px 15px;
				display: flex;
				align-items: center;
				text-decoration: none;
				transition: all 0.3s;
			}

				.header-links .dropdown-menu li a:hover {
					background-color: #D10024;
					color: #FFF;
				}

			.header-links .dropdown-menu li .flag-icon {
				margin-right: 8px;
				font-size: 16px;
			}

	/* Hiệu ứng mũi tên dropdown */
	.header-links .dropdown-toggle .fa-caret-down {
		margin-left: 5px;
		transition: transform 0.3s;
	}

	.header-links .dropdown-toggle.active .fa-caret-down {
		transform: rotate(180deg);
	}

	/* Hiệu ứng hiển thị menu */
	@@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(-10px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* CSS cho màn hình loading khi dịch */
	#translation-loading {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(0, 0, 0, 0.7);
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		z-index: 9999;
		display: none;
	}

	.loading-spinner {
		width: 50px;
		height: 50px;
		border: 5px solid rgba(255, 255, 255, 0.3);
		border-radius: 50%;
		border-top-color: #D10024;
		animation: spin 1s ease-in-out infinite;
	}

	.loading-text {
		color: white;
		margin-top: 20px;
		font-size: 18px;
	}

	@@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}
</style>
<body>
	<header>
		<div id="top-header">
			<div class="container">
				<ul class="header-links pull-left">
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle" id="language-toggle">
                            <i class="fa fa-globe"></i> <span id="current-language">Chọn ngôn ngữ</span> <i class="fa fa-caret-down"></i>
                        </a>
                        <ul class="dropdown-menu" id="language-menu">
                            <li>
                                <a href="#" data-lang="default" onclick="setLanguage('default'); return false;">
                                    <span class="flag-icon">🌐</span> <span>Chọn ngôn ngữ</span>
                                </a>
                            </li>
                            <li>
                                <a href="#" data-lang="en" onclick="setLanguage('en'); return false;">
                                    <span class="flag-icon">🇺🇸</span> <span>English</span>
                                </a>
                            </li>
                            <li>
                                <a href="#" data-lang="fr" onclick="setLanguage('fr'); return false;">
                                    <span class="flag-icon">🇫🇷</span> <span>Français</span>
                                </a>
                            </li>
                            <li>
                                <a href="#" data-lang="de" onclick="setLanguage('de'); return false;">
                                    <span class="flag-icon">🇩🇪</span> <span>Deutsch</span>
                                </a>
                            </li>
                            <li>
                                <a href="#" data-lang="ru" onclick="setLanguage('ru'); return false;">
                                    <span class="flag-icon">🇷🇺</span> <span>Русский</span>
                                </a>
                            </li>
                            <li>
                                <a href="#" data-lang="zh-Hans" onclick="setLanguage('zh-Hans'); return false;">
                                    <span class="flag-icon">🇨🇳</span> <span>中文</span>
                                </a>
                            </li>
                        </ul>
                    </li>
				</ul>
				<ul class="header-links pull-right anonymous">
					<li><a href="/SignIn"><i class="fa fa-user-o"></i> Đăng nhập</a></li>
					<li><a href="/SignIn?action=2"><i class="fa fa-user-o"></i> Đăng ký</a></li>
				</ul>
				<ul class="header-links pull-right signed" style="display:none">
					<li><a href="/CustomerInfo"><i class="fa fa-user-o"></i> <span id="customer-name">Khách hàng</span></a></li>
					<li><a id="sign-out" href=""><i class="fa fa-user-o"></i> Đăng xuất</a></li>
				</ul>
			</div>
		</div>
		<div id="header">
			<div class="container">
				<div class="row">
					<div class="col-md-3">
						<div class="header-logo">
							<a href="Store" class="logo">
								<img src="./Image/LogoBuBu.png" style="width: 125px; height: auto;" alt="">
							</a>
						</div>
					</div>
					<div class="col-md-6">
						<div class="header-search">
							<form action="Store">
								<input class="input" name="s" placeholder="Tìm kiếm sản phẩm" value="@(!string.IsNullOrEmpty(ViewBag.SearchString) ? ViewBag.SearchString : "")">
								<button class="search-btn">Tìm kiếm</button>
							</form>
						</div>
					</div>
					<div class="col-md-3 clearfix">
						<div class="header-ctn">
							<div>
								<a href="/orderchecking" style="width:115px">
									<i class="fa fa-file"></i>
									<span>Tra cứu đơn hàng</span>
								</a>
							</div>
							<div class="dropdown">
								<a href="/cart">
									<i class="fa fa-shopping-cart"></i>
									<span>Giỏ hàng</span>
								</a>
							</div>
							<div class="menu-toggle">
								<a href="#">
									<i class="fa fa-bars"></i>
									<span>Menu</span>
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</header>
	<nav id="navigation">
		<div class="container">
			<div id="responsive-nav">
                <ul class="main-nav nav navbar-nav" id="nav-bar">
                    <li id="store" class="active"><a href="/store" onclick="preserveLanguage('/store', event)">Trang chủ</a></li>
                    <!-- Danh mục sẽ được thêm động bằng JavaScript -->
                </ul>
			</div>
		</div>
	</nav>
	@RenderBody()
	<footer id="footer">
		<div class="section">
			<div class="container">
			</div>
		</div>
		<div id="bottom-footer" class="section">
			<div class="container">
				<div class="row">
					<div class="col-md-12 text-center">
						<ul class="footer-payments">
							<li><a href="#"><i class="fa fa-cc-visa"></i></a></li>
							<li><a href="#"><i class="fa fa-credit-card"></i></a></li>
							<li><a href="#"><i class="fa fa-cc-paypal"></i></a></li>
							<li><a href="#"><i class="fa fa-cc-mastercard"></i></a></li>
							<li><a href="#"><i class="fa fa-cc-discover"></i></a></li>
							<li><a href="#"><i class="fa fa-cc-amex"></i></a></li>
						</ul>
						<span class="copyright">
							Copyright &copy;<script>document.write(new Date().getFullYear());</script> All rights reserved | This template is made with <i class="fa fa-heart-o" aria-hidden="true"></i> by <a href="https://colorlib.com" target="_blank">Colorlib</a>
						</span>
					</div>
				</div>
			</div>
		</div>
	</footer>
	<!-- /FOOTER -->
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/storefront/js/jquery.min.js" asp-append-version="true"></script>
	<script src="~/storefront/js/bootstrap.min.js" asp-append-version="true"></script>
	@* <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> *@
	<script src="~/storefront/js/slick.min.js" asp-append-version="true"></script>
	<script src="~/storefront/js/nouislider.min.js" asp-append-version="true"></script>
	<script src="~/storefront/js/jquery.zoom.min.js" asp-append-version="true"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

	@await RenderSectionAsync("Scripts", required: false)
	<script src="~/storefront/js/main.js" asp-append-version="true"></script>
    @if (!string.IsNullOrEmpty(ViewBag.AccountId))
    {
        <script>
            let id = "@ViewBag.CustomerId";
            let name = "@ViewBag.CustomerName"
            let phone = "@ViewBag.CustomerPhone"
            if (id) {
                setCookie("user-id", id, 60);
            }
            setCookie("aId", "@ViewBag.AccountId", 60)
            setCookie("cName", name, 60);
            setCookie("cPhone", phone, 60);
            $('#customer-name').text(name);
            $(".anonymous").hide();
            $(".signed").show();
        </script>
    }
	<script src="~/js/LayoutStore.js" asp-append-version="true"></script>
</body>
</html>


