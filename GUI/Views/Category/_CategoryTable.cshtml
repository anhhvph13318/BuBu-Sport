@using GUI.Models.DTOs
@model IEnumerable<CategoryDTO>

<table class="table table-hover shadow-sm mt-3 text-center align-middle">
    <thead class="table-dark">
        <tr>
            <th>Tên</th>
            <th>Trạng thái</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>
                    @if (category.StatusText == "Hoạt động")
                    {
                        <span class="badge bg-success">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Không hoạt động</span>
                    }
                </td>
                <td>
                    <button class="btn btn-primary btn-sm me-1" onclick="showDetail('@category.Id')">Sửa</button>
                    <a class="btn btn-info btn-sm" href="/product?s=@category.Id">Chi tiết</a>
                </td>
            </tr>
        }
    </tbody>
</table>