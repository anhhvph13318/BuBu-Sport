@using GUI.Models.DTOs
@{
    ViewData["Title"] = "Quản lý danh mục";
}

@model IEnumerable<CategoryDTO>

<div class="container">
    <h2 class="text-center text-primary fw-bold">Quản lý danh mục</h2>
    <hr />
    <div class="d-flex justify-content-start align-items-center mb-3">
    <button class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#categoryModal" onclick="clear()">Thêm mới</button>

    <div class="d-flex align-items-center ms-auto">
        <input class="form-control" style="width: 250px;" placeholder="Nhập tên danh mục ..." id="categorySearch" />
        <button class="btn btn-primary ms-2" onclick="search()">Tìm kiếm</button>
        <button class="btn btn-danger ms-2" onclick="reset()">Reset</button>
    </div>
</div>


    <div id="categoryTable">
        @await Html.PartialAsync("_CategoryTable", Model)
    </div>
</div>


<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" id="modalContent">
            @await Html.PartialAsync("_CategoryModal", new CategoryDTO())
        </div>
    </div>
</div>

@section scripts {
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/js/category.js"></script>
}