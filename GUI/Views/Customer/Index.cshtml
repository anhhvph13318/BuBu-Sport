@model List<GUI.Models.DTOs.CustomerDTO>

@{
    ViewData["Title"] = "Danh sách khách hàng";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="container mt-4">
    <h2 class="text-center text-primary fw-bold">Danh Sách Khách Hàng</h2>
    <hr />
    <div class="table-responsive">
        <table class="table table-hover shadow-sm mt-3">
            <thead class="table-dark text-center">
                <tr>
                    <th>Tên</th>
                    <th>Số điện thoại</th>
                    <th>Địa chỉ</th>
                    <th>Giới tính</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody class="text-center align-middle">
                @foreach (var customer in Model)
                {
                    <tr>
                        <td>@customer.Name</td>
                        <td>@customer.Phone</td>
                        <td>@customer.Address</td>
                        <td>
                            @(customer.Sex == 1 ? "Nam" : "Nữ")
                        </td>
                        <td>
                            <span class="badge @(customer.Status == "Active" ? "bg-success" : "bg-danger")">
                                @customer.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="?page=1" aria-label="First">
                    <span>&laquo;&laquo;</span>
                </a>
            </li>
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="?page=@(currentPage - 1)" aria-label="Previous">
                    <span>&laquo;</span>
                </a>
            </li>

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i">@i</a>
                </li>
            }

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="?page=@(currentPage + 1)" aria-label="Next">
                    <span>&raquo;</span>
                </a>
            </li>
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="?page=@totalPages" aria-label="Last">
                    <span>&raquo;&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>
