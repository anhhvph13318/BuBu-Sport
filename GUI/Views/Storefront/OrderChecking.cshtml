@using System.Globalization
@model List<GUI.Models.DTOs.Order_DTO.OrderDetail>
@{
    Layout = "_LayoutStore";
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
<div class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="hot-deal">
                    <h2 class="text-uppercase">Tìm kiếm đơn hàng</h2>
                    <div class="header-search">
                        <form id="orderSearchForm" action="OrderChecking">
                            <input class="input" name="s" placeholder="Nhập mã đơn hàng"
                                   value="@(!string.IsNullOrEmpty(ViewBag.OrderSearch) ? ViewBag.OrderSearch : "")">
                            <button class="search-btn" type="submit">Tìm kiếm</button>
                        </form>
                    </div>
                </div>
                @if (Model != null)
                {
                    <p class="orders-header">Đơn hàng</p>
                    foreach (var order in Model)
                    {
                        decimal totalAmount = 0;
                        foreach (var item in order.Items)
                        {
                            totalAmount += item.Price * item.Quantity;
                        }

                        decimal finalTotal = totalAmount;
                        if (order.PaymentInfo.TotalDiscount > 0)
                        {
                            finalTotal -= order.PaymentInfo.TotalDiscount;
                        }

                        <div class="order-title">Đơn hàng @order.Code</div>
                        <div class="order-container">
                            <div class="order-products">
                                <div class="order-wrapper">
                                    <table class="order-table">
                                        <thead>
                                            <tr>
                                                <th>Mã SP</th>
                                                <th>Sản phẩm</th>
                                                <th>Màu sắc</th>
                                                <th>Size</th>
                                                <th>Đơn giá</th>
                                                <th>Số lượng</th>
                                                <th>Thành tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in order.Items)
                                            {
                                                <tr>
                                                    <td>@item.Code</td>
                                                    <td>@item.ProductName</td>
                                                    <td>@item.Color</td>
                                                    <td>@item.Size</td>
                                                    <td>@item.Price.ToString("C", CultureInfo.GetCultureInfo("vi-VN"))</td>
                                                    <td>@item.Quantity</td>
                                                    <td>@((item.Price * item.Quantity).ToString("C", CultureInfo.GetCultureInfo("vi-VN")))</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="order-details">
                                @if (order.Voucher != null && order.Voucher.Discount != null && order.Voucher.Discount != 0)
                                {
                                    <div class="order-col mb-3">
                                        <div class="order-label">Voucher (@order.Voucher.Code) </div>
                                        <div class="order-value"> - @order.Voucher.Discount.ToString("C0", CultureInfo.GetCultureInfo("vi-VN"))</div>
                                    </div>
                                }
                                <div class="order-col mb-3">
                                    <div class="order-label">Tổng thanh toán</div>
                                    <div class="order-value">@finalTotal.ToString("C0", CultureInfo.GetCultureInfo("vi-VN"))</div>
                                </div>
                                <div class="order-col mb-3">
                                    <div class="order-label">Thông tin khách hàng</div>
                                    <div class="order-value">
                                        @if (order.ShippingInfo != null && !string.IsNullOrEmpty(order.ShippingInfo.Name))
                                        {
                                            <div class="customer-info">
                                                <p class="customer-name"><i class="fa-solid fa-user"></i> @order.ShippingInfo.Name</p>
                                                <p class="customer-phone"><i class="fa-solid fa-phone"></i> @order.ShippingInfo.PhoneNumber</p>
                                                <p class="customer-address"><i class="fa-solid fa-location-pin"></i> @order.ShippingInfo.Address</p>
                                                <p class="customer-email"><i class="fa-solid fa-envelope"></i> @order.Customer.Email</p>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="customer-info">
                                                <p class="customer-name"><i class="fa-solid fa-user"></i> @order.Customer.Name</p>
                                                <p class="customer-phone"><i class="fa-solid fa-phone"></i> @order.Customer.PhoneNumber</p>
                                                <p class="customer-address"><i class="fa-solid fa-location-pin"></i> @order.Customer.Address</p>
                                                <p class="customer-email"><i class="fa-solid fa-envelope"></i> @order.Customer.Email</p>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="order-col mb-3">
                                    <div class="order-label">Phương thức thanh toán</div>
                                    <div class="order-value">@order.PaymentMethodName</div>
                                </div>
                                <div class="order-col mb-3">
                                    <div class="order-label">Trạng thái thanh toán</div>
                                    <div class="order-value text-success fw-bold">@order.PaymentInfo.PaymentStatus</div>
                                </div>
                                <div class="order-col mb-3">
                                    <div class="order-label">Trạng thái đơn hàng</div>
                                    <div class="order-value fw-bold">
                                        @if (@order.StatusText == "Chờ xác nhận")
                                        {
                                            @order.StatusText <i class="fa-solid fa-spinner"></i>
                                        }
                                        else if (order.StatusText == "Chuẩn bị hàng")
                                        {
                                            @order.StatusText <i class="fa-solid fa-box"></i>
                                        }
                                        else if (order.StatusText == "Đang vận chuyển")
                                        {
                                            @order.StatusText <i class="fa-solid fa-truck-fast"></i>
                                        }
                                        else
                                        {
                                            @order.StatusText <i class="fa-solid fa-check"></i>
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(order.ReasionCancel))
                                {
                                    <div class="order-col mb-3">
                                        <div class="order-label text-danger">Lý do hủy đơn hàng</div>
                                        <div class="order-value">@order.ReasionCancel</div>
                                    </div>
                                }

                                <div class="order-col mb-3">
                                    <div class="order-label">Thời gian đặt hàng</div>
                                    <div class="order-value">@order.Created.ToString("dd/MM/yyyy HH:mm") <i class="fa-solid fa-clock"></i></div>
                                </div>

                            </div>

                        </div>
                        @if (@order.StatusText == "Chờ xác nhận")
                        {

                            <!-- Nút mở modal -->
                            <div class="text-end mt-2" style="text-align: right; margin-bottom: 15px;">
                                <button id="openModal" class="btn btn-danger">Hủy đơn hàng</button>
                            </div>

                            <!-- Modal -->
                            <div id="cancelModal" class="modal">
                                <div class="modal-content">
                                    <span class="close">&times;</span>
                                    <h2>Hủy đơn hàng</h2>

                                    <!-- Form duy nhất dùng POST -->
                                    <form id="cancelForm" method="post" action="/CancelOrder">
                                        <!-- Trường ẩn chứa thông tin đơn hàng -->
                                        <input type="hidden" name="email" value="@order.Customer.Email" />
                                        <input type="hidden" name="name" value="@order.Customer.Name" />
                                        <input type="hidden" name="phone" value="@order.Customer.PhoneNumber" />
                                        <input type="hidden" name="orderCode" value="@order.Code" />

                                        <!-- Nhập lý do và mã hủy -->
                                        <label for="cancelReason">Lý do hủy:</label>
                                        <textarea id="cancelReason" name="reasonCancel" rows="3" required></textarea>

                                        <label for="cancelCode">Mã hủy đơn:</label>
                                        <input type="text" id="cancelCode" name="codeCancelOrder" required />

                                        <div class="modal-actions">
                                            <button type="button" id="closeModal">Đóng</button>
                                            <button type="button" class="btn btn-danger" id="submitCancelBtn">Xác nhận hủy</button>
                                        </div>
                                    </form>

                                    <!-- Nút nhận mã hủy riêng, dùng GET -->
                                    <form method="get" action="/CancelOrder" style="margin-top: 15px;" id="getCancelCodeForm">
                                        <input type="hidden" name="email" value="@order.Customer.Email" />
                                        <input type="hidden" name="name" value="@order.Customer.Name" />
                                        <input type="hidden" name="phone" value="@order.Customer.PhoneNumber" />
                                        <input type="hidden" name="orderCode" value="@order.Code" />
                                        <button type="submit" class="btn btn-warning" id="getCancelCodeBtn">Nhận mã hủy đơn</button>
                                    </form>
                                </div>
                            </div>

                        }
                        <hr />
                    }
                }
            </div>
        </div>
    </div>
</div>
@if (ViewBag.OrderNotFound == true && !string.IsNullOrEmpty(ViewBag.OrderSearch as string))
{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        Swal.fire({
            title: 'Không Tìm Thấy Đơn Hàng',
            text: 'Vui Lòng Nhập Đúng Mã Đơn Hàng',
            icon: 'error',
            confirmButtonColor: '#33a9c4',
            confirmButtonText: 'Đồng ý',
            width: '600px',
            padding: '2em',
            customClass: {
                popup: 'larger-swal'
            }
        });
    </script>
}

<style>
    .swal2-container {
        z-index: 9999 !important;
    }

    .text-end {
        text-align: right;
    }

    .mt-2 {
        margin-top: 0.5rem;
    }
    /* Overall header styling */
    .orders-header {
        text-align: center;
        letter-spacing: 2px;
        text-transform: uppercase;
        position: relative;
        animation: fadeIn 1s ease-out;
    }

    /* Order title styling */
    .order-title {
        margin-bottom: 15px;
        text-transform: capitalize;
        position: relative;
        transition: all 0.3s ease-in-out;
    }

    /* Order info container styling */
    .order-info {
        background-color: #ffffff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
        margin-top: 30px;
        opacity: 0;
        transform: translateY(20px);
        animation: slideUp 0.8s ease-out forwards;
    }

    .order-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 40px;
    }

    .order-products {
        flex: 2; /* Chiếm 2 phần */
        min-width: 60%;
    }

    .order-details {
        flex: 1; /* Chiếm 1 phần */
        min-width: 35%;
    }

    @@media (max-width: 768px) {
        .order-container {
            flex-direction: column;
        }

        .order-products, .order-details {
            min-width: 100%;
        }
    }

    /* Order table styling */
    /* Bảng đơn hàng */
    .order-table {
        width: 100%;
        border-collapse: collapse; /* Đảm bảo không có khoảng cách giữa các cell */
        margin-top: 20px;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        background-color: #ffffff;
    }

        /* Tiêu đề bảng */
        .order-table th {
            padding: 15px;
            background-color: #1abc9c;
            color: white;
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            text-align: left;
            border-bottom: 2px solid #16a085;
        }

    /* Dữ liệu bảng */
    ..order-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed; /* Quan trọng: Cố định bố cục bảng */
    }

    .order-table th,
    .order-table td {
        padding: 12px 8px;
        text-align: center;
        border: 1px solid #e0e0e0;
        vertical-align: middle; /* Căn giữa theo chiều dọc */
    }

    .order-table th {
        background-color: #f8f9fa;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

        /* Căn chỉnh cột */
        .order-table th:nth-child(1), .order-table td:nth-child(1) {
            width: 10%;
        }
        /* Mã SP */
        .order-table th:nth-child(2), .order-table td:nth-child(2) {
            width: 25%;
        }
        /* Sản phẩm */
        .order-table th:nth-child(3), .order-table td:nth-child(3) {
            width: 12%;
        }
        /* Màu sắc */
        .order-table th:nth-child(4), .order-table td:nth-child(4) {
            width: 10%;
        }
        /* Size */
        .order-table th:nth-child(5), .order-table td:nth-child(5) {
            width: 15%;
        }
        /* Đơn giá */
        .order-table th:nth-child(6), .order-table td:nth-child(6) {
            width: 10%;
        }
        /* Số lượng */
        .order-table th:nth-child(7), .order-table td:nth-child(7) {
            width: 18%;
        }
    /* Thành tiền */

    /* Hiệu ứng hover cho dòng trong bảng */


    /* Thêm màu sắc cho dòng header */
    .order-table th {
        background-color: #16a085;
    }

    /* Định dạng các cột dữ liệu */
    .order-table td {
        background-color: #f8f8f8;
    }

    /* Hiệu ứng khi di chuột qua các ô dữ liệu */


    /* Cải thiện cho các phần tử khi di chuột */


    /* Cải thiện cho bảng ở màn hình nhỏ */
    @@media screen and (max-width: 768px) {
        .order-table th, .order-table td {
            font-size: 12px;
            padding: 10px;
        }

            .order-table td:nth-child(1), .order-table th:nth-child(1) {
                width: 20%;
            }

            .order-table td:nth-child(2), .order-table th:nth-child(2) {
                width: 40%;
            }

            .order-table td:nth-child(3), .order-table th:nth-child(3) {
                width: 20%;
            }

            .order-table td:nth-child(4), .order-table th:nth-child(4) {
                width: 20%;
            }

            .order-table td:nth-child(5), .order-table th:nth-child(5) {
                width: 25%;
            }

            .order-table td:nth-child(6), .order-table th:nth-child(6) {
                width: 25%;
            }

            .order-table td:nth-child(7), .order-table th:nth-child(7) {
                width: 30%;
            }
    }


    /* Column styling */
    .order-col {
        margin-bottom: 30px;
        transition: all 0.3s ease;
    }

    /* Label styling for each order info */
    /* Information Label */
    .order-label {
        font-weight: 600;
        font-size: 16px;
        margin-bottom: 10px;
        text-transform: uppercase;
    }

    /* Information Value Styling */
    .order-value {
        font-size: 15px;
        color: #7f8c8d;
        font-weight: 400;
        line-height: 1.6;
    }

    /* Customer info container */
    .customer-info {
        padding: 15px;
        border-radius: 8px;
        margin-top: 10px;
    }

    /* Individual customer information styles */
    .customer-name,
    .customer-phone,
    .customer-address {
        color: #34495e;
    }

    /* Differentiate label color */
    .customer-name {
        font-weight: 600;
    }

    /* Stylize phone number */
    .customer-phone {
    }

    /* Stylize address */
    .customer-address {
        color: #34495e;
    }

    /* Add hover effect for customer info */



    /* Button styling for cancel order */
    .btn-danger {
        background-color: #e74c3c;
        color: white;
        padding: 15px 30px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-size: 16px;
        font-weight: 600;
        text-transform: uppercase;
        transition: all 0.3s ease;
        position: relative;
    }

        .btn-danger:hover {
            background-color: #c0392b;
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
        }

    /* Payment status styling */
    color: #2ecc71;
    font-weight: 700;
    }

    /* Bold text for order status */
    .fw-bold {
        font-weight: bold;
    }

    /* Horizontal divider */
    hr {
        border-top: 1px solid #ecf0f1;
        margin-top: 40px;
        margin-bottom: 40px;
    }

    /* Animation for fade-in effect */
    @@keyframes fadeIn {
        0% {
            opacity: 0;
        }

        100% {
            opacity: 1;
        }
    }

    /* Animation for slide-up effect */
    @@keyframes slideUp {
        0% {
            opacity: 0;
            transform: translateY(20px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Mobile responsiveness */
    @@media screen and (max-width: 768px) {
        .order-table th, .order-table td {
            font-size: 13px;
            padding: 14px;
        }

        .order-col {
            margin-bottom: 25px;
        }

        .order-header {
            font-size: 22px;
        }

        .order-value {
            font-size: 13px;
        }

        .btn-danger {
            padding: 12px 25px;
            font-size: 14px;
        }
    }
    /* Style cho modal */
    .modal {
        display: none; /* Ẩn modal mặc định */
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.4); /* Nền mờ */
    }

    /* Nội dung modal */
    .modal-content {
        background-color: #fefefe;
        margin: 10% auto;
        padding: 20px;
        border: 1px solid #888;
        width: 80%;
        max-width: 500px;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    /* Nút đóng modal */
    .close {
        color: #aaa;
        float: right;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
    }

        .close:hover,
        .close:focus {
            color: black;
            text-decoration: none;
        }

    /* Tiêu đề modal */
    .modal-content h2 {
        color: #d9534f;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid #eee;
    }

    /* Form hủy đơn hàng */
    #cancelForm {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

        /* Style cho các input và textarea */
        #cancelForm label {
            font-weight: 600;
            color: #555;
        }

        #cancelForm textarea,
        #cancelForm input[type="text"] {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 14px;
        }

        #cancelForm textarea {
            min-height: 100px;
            resize: vertical;
        }

    /* Nút trong modal */
    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 15px;
    }

        .modal-actions button {
            padding: 8px 16px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
        }

            .modal-actions button[type="button"] {
                background-color: #6c757d;
                color: white;
            }

            .modal-actions button[type="submit"] {
                background-color: #d9534f;
                color: white;
            }

            .modal-actions button:hover {
                opacity: 0.9;
            }

    /* Nút nhận mã hủy */
    form[method="get"] button {
        width: 100%;
        padding: 10px;
        background-color: #f0ad4e;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-weight: 600;
    }

        form[method="get"] button:hover {
            background-color: #ec971f;
        }

    /* Responsive cho mobile */
    @@media (max-width: 576px) {
        .modal-content {
            width: 95%;
            margin: 20% auto;
        }

        .modal-actions {
            flex-direction: column;
        }

            .modal-actions button {
                width: 100%;
            }
    }

    .larger-swal {
        font-size: 20px;
    }
</style>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const modal = document.getElementById("cancelModal");
    const openBtn = document.getElementById("openModal");
    const closeBtn = document.getElementById("closeModal");
    const spanClose = document.querySelector(".close");

    openBtn.onclick = () => {
        modal.style.display = "block";
    };

    closeBtn.onclick = () => {
        modal.style.display = "none";
    };

    spanClose.onclick = () => {
        modal.style.display = "none";
    };

    window.onclick = (event) => {
        if (event.target == modal) {
            modal.style.display = "none";
        }
    };
    window.addEventListener("DOMContentLoaded", () => {
        const shouldOpenModal = '@(TempData["OpenCancelModal"]?.ToString().ToLower() ?? "false")';
        if (shouldOpenModal === 'true') {
            const modal = document.getElementById("cancelModal");
            if (modal) {
                modal.style.display = "block";
            }
        }
    });
    @if (ViewBag.CancelMessage != null)
    {
                <div class="alert @(ViewBag.CancelMessageType == "success" ? "alert-success" : "alert-danger")" >
            @ViewBag.CancelMessage
                    </div>
    }
        document.addEventListener("DOMContentLoaded", function () {
            const btn = document.getElementById("getCancelCodeBtn");
            const form = document.getElementById("getCancelCodeForm");

            if (!btn || !form) {
                console.error("Không tìm thấy nút hoặc form!");
                return;
            }
            btn.addEventListener("click", function (e) {
                e.preventDefault();

                const Toast = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 1500,
                    timerProgressBar: true,
                    didOpen: (toast) => {
                        toast.addEventListener('mouseenter', Swal.stopTimer)
                        toast.addEventListener('mouseleave', Swal.resumeTimer)
                    }
                });

                Toast.fire({
                    icon: 'success',
                    title: 'Nhận mã xác thực thành công'
                });

                setTimeout(() => {
                    form.submit();
                }, 1500);
            });
        });
    document.addEventListener("DOMContentLoaded", function () {
        const cancelBtn = document.getElementById("submitCancelBtn");
        const cancelForm = document.getElementById("cancelForm");

        if (!cancelBtn || !cancelForm) {
            console.error("Không tìm thấy nút hoặc form hủy đơn!");
            return;
        }

        cancelBtn.addEventListener("click", function (e) {
            Swal.fire({
                title: 'Xác nhận hủy đơn',
                text: 'Bạn có chắc chắn muốn hủy đặt đơn hàng này?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy',
                width: '600px',
                padding: '2em',
                customClass: {
                    popup: 'larger-swal'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    cancelForm.submit(); // Gửi form sau khi xác nhận
                }
            });
        });
    });
</script>