@using System.Globalization
@model List<GUI.Models.DTOs.Order_DTO.OrderDetail>
@{
    Layout = "_LayoutStore";
}
<div class="section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="hot-deal">
                    <h2 class="text-uppercase">Tìm kiếm đơn hàng</h2>
                    <div class="header-search">
                        <form action="OrderChecking">
                            <input class="input" name="s" placeholder="Nhập mã đơn hàng hoặc số điện thoại" value="@(!string.IsNullOrEmpty(ViewBag.OrderSearch) ? ViewBag.OrderSearch : "")">
                            <button class="search-btn">Tìm kiếm</button>
                        </form>
                    </div>
                </div>

                @if (Model != null)
                {
                    <p class="orders-header">Đơn hàng</p>
                    foreach (var order in Model)
                    {
                        <div class="order-title">Đơn hàng <strong>@order.Code</strong></div>
                        <div class="order-info order-summary w-100">
                            <div class="order-col w-100" style="width: 100%;">
                                <div class="order-wrapper" style="width: 100%;">
                                    <table class="order-table">
                                        <thead>
                                            <tr>
                                                <th>Mã SP</th>
                                                <th>Sản phẩm</th>
                                                <th>Màu sắc</th>
                                                <th>Size</th>
                                                <th>Đơn giá</th>
                                                <th>Số lượng</th>
                                                <th>Thành tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in order.Items)
                                            {
                                                <tr>
                                                    <td>@item.Code</td>
                                                    <td>@item.ProductName</td>
                                                    <td>@item.Color</td>
                                                    <td>@item.Size</td>
                                                    <td>@item.Price.ToString("C", CultureInfo.GetCultureInfo("vi-VN"))</td>
                                                    <td>@item.Quantity</td>
                                                    <td>@((item.Price * item.Quantity).ToString("C", CultureInfo.GetCultureInfo("vi-VN")))</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            @if (order.PaymentInfo.TotalDiscount > 0)
                            {
                                <div class="order-col mb-3">
                                    <div class="order-label">Giảm giá</div>
                                    <div class="order-value">@order.PaymentInfo.TotalDiscount.ToString("C0", CultureInfo.GetCultureInfo("vi-VN"))</div>
                                </div>
                            }

                            <div class="order-col mb-3">
                                <div class="order-label">Tổng thanh toán</div>
                                <div class="order-value">@order.PaymentInfo.FinalAmount.ToString("C0", CultureInfo.GetCultureInfo("vi-VN"))</div>
                            </div>

                            <div class="order-col mb-3">
                                <div class="order-label">Thông tin khách hàng</div>
                                <div class="order-value">
                                    @if (order.ShippingInfo != null && !string.IsNullOrEmpty(order.ShippingInfo.Name))
                                    {
                                        <p>@order.ShippingInfo.Name</p>
                                        <p>@order.ShippingInfo.PhoneNumber</p>
                                        <p>@order.ShippingInfo.Address</p>
                                        <p>@order.Customer.Email</p>
                                    }
                                    else
                                    {
                                        <p>@order.Customer.Name</p>
                                        <p>@order.Customer.PhoneNumber</p>
                                        <p>@order.Customer.Address</p>
                                        <p>@order.Customer.Email</p>
                                    }
                                </div>
                            </div>

                            <div class="order-col mb-3">
                                <div class="order-label">Phương thức thanh toán</div>
                                <div class="order-value">@order.PaymentMethodName</div>
                            </div>

                            <div class="order-col mb-3">
                                <div class="order-label">Trạng thái thanh toán</div>
                                <div class="order-value text-success fw-bold">@order.PaymentInfo.PaymentStatus</div>
                            </div>

                            <div class="order-col mb-3">
                                <div class="order-label">Trạng thái đơn hàng</div>
                                <div class="order-value fw-bold">@order.StatusText</div>
                            </div>

                            <div class="order-col mb-3">
                                <div class="order-label">Thời gian đặt hàng</div>
                                <div class="order-value">@order.Created.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>
                        @if (@order.StatusText == "Chờ xác nhận")
                        {

                            <!-- Nút mở modal -->
                            <button id="openModal" class="btn btn-danger">Hủy đơn hàng</button>

                            <!-- Modal -->
                            <div id="cancelModal" class="modal">
                                <div class="modal-content">
                                    <span class="close">&times;</span>
                                    <h2>Hủy đơn hàng</h2>

                                    <!-- Form duy nhất dùng POST -->
                                    <form id="cancelForm" method="post" action="/CancelOrder">
                                        <!-- Trường ẩn chứa thông tin đơn hàng -->
                                        <input type="hidden" name="email" value="@order.Customer.Email" />
                                        <input type="hidden" name="name" value="@order.Customer.Name" />
                                        <input type="hidden" name="phone" value="@order.Customer.PhoneNumber" />
                                        <input type="hidden" name="orderCode" value="@order.Code" />

                                        <!-- Nhập lý do và mã hủy -->
                                        <label for="cancelReason">Lý do hủy:</label>
                                        <textarea id="cancelReason" name="reasonCancel" rows="3" required></textarea>

                                        <label for="cancelCode">Mã hủy đơn:</label>
                                        <input type="text" id="cancelCode" name="codeCancelOrder" required />

                                        <div class="modal-actions">
                                            <button type="button" id="closeModal">Đóng</button>
                                            <button type="submit" class="btn btn-danger">Xác nhận hủy</button>
                                        </div>
                                    </form>

                                    <!-- Nút nhận mã hủy riêng, dùng GET -->
                                    <form method="get" action="/CancelOrder" style="margin-top: 15px;">
                                        <input type="hidden" name="email" value="@order.Customer.Email" />
                                        <input type="hidden" name="name" value="@order.Customer.Name" />
                                        <input type="hidden" name="phone" value="@order.Customer.PhoneNumber" />
                                        <input type="hidden" name="orderCode" value="@order.Code" />

                                        <button type="submit" class="btn btn-warning">Nhận mã hủy đơn</button>
                                    </form>
                                </div>
                            </div>
                        }
                        <hr />
                    }
                }
            </div>
        </div>
    </div>
</div>

<style>
    .order-summary .order-col > div:last-child {
        width: 300px;
    }

    .order-col {
        margin-bottom: 1rem;
    }

    .order-label {
        font-weight: 600;
        color: #555;
        margin-bottom: 0.25rem;
    }

    .order-value {
        color: #222;
    }

    .product-item {
        background: #f9f9f9;
    }

    .order-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 900px; /* thêm để bảng không bị bóp */
    }

        .order-table th,
        .order-table td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: left;
        }

        .order-table thead {
            background-color: #f2f2f2;
        }

    .order-wrapper {
        width: 100%;
    }

    .order-info, .order-col {
        width: 100%;
        display: block;
    }

    .order-info {
        max-width: 79%;
        margin: 15px auto;
    }

    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.5);
    }

    .modal-content {
        background-color: #fff;
        margin: 10% auto;
        padding: 20px;
        border-radius: 8px;
        width: 400px;
        position: relative;
    }

    .close {
        position: absolute;
        right: 15px;
        top: 10px;
        font-size: 24px;
        cursor: pointer;
    }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 15px;
    }

    textarea, input {
        width: 100%;
        padding: 8px;
        margin-top: 5px;
        margin-bottom: 10px;
        border-radius: 4px;
        border: 1px solid #ccc;
    }

    button {
        padding: 6px 12px;
    }
</style>
<script>
    const modal = document.getElementById("cancelModal");
    const openBtn = document.getElementById("openModal");
    const closeBtn = document.getElementById("closeModal");
    const spanClose = document.querySelector(".close");

    openBtn.onclick = () => {
        modal.style.display = "block";
    };

    closeBtn.onclick = () => {
        modal.style.display = "none";
    };

    spanClose.onclick = () => {
        modal.style.display = "none";
    };

    window.onclick = (event) => {
        if (event.target == modal) {
            modal.style.display = "none";
        }
    };
    window.addEventListener("DOMContentLoaded", () => {
        const shouldOpenModal = '@(TempData["OpenCancelModal"]?.ToString().ToLower() ?? "false")';
        if (shouldOpenModal === 'true') {
            const modal = document.getElementById("cancelModal");
            if (modal) {
                modal.style.display = "block";
            }
        }
    });
    @if (ViewBag.CancelMessage != null)
    {
            <div class="alert @(ViewBag.CancelMessageType == "success" ? "alert-success" : "alert-danger")" >
            @ViewBag.CancelMessage
                </div>
    }
</script>
