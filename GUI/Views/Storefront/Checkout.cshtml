@using System.Globalization
@model List<GUI.Models.DTOs.Cart_DTO.CartDTO>
@{
	Layout = "_LayoutStore";
}
<!-- SECTION -->
<div class="section">
	<!-- container -->
	<div class="container">
		<!-- row -->
		<div class="row">

			<div class="col-md-5">
				<!-- Billing Details -->
				<div class="shipping-details active">
					<div class="section-title">
						<h3 class="title">Địa chỉ giao hàng</h3>
					</div>
					<div class="form-group">
						<input id="order-name" class="input" type="text" name="name" placeholder="Họ tên">
					</div>
@* 					<div class="form-group">
						<input class="input" type="text" name="last-name" placeholder="Last Name">
					</div> *@
					<div class="form-group">
						<input id="order-phone"
							   class="input"
							   type="tel"
							   name="tel"
							   placeholder="Số điện thoại"
							   maxlength="10"
							   oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10)"
							   required />
					</div> @* VANH *@
@* 					<div class="form-group">
						<input class="input" type="email" name="email" placeholder="Email">
					</div> *@
					<div class="form-group">
						<input id="order-address" class="input" type="text" name="address" placeholder="Số nhà/tên đường">
					</div>
					<div class="form-group">
						<input id="order-district" class="input" type="text" name="district" placeholder="Quận/huyện">
					</div>
					<div class="form-group">
						<input id="order-city" class="input" type="text" name="city" placeholder="Thành phố">
					</div>
					@* <div class="form-group">
						<input id="order-code" class="input" type="text" name="zip-code" placeholder="ZIP Code">
					</div> *@
					@* <div class="form-group">
						<div class="input-checkbox">
							<input type="checkbox" id="create-account">
							<label for="create-account">
								<span></span>
								Create Account?
							</label>
							<div class="caption">
								<p>Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt.</p>
								<input class="input" type="password" name="password" placeholder="Enter Your Password">
							</div>
						</div>
					</div> *@
				</div>
				<!-- /Billing Details -->
			</div>

			<!-- Order Details -->
			<div class="col-md-7 order-details">
				<div class="section-title text-center">
					<h3 class="title">Đơn của bạn</h3>
				</div>
				<div class="order-summary">
					<div class="order-col">
						<div><strong>Sản phẩm</strong></div>
						<div><strong>Màu</strong></div>
						<div><strong>Size</strong></div>
						<div><strong>Giá</strong></div>
						<div><strong>TỔNG TIỀN</strong></div>
					</div>
					<div class="order-products">
						@if (Model != null && Model.Any())
						{
							foreach(var item in Model)
							{
								<div class="order-col order-item" id="item-@item.CartDetailID" data-itemId="@item.CartDetailID" data-price="@item.Price">
									<div>
										@item.Quantity x @item.NameProduct
									</div>
									<div class="product-attributes">
										<span class="product-color">@item.Color</span>
									</div>
									<div class="product-attributes">
										<span class="product-size">@item.sizeName</span>
									</div>
									<div class="product-price">
										@item.Price.ToString("C", CultureInfo.GetCultureInfo("vi-VN"))
									</div>
									<div class="sub-total" data-value="@((int)(item.Quantity * item.Price))" id="sub-@item.CartDetailID">
										@(((int)(item.Quantity * item.Price)).ToString("C", CultureInfo.GetCultureInfo("vi-VN")))
									</div>
								</div>
							}
						}
					</div>
					<div class="order-col">
@* 						<div>Phí giao hàng</div>
						<div><strong id="shipping-fee">@(30000.ToString("C", CultureInfo.GetCultureInfo("vi-VN")))</strong></div> *@
					</div>
					<div class="order-col">
						<div>Giảm giá</div>
						<div><strong id="discount-value">@(0.ToString("C", CultureInfo.GetCultureInfo("vi-VN")))</strong></div>
					</div>
					<div class="order-col">
						<div><strong>TỔNG</strong></div>
						<div><strong class="order-total">@(((int)(ViewBag.Sum > 0 ? (ViewBag.Sum) : 0)).ToString("C", CultureInfo.GetCultureInfo("vi-VN")))</strong></div>
					</div>
				</div>
				<div class="shipping-method">
					<div class="order-col mb-2">
						<div><strong>Phương thức giao hàng</strong></div>
					</div>
					<div class="input-radio">
						<input type="radio" checked name="shipping" id="shipping-1" value="1">
						<label for="shipping-1">
							<span></span>
							Giao hàng tận nơi
						</label>
					</div>
					@* <div class="input-radio">
						<input type="radio" name="shipping" id="shipping-2" value="2">
						<label for="shipping-2">
							<span></span>
							Nhận tại cửa hàng
						</label>
					</div> *@
				</div>
				<div class="payment-method">
					<div class="order-col mb-2">
						<div><strong>Phương thức thanh toán</strong></div>
					</div>
					<div class="input-radio">
						<input type="radio" checked name="payment" id="payment-1" value="1">
						<label for="payment-1">
							<span></span>
							C.O.D.
						</label>
						<div class="caption">
							<p>Thanh toán khi nhận hàng.</p>
						</div>
					</div>
					<div class="input-radio">
						<input type="radio" name="payment" id="payment-2" value="2">
						<label for="payment-2">
							<span></span>
							Thanh toán qua VNPay
						</label>
						<div class="caption">
							<p>Thẻ ngân hàng hoặc QR.</p>
						</div>
					</div>
@* 					<div class="input-radio">
						<input type="radio" name="payment" id="payment-2">
						<label for="payment-2">
							<span></span>
							Cheque Payment
						</label>
						<div class="caption">
							<p>Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
						</div>
					</div>
					<div class="input-radio">
						<input type="radio" name="payment" id="payment-3">
						<label for="payment-3">
							<span></span>
							Paypal System
						</label>
						<div class="caption">
							<p>Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
						</div>
					</div> *@
				</div>
				<div class="form-search">
					<input class="input" name="s" id="voucherCode" placeholder="Mã giảm giá" value="" disabled>
					<button class="search-btn" id="voucher-btn" data-toggle="modal" data-target="#voucherModal">Áp dụng</button>
				</div>
				@if (ViewBag.Sum > 0)
				{
@* 					<div class="input-checkbox">
						<input type="checkbox" id="terms">
						<label for="terms">
							<span></span>
							I've read and accept the <a href="#">terms & conditions</a>
						</label>
					</div> *@
					<a id="order-submit" class="primary-btn order-submit">Đặt mua</a>
				}
			</div>
			<!-- /Order Details -->
		</div>
		<!-- /row -->
	</div>
	<!-- /container -->
</div>
<!-- /SECTION -->

<div class="modal fade" id="voucherModal" tabindex="-1" aria-labelledby="voucherModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
				<strong class="modal-title" id="voucherModalLabel">Danh sách voucher khả dụng</strong>
				@* <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button> *@
			</div>
			<div class="modal-body" id="voucher-list" style="max-height: 300px; overflow-y: auto">
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
			</div>
		</div>
	</div>
</div>
<style>
/* Order Details */
	/* CSS cho phần order details */
	.order-details {
		padding: 30px;
		border: 1px solid #e6e6e6;
		border-radius: 5px;
	}

	.order-summary {
		margin-bottom: 30px;
	}

	.order-col {
		display: flex;
		justify-content: space-between;
		padding: 10px 0;
		border-bottom: 1px solid #e6e6e6;
		align-items: center;
	}

		.order-col > div {
			flex: 1; /* Mỗi cột chiếm 1 phần bằng nhau */
			text-align: center;
			padding: 0 5px; /* Thêm padding để tránh dính sát */
		}

			.order-col > div:first-child {
				flex: 2; /* Chiếm 2 phần */
				text-align: left;
			}

			.order-col > div:last-child {
				text-align: right;
			}

	.order-products .order-col {
		padding: 15px 0;
	}

	.order-products .order-item {
		align-items: center;
	}
	/* Căn giữa nội dung cột Màu/Size */
	.product-attributes {
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.order-total {
		font-weight: bold;
		color: #D10024;
		font-size: 18px;
	}

	/* Căn chỉnh các cột tiêu đề */
	.order-summary > .order-col:first-child {
		font-weight: bold;
		padding-bottom: 15px;
		border-bottom: 2px solid #e6e6e6;
	}
	/* Phần voucher */
	.form-search {
		display: flex;
		margin-bottom: 20px;
	}
		.form-search .input {
			flex: 1;
			padding: 10px;
			border: 1px solid #e6e6e6;
			border-radius: 4px 0 0 4px;
		}
	/* Nút đặt mua */
	.primary-btn.order-submit {
		display: block;
		width: 100%;
		padding: 12px;
		text-align: center;
		color: white;
		border: none;
		border-radius: 4px;
		font-weight: bold;
		cursor: pointer;
		transition: all 0.3s;
	}
	/* CSS cho phần shipping và payment method */
	.shipping-method, .payment-method {
		margin-bottom: 30px;
		text-align: left; /* Căn trái toàn bộ nội dung */
	}

		.shipping-method .order-col,
		.payment-method .order-col {
			justify-content: flex-start; /* Đẩy tiêu đề sang trái */
			padding-left: 0; /* Bỏ padding trái nếu có */
		}

			.shipping-method .order-col div,
			.payment-method .order-col div {
				text-align: left; /* Căn trái nội dung */
				flex: none; /* Bỏ flex equal width */
				width: auto; /* Chiều rộng tự nhiên */
			}

	.input-radio {
		margin-bottom: 15px;
		display: flex;
		align-items: center;
		text-align: left; /* Căn trái nội dung radio */
	}

		.input-radio label {
			margin-left: 10px;
			cursor: pointer;
		}

		.input-radio .caption {
			margin-left: 28px; /* Căn lề bằng với radio button */
			margin-top: 5px;
			color: #666;
			font-size: 14px;
		}

		/* Đảm bảo radio button và label thẳng hàng */
		.input-radio input[type="radio"] {
			margin: 0;
		}

</style>