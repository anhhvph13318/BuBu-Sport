<div class="product-container">
    <div class="product__section-images product-single__media-group" data-product-single-media-group>
        <div class="gallery-main">
            <img src="https://static.nike.com/a/images/t_PDP_1728_v1/f_auto,q_auto:eco,u_126ab356-44d8-4a06-89b4-fcdcc8df0245,c_scale,fl_relative,w_1.0,h_1.0,fl_layer_apply/288a2235-54ce-4f8e-a133-0117cbc381b4/AIR+JORDAN+1+MID.png" alt="Air Jordan 1 Mid">
        </div>
        <div class="carousel-nav thumb-slider-slides">
            <div class="thumbnail-list">
                <div class="thumbnail-item">
                    <input type="radio" id="thumb-1" name="Thumbnails" checked>
                    <label for="thumb-1">
                        <img src="https://static.nike.com/a/images/t_PDP_1728_v1/f_auto,q_auto:eco,u_126ab356-44d8-4a06-89b4-fcdcc8df0245,c_scale,fl_relative,w_1.0,h_1.0,fl_layer_apply/288a2235-54ce-4f8e-a133-0117cbc381b4/AIR+JORDAN+1+MID.png" alt="Air Jordan 1 Mid">
                    </label>
                </div>
                <div class="thumbnail-item">
                    <input type="radio" id="thumb-2" name="Thumbnails">
                    <label for="thumb-2">
                        <img src="https://static.nike.com/a/images/t_PDP_1728_v1/f_auto,q_auto:eco,u_126ab356-44d8-4a06-89b4-fcdcc8df0245,c_scale,fl_relative,w_1.0,h_1.0,fl_layer_apply/d48d9a72-3123-49c7-893f-e3cb60be0a8c/AIR+JORDAN+1+MID.png" alt="Air Jordan 1 Mid">
                    </label>
                </div>
                <div class="thumbnail-item">
                    <input type="radio" id="thumb-3" name="Thumbnails">
                    <label for="thumb-3">
                        <img src="https://static.nike.com/a/images/t_PDP_1728_v1/f_auto,q_auto:eco,u_126ab356-44d8-4a06-89b4-fcdcc8df0245,c_scale,fl_relative,w_1.0,h_1.0,fl_layer_apply/a7d138bb-f05b-4708-9f1f-ccf5a6d180d2/AIR+JORDAN+1+MID.png" alt="Air Jordan 1 Mid">
                    </label>
                </div>
                <div class="thumbnail-item">
                    <input type="radio" id="thumb-4" name="Thumbnails">
                    <label for="thumb-4">
                        <img src="https://static.nike.com/a/images/t_PDP_1728_v1/f_auto,q_auto:eco,u_126ab356-44d8-4a06-89b4-fcdcc8df0245,c_scale,fl_relative,w_1.0,h_1.0,fl_layer_apply/852a384c-a6ef-45af-9bf7-2ed47d64ae4f/AIR+JORDAN+1+MID.png" alt="Air Jordan 1 Mid">
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="product-details">
        <h1>@Html.DisplayFor(model => model.Name)</h1>
        <p class="product-type">Men's Shoes</p>
        <p class="price">@Html.DisplayFor(model => model.Price)</p>
        <div class="swatches__container js-variant-selector">
            <p class="swatches__option-name"><strong>Colour:</strong> <span id="selected-option-1" class="swatches__option-value">White</span></p>


            <div class="swatches__swatch--color swatches__shape--square js-swatch-element">
                <input type="radio" id="colour-black" class="swatches__form--input" name="colour" value="@Html.DisplayFor(model => model.Color)" checked>
                <label class="swatches__form--label" for="colour-white" tabindex="0" style="background-image: url(https://static.nike.com/a/images/t_PDP_1728_v1/f_auto,q_auto:eco,u_126ab356-44d8-4a06-89b4-fcdcc8df0245,c_scale,fl_relative,w_1.0,h_1.0,fl_layer_apply/288a2235-54ce-4f8e-a133-0117cbc381b4/AIR+JORDAN+1+MID.png); background-position: center center; background-size: 50px;"></label>
            </div>

        </div>
        <div class="so-luong">
            Số lượng : @Html.DisplayFor(model => model.Quantity)
        </div>
        <button class="add-to-cart">Add to Cart</button>
        <div class="product-description">
            <h3>Description</h3>
            <p>@Html.DisplayFor(model => model.Description)</p>
        </div>
    </div>
</div>
<script src="https://unpkg.com/flickity@2/dist/flickity.pkgd.min.js"></script>
