@using System.Globalization
@model List<GUI.Models.DTOs.Cart_DTO.CartDTO>
@{
    Layout = "_LayoutStore";
}
<style> 
    /* Căn giữa nội dung trong table */
    .cart-table th, .cart-table td {
        text-align: center;
        vertical-align: middle;
    }

    /* Đảm bảo table chiếm toàn bộ chiều rộng */
    .cart-table {
        width: 100%;
        border-collapse: collapse;
    }

    /* Căn giữa số lượng */
    .quantity-box {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Điều chỉnh kích thước nút tăng/giảm */
    .cart-quant-down, .cart-quant-up {
        width: 32px;
        height: 32px;
        border: 1px solid #ddd;
        font-size: 16px;
    }

    /* Điều chỉnh kích thước input số lượng */
    .cart-input-quant {
        width: 50px;
        height: 32px;
        text-align: center;
        font-weight: bold;
        border: 1px solid #ddd;
        margin: 0 5px;
    }

</style>
@if (Model != null && Model.Any())
{
    <div class="section">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="cart-title text-center mb-4">
                        <h3 class="title">Giỏ Hàng</h3>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover text-center align-middle cart-table">
                            <thead class="table-dark">
                                <tr>
                                    <th style="width: 5%;">Chọn</th>
                                    <th style="width: 10%;">Ảnh</th>
                                    <th style="width: 20%;">Sản phẩm</th>
                                    <th style="width: 10%;">Màu sắc</th>
                                    <th style="width: 10%;">Size</th>
                                    <th style="width: 15%;">Số lượng</th>
                                    <th style="width: 10%;">Giá</th>
                                    <th style="width: 10%;">Thành tiền</th>
                                    <th style="width: 10%;">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr id="item-@item.CartDetailID" data-itemId="@item.CartDetailID" data-price="@item.Price">
                                        <td><input type="checkbox" class="chk-select-item form-check-input" id="check-@item.CartDetailID" /></td>
                                        <td><img src="@item.Image" alt="Ảnh sản phẩm" class="img-thumbnail cart-img"></td>
                                        <td>@item.NameProduct</td>
                                        <td>@item.Color</td>
                                        <td>@item.Size</td>
                                        <td>
                                            <div class="quantity-box">
                                                <button class="btn btn-sm btn-outline-secondary cart-quant-down" data-itemId="@item.CartDetailID">-</button>
                                                <input type="text" class="form-control cart-input-quant" id="quant-@item.CartDetailID" value="@item.Quantity">
                                                <button class="btn btn-sm btn-outline-secondary cart-quant-up" data-itemId="@item.CartDetailID">+</button>
                                            </div>
                                        </td>
                                        <td>@item.Price.ToString("C", CultureInfo.GetCultureInfo("vi-VN"))</td>
                                        <td class="sub-total" id="sub-@item.CartDetailID" data-value="@(item.Quantity * item.Price)">
                                            @((item.Quantity * item.Price).ToString("C", CultureInfo.GetCultureInfo("vi-VN")))
                                        </td>
                                        <td>
                                            <button class="btn btn-danger btn-sm remove-item" data-itemId="@item.CartDetailID">
                                                <i class="bi bi-trash"></i> Xóa
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <h4 class="text-danger">Tổng: <span class="cart-total">@(0.ToString("C", CultureInfo.GetCultureInfo("vi-VN")))</span></h4>
                        <button id="cart-submit" class="btn btn-primary btn-lg">Thanh toán</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $(".chk-select-item").change(function () {
                let sum = 0;
                $(".chk-select-item:checked").each(function () {
                    let id = $(this).attr('id').replace('check-', '');
                    sum += parseInt($(`#sub-${id}`).data("value"));
                });
                $('.cart-total').text(sum.toLocaleString("vi-VN", { style: "currency", currency: "VND" }));
                $("#cart-submit").toggle(sum > 0);
            });
        });
    </script>

    <style>
        /* Căn chỉnh table */
        .cart-table {
            table-layout: fixed;
            width: 100%;
        }

            .cart-table th, .cart-table td {
                vertical-align: middle;
            }

        /* Hình ảnh sản phẩm */
        .cart-img {
            width: 60px;
            height: 60px;
            object-fit: cover;
        }

        /* Ô số lượng */
        .quantity-box {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .cart-input-quant {
            width: 50px;
            height: 35px;
            text-align: center;
            font-weight: bold;
            border: 1px solid #ddd;
        }

        .cart-quant-down, .cart-quant-up {
            width: 30px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #ddd;
            transition: 0.2s;
        }

            .cart-quant-down:hover, .cart-quant-up:hover {
                background-color: #ddd;
            }

        /* Nút xóa */
        .remove-item {
            color: white !important;
        }
    </style>
}
else
{
    <!-- HOT DEAL SECTION -->
    <div class="section">
        <!-- container -->
        <div class="container">
            <!-- row -->
            <div class="row">
                <div class="col-md-12">
                    <div class="hot-deal">
                        <ul class="hot-deal-countdown">
                            <li>
                                <div>
                                    <h3>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" fill="currentColor" class="bi bi-cart-x" viewBox="0 0 16 16">
                                            <path d="M7.354 5.646a.5.5 0 1 0-.708.708L7.793 7.5 6.646 8.646a.5.5 0 1 0 .708.708L8.5 8.207l1.146 1.147a.5.5 0 0 0 .708-.708L9.207 7.5l1.147-1.146a.5.5 0 0 0-.708-.708L8.5 6.793z" />
                                            <path d="M.5 1a.5.5 0 0 0 0 1h1.11l.401 1.607 1.498 7.985A.5.5 0 0 0 4 12h1a2 2 0 1 0 0 4 2 2 0 0 0 0-4h7a2 2 0 1 0 0 4 2 2 0 0 0 0-4h1a.5.5 0 0 0 .491-.408l1.5-8A.5.5 0 0 0 14.5 3H2.89l-.405-1.621A.5.5 0 0 0 2 1zm3.915 10L3.102 4h10.796l-1.313 7zM6 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0m7 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0" />
                                        </svg>
                                    </h3>
                                </div>
                            </li>
                        </ul>
                        <h2 class="text-uppercase">Giỏ của bạn đang trống</h2>
                        <p>Hãy ủng hộ shop bằng cách mua hàng!</p>
                        <a class="primary-btn cta-btn" href="Store">Quay lại cửa hàng</a>
                    </div>
                </div>
            </div>
            <!-- /row -->
        </div>
        <!-- /container -->
    </div>
    <!-- /HOT DEAL SECTION -->
}
