@using System.Globalization
@model GUI.Models.DTOs.Product_DTO.Views.IndexObject
@{
    Layout = "_LayoutStore";
}

@if (Model.Data is not null && Model.Data.LstProduct is not null && Model.Data.LstProduct.Any())
{
    <!-- SECTION -->
    <div class="section">
        <!-- container -->
        <div class="container">
            <!-- row -->
            <div class="row">
                <!-- ASIDE -->
                <div id="aside" class="col-md-3" style="margin-top:75px;">
                    <!-- aside Widget -->
                    <div class="aside">
                        <h3 class="aside-title">Lọc sản phẩm</h3>

                        <!-- Tên sản phẩm filter -->
                        <div class="filter-item">
                            <h4 class="filter-title">Tên sản phẩm</h4>
                            <input id="filter-name" class="form-control" type="text" placeholder="Nhập tên sản phẩm">
                        </div>

                        <!-- Price filter -->
                        <div class="filter-item">
                            <h4 class="filter-title">Giá</h4>
                            <div class="price-filter">
                                <div class="input-number price-min">
                                    <input id="price-min" type="text" class="form-control filter-input"
                                           value="@string.Format(new CultureInfo("vi-VN"), "{0:N0}", ViewBag.PriceFrom ?? 0)" placeholder="Từ (đ)"/>
                                </div>
                                <span>-</span>
                                <div class="input-number price-max">
                                    <input id="price-max" type="text" class="form-control filter-input"
                                           value="@string.Format(new CultureInfo("vi-VN"), "{0:N0}", ViewBag.PriceTo ?? 100000000)" placeholder="Đến (đ)"/>
                                </div>
                            </div>
                        </div>


                        <!-- Status filter -->
                        <div class="filter-item">
                            <h4 class="filter-title">Trạng thái</h4>
                            <select id="filter-status" class="form-control filter-input">
                                <option value="">Tất cả</option>
                                <option value="available">Còn hàng</option>
                                <option value="out-of-stock">Hết hàng</option>
                            </select>
                        </div>

                        <!-- Category filter -->
                        <div class="filter-item">
                            <h4 class="filter-title">Danh mục</h4>
                            <select id="filter-category" class="form-control filter-input">
                                <option value="">Tất cả</option>
                                @foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.Name">@category.Name</option>
                                }
                            </select>
                        </div>

                        <!-- Color filter -->
                        <div class="filter-item">
                            <h4 class="filter-title">Màu sắc</h4>
                            <div class="color-filter-wrapper">
                                @foreach (var color in ViewBag.Colors)
                                {
                                    <label class="color-checkbox-wrapper" title="@color.Name">
                                        <input type="checkbox" class="color-checkbox" value="@color.Name" />
                                        <span class="color-circle" style="background-color:@color.Name"></span>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Size filter -->
                        <div class="filter-item">
                            <h4 class="filter-title">Kích cỡ</h4>
                            <div class="size-filter-wrapper">
                                @foreach (var size in ViewBag.Sizes)
                                {
                                    <label class="size-checkbox-wrapper">
                                        <input type="checkbox" class="size-checkbox" value="@size.Id" />
                                        <span class="size-label">@size.SizeName</span>
                                    </label>
                                }
                            </div>

                        </div>

                        <div class="filter-item text-center mt-4">
                            <button id="btn-search" class="btn btn-primary w-100">Tìm kiếm</button>
                            <button class="btn btn-danger w-100" onclick="resetFilters()">Xoá bộ lọc</button>
                        </div>



                        <!-- Display options -->
                        
                    </div>
                    <!-- /aside Widget -->
                </div>
                <!-- /ASIDE -->
                <div class="col-md-2">
                    <div class="form-group d-flex flex-column h-100">
                        <label for="page-display" class="filter-label mb-2">Hiển thị</label>
                        <select id="page-display" class="form-control">
                            @foreach (var item in ViewBag.TakeOptions)
                            {
                                if (item == ViewBag.Take)
                                {
                                    <option value="@item" selected>@item</option>
                                }
                                else
                                {
                                    <option value="@item">@item</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <!-- STORE -->
                <div id="store" class="col-md-9">
                    <!-- store products -->
                    
                    <div class="row" id="product-list">
                        @foreach (var item in Model.Data.LstProduct)
                        {
                            <!-- product -->
                            <div class="col-md-4 col-xs-6 product-item"
                                 data-name="@item.Name"
                                 data-category="@item.CategoryName"
                                 data-status="@(item.Quantity > 0 ? "available" : "out-of-stock")"
                                 data-price="@item.Price"
                                 data-colors="@item.Color?.Replace(" ", "").ToLowerInvariant()"
                                 data-sizes="@item.SizeName?.Replace(" ", "").ToLowerInvariant()">
                                <div class="product">
                                    <div class="product-img">
                                        <img src="@item.Image" alt="" style="cursor: pointer" onclick="redirectToDetail('@item.Id')">
                                        @if (item.Quantity <= 0)
                                        {
                                            <div class="product-label" style="width: 100%; height: 100%; position: absolute; top: 0; left: 0; display: flex; justify-content: center; align-items: center; background-color: rgba(255, 255, 255, 0.7);">
                                                <span style="padding: 8px 15px; background-color: rgba(0, 0, 0, 0.6); color: #fff; font-size: 14px; letter-spacing: 1px; font-weight: 500;">HẾT HÀNG</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="product-body">
                                        <p class="product-category">@item.CategoryName</p>
                                        <h3 class="product-name"><a href="#" onclick="redirectToDetail('@item.Id')">@item.Name</a></h3>
                                        <h4 class="product-price">
                                            @(item.Price.ToString("C", CultureInfo.GetCultureInfo("vi-VN")))
                                        </h4>
                                        <div class="product-rating">
                                        </div>
                                        <div class="product-btns">
                                            <button class="quick-view" onclick="redirectToDetail('@item.Id')">
                                                <i class="fa fa-eye"></i>
                                                <span class="tooltipp">xem chi tiết</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- /product -->
                        }
                    </div>
                    <!-- /store products -->
                    <!-- store bottom filter -->
                    <div class="store-filter clearfix">
                        <ul class="store-pagination">
                            @if (ViewBag.CurrentPage != 0)
                            {
                                <li class="pagination-btn" data-page="@(ViewBag.CurrentPage - 1)"><a href="#"><i class="fa fa-angle-left"></i></a></li>
                            }
                            @for (int i = ViewBag.StartPage; i <= ViewBag.TopPage; i++)
                            {
                                if (i >= 0 && i <= ViewBag.TotalPages)
                                {
                                    <li data-page="@i" class="pagination-btn @(i == ViewBag.CurrentPage ? "active" : "")">@(i + 1)</li>
                                }
                            }
                            @if (ViewBag.TotalPages != ViewBag.CurrentPage)
                            {
                                <li class="pagination-btn" data-page="@(ViewBag.CurrentPage + 1)"><a href="#"><i class="fa fa-angle-right"></i></a></li>
                            }
                        </ul>
                    </div>
                    <!-- /store bottom filter -->
                </div>
                <!-- /STORE -->
            </div>
            <!-- /row -->
        </div>
        <!-- /container -->
    </div>
    <!-- /SECTION -->
    <!-- Thêm JavaScript và CSS -->
    <style>
        .product-img {
            position: relative;
            overflow: hidden;
        }

        .product:hover .product-label {
            opacity: 1;
        }

        .filter-item {
            margin-bottom: 20px;
        }

        .filter-title {
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 10px;
            color: #444;
        }

        .filter-input {
            border: 1px solid #ccc;
            padding: 8px 12px;
            font-size: 14px;
            width: 100%;
            height: 38px;
            border-radius: 4px;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

            .filter-input:focus {
                border-color: #D10024;
                box-shadow: 0 0 5px rgba(209, 0, 36, 0.3);
                outline: none;
            }

        .color-filter {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .size-filter {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .input-checkbox label {
            position: relative;
            display: inline-block;
            cursor: pointer;
            padding-left: 30px;
            margin-bottom: 0;
        }

        .color-filter .input-checkbox label {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            padding-left: 0;
            margin-right: 10px;
        }

        .color-filter-wrapper {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 8px;
        }

        .color-checkbox-wrapper {
            display: inline-block;
            position: relative;
            cursor: pointer;
        }

        .color-checkbox {
            display: none; /* Ẩn checkbox gốc */
        }

        .color-circle {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            display: inline-block;
            border: 2px solid #ccc;
            transition: 0.2s;
        }

        /* Khi checkbox được chọn */
        .color-checkbox:checked + .color-circle {
            border: 3px solid #000;
            box-shadow: 0 0 0 2px white, 0 0 0 4px #000;
        }

        .color-label {
            padding: 6px 12px;
            background-color: #f0f0f0;
            border-radius: 6px;
            cursor: pointer;
            user-select: none;
            font-size: 14px;
            display: inline-block;
            white-space: nowrap;
        }

        input.color-checkbox:checked + .color-label {
            background-color: #D10024;
            color: white;
            font-weight: bold;
        }

        .color-label:hover {
            cursor: pointer;
            background-color: #e6e6e6;
        }

        .size-filter-wrapper {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            max-width: 100%;
            margin-top: 8px;
        }

        .size-checkbox-wrapper {
            display: flex;
            align-items: center;
        }

        .size-checkbox {
            display: none; 
        }

        .size-label:hover {
            background-color: #e0e0e0;
        }


        .size-label {
            padding: 6px 12px;
            background-color: #f0f0f0;
            border-radius: 6px;
            cursor: pointer;
            user-select: none;
            font-size: 14px;
            display: inline-block;
            white-space: nowrap;
        }

        .size-checkbox:checked + .size-label {
            background-color: #007bff;
            color: white;
            font-weight: bold;
        }


    </style>

    <script>
        function formatCurrencyVN(value) {
            return value.toLocaleString('vi-VN');
        }

        function parseCurrencyVN(value) {
            return parseInt(value.replace(/[^\d]/g, '')) || 0;
        }

        document.getElementById('price-min').addEventListener('input', function (e) {
            let raw = parseCurrencyVN(this.value);
            this.value = formatCurrencyVN(raw);
        });

        document.getElementById('price-max').addEventListener('input', function (e) {
            let raw = parseCurrencyVN(this.value);
            this.value = formatCurrencyVN(raw);
        });

        function resetFilters() {
            document.getElementById('filter-name').value = '';
            document.getElementById('filter-status').value = '';
            document.getElementById('filter-category').value = '';

            document.getElementById('price-min').value = formatCurrencyVN(0);
            document.getElementById('price-max').value = formatCurrencyVN(100000000);

            document.querySelectorAll('.color-checkbox, .size-checkbox').forEach(cb => cb.checked = false);

            filterProducts();
        }

        function getCheckedValues(selector) {
            return Array.from(document.querySelectorAll(selector + ':checked')).map(el => el.value);
        }
        function filterProducts() {
            const nameFilter = document.getElementById('filter-name').value.trim().toLowerCase();
            const statusFilter = document.getElementById('filter-status').value;
            const categoryFilter = document.getElementById('filter-category').value;
            const priceFrom = parseCurrencyVN(document.getElementById('price-min').value) || 0;
            const priceTo = parseCurrencyVN(document.getElementById('price-max').value) || 100000000;

            const selectedColors = getCheckedValues('.color-checkbox').map(c => c.replace(/\s+/g, '').toLowerCase());
            const selectedSizes = getCheckedValues('.size-checkbox').map(s => s.replace(/\s+/g, '').toLowerCase());

            const items = document.querySelectorAll('.product-item');
            items.forEach(item => {
                const name = item.getAttribute('data-name').toLowerCase();
                const status = item.getAttribute('data-status');
                const category = item.getAttribute('data-category');
                const price = parseFloat(item.getAttribute('data-price'));

                const itemColors = item.getAttribute('data-colors')
                    ?.split(',')
                    .map(c => c.trim().toLowerCase()) || [];

                const itemSizes = item.getAttribute('data-sizes')
                    ?.split(',')
                    .map(s => s.trim().toLowerCase()) || [];

                const matchesName = !nameFilter || name.includes(nameFilter);
                const matchesStatus = !statusFilter || status === statusFilter;
                const matchesCategory = !categoryFilter || category === categoryFilter;
                const matchesPrice = price >= priceFrom && price <= priceTo;
                const matchesColor = selectedColors.length === 0 || selectedColors.some(color => itemColors.includes(color));
                const matchesSize = selectedSizes.length === 0 || selectedSizes.some(size => itemSizes.includes(size));

                const show = matchesName && matchesStatus && matchesCategory && matchesPrice && matchesColor && matchesSize;

                item.style.display = show ? '' : 'none';
                item.style.opacity = show ? '1' : '0';
            });
        }

        document.getElementById('btn-search').addEventListener('click', function () {
             filterProducts();
        });

        const filterInputs = document.querySelectorAll('.filter-input');
        filterInputs.forEach(input => {
            input.addEventListener('input', filterProducts);
        });

        function redirectToDetail(productId) {
            window.location.href = `/productDetail?id=${productId}`;
        }

        document.addEventListener('DOMContentLoaded', function() {
            const minInput = document.getElementById('price-min');
            const maxInput = document.getElementById('price-max');

            minInput.value = formatCurrencyVN(parseCurrencyVN(minInput.value));
            maxInput.value = formatCurrencyVN(parseCurrencyVN(maxInput.value));
            document.querySelectorAll('.qty-up').forEach(btn => {
                btn.addEventListener('click', function() {
                    const input = this.parentElement.querySelector('input');
                    input.value = parseInt(input.value) + 1;
                    filterProducts();
                });
            });

            document.querySelectorAll('.qty-down').forEach(btn => {
                btn.addEventListener('click', function() {
                    const input = this.parentElement.querySelector('input');
                    if (parseInt(input.value) > 0) {
                        input.value = parseInt(input.value) - 1;
                        filterProducts();
                    }
                });
            });
            document.querySelectorAll('.color-checkbox, .size-checkbox').forEach(cb => {
                cb.addEventListener('change', filterProducts);
            });
        });
    </script>
}
else
{
    <!-- HOT DEAL SECTION -->
    <div class="section">
        <!-- container -->
        <div class="container">
            <!-- row -->
            <div class="row">
                <div class="col-md-12">
                    <div class="hot-deal">
                        <ul class="hot-deal-countdown">
                            <li>
                                <div>
                                    <h3>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" fill="currentColor" class="bi bi-emoji-frown" viewBox="0 0 16 16">
                                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                                            <path d="M4.285 12.433a.5.5 0 0 0 .683-.183A3.5 3.5 0 0 1 8 10.5c1.295 0 2.426.703 3.032 1.75a.5.5 0 0 0 .866-.5A4.5 4.5 0 0 0 8 9.5a4.5 4.5 0 0 0-3.898 2.25.5.5 0 0 0 .183.683M7 6.5C7 7.328 6.552 8 6 8s-1-.672-1-1.5S5.448 5 6 5s1 .672 1 1.5m4 0c0 .828-.448 1.5-1 1.5s-1-.672-1-1.5S9.448 5 10 5s1 .672 1 1.5" />
                                        </svg>
                                    </h3>
                                </div>
                            </li>
                        </ul>
                        <h2 class="text-uppercase">Xin lỗi!</h2>
                        <p>Không tìm thấy sản phẩm bạn muốn mua!</p>
                        <a class="primary-btn cta-btn" href="Store">Quay lại cửa hàng</a>
                    </div>
                </div>
            </div>
            <!-- /row -->
        </div>
        <!-- /container -->
    </div>
    <!-- /HOT DEAL SECTION -->
}