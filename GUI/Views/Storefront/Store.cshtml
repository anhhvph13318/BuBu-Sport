@using System.Globalization
@model GUI.Models.DTOs.Product_DTO.Views.IndexObject
@{
    Layout = "_LayoutStore";
}

<div class="container-fluid">
    @if (Model.Data is not null && Model.Data.LstProduct is not null && Model.Data.LstProduct.Any())
    {
        <div class="section">
            <div class="container">
                <button id="toggle-filter" class="btn btn-primary mb-3">
                    <i class="fas fa-filter"></i> Ẩn Bộ Lọc
                </button>

                <div class="flex-container" style="display: flex; gap: 20px;">
                    <!-- Sidebar -->
                    <div id="filter-sidebar" class="filter-sidebar">
                        <h3 class="aside-title">Lọc sản phẩm</h3>

                        <div class="filter-item">
                            <h4 class="filter-title">Tên sản phẩm</h4>
                            <input id="filter-name" class="form-control" type="text" placeholder="Nhập tên sản phẩm">
                        </div>

                        <div class="filter-item">
                            <h4 class="filter-title">Giá</h4>
                            <div class="price-filter">
                                <div class="input-number price-min">
                                    <input id="price-min" type="number" name="min" data-value="@(Model?.Data?.LowestPrice ?? 0)" value="@ViewBag.PriceFrom" class="form-control filter-input" />
                                </div>
                                <span>-</span>
                                <div class="input-number price-max">
                                    <input id="price-max" type="number" name="max" data-value="@(Model?.Data?.HighestPrice ?? 0)" value="@ViewBag.PriceTo" class="form-control filter-input" />
                                </div>
                            </div>
                        </div>

                        <div class="filter-item">
                            <h4 class="filter-title">Trạng thái</h4>
                            <select id="filter-status" class="form-control filter-input">
                                <option value="">Tất cả</option>
                                <option value="available">Còn hàng</option>
                                <option value="out-of-stock">Hết hàng</option>
                            </select>
                        </div>
                    </div>

                    <!-- Store Content -->
                    <div id="store" class="store-container">
                        <div id="product-list" class="grid-container grid-3-cols">
                            @foreach (var item in Model.Data.LstProduct)
                            {
                                <div class="product-item"
                                     data-name="@item.Name"
                                     data-status="@(item.Quantity > 0 ? "available" : "out-of-stock")"
                                     data-price="@item.Price">
                                    <div class="product">
                                        <div class="product-img" style="position: relative;">
                                            <img src="@item.Image" alt="" style="cursor: pointer;" onclick="redirectToDetail('@item.Id')" />
                                            @if (item.Quantity <= 0)
                                            {
                                                <div class="product-label">
                                                    <span>HẾT HÀNG</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="product-body">
                                            <p class="product-category">@item.CategoryName</p>
                                            <h3 class="product-name"><a href="#" onclick="redirectToDetail('@item.Id')">@item.Name</a></h3>
                                            <h4 class="product-price">@item.Price.ToString("C", CultureInfo.GetCultureInfo("vi-VN"))</h4>
                                            <div class="product-btns">
                                                <button class="quick-view" onclick="redirectToDetail('@item.Id')">
                                                    <i class="fa fa-eye"></i>
                                                    <span class="tooltipp">xem chi tiết</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Pagination -->
                        <div class="store-filter clearfix">
                            <ul class="store-pagination">
                                @if (ViewBag.CurrentPage > 0)
                                {
                                    <li class="pagination-btn" data-page="@(ViewBag.CurrentPage - 1)"><a href="#"><i class="fa fa-angle-left"></i></a></li>
                                }
                                @for (int i = ViewBag.StartPage; i <= ViewBag.TopPage; i++)
                                {
                                    if (i >= 0 && i <= ViewBag.TotalPages)
                                    {
                                        <li data-page="@i" class="pagination-btn @(i == ViewBag.CurrentPage ? "active" : "")">@(i + 1)</li>
                                    }
                                }
                                @if (ViewBag.TotalPages > ViewBag.CurrentPage)
                                {
                                    <li class="pagination-btn" data-page="@(ViewBag.CurrentPage + 1)"><a href="#"><i class="fa fa-angle-right"></i></a></li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <style>
            .filter-sidebar {
                width: 250px;
                background: #f4f4f4;
                padding: 20px;
                transition: all 0.3s ease-in-out;
            }

            .filter-sidebar.collapsed {
                display: none;
            }

            .store-container {
                flex: 1;
                transition: all 0.3s ease-in-out;
            }

            .grid-container {
                display: grid;
                gap: 20px;
            }

            .grid-3-cols {
                grid-template-columns: repeat(3, 1fr);
            }

            .grid-5-cols {
                grid-template-columns: repeat(5, 1fr);
            }

            .product-item {
                background: #fff;
                padding: 10px;
                border: 1px solid #eee;
            }

            .product-img img {
                width: 100%;
                height: auto;
            }

            .product-label {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                display: flex;
                justify-content: center;
                align-items: center;
                background: rgba(255, 255, 255, 0.7);
            }

            .product-label span {
                background: rgba(0, 0, 0, 0.6);
                color: #fff;
                padding: 6px 12px;
                font-size: 14px;
            }

            /* Responsive */
            @@media (max-width: 768px) {
                .grid-3-cols,
                .grid-5-cols {
                    grid-template-columns: repeat(2, 1fr);
                }

                .filter-sidebar {
                    display: none !important;
                }

                #store {
                    width: 100%;
                }
            }

            @@media (max-width: 480px) {
                .grid-3-cols,
                .grid-5-cols {
                    grid-template-columns: 1fr;
                }
            }
        </style>

    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const toggleBtn = document.getElementById("toggle-filter");
                const sidebar = document.getElementById("filter-sidebar");
                const store = document.getElementById("store");
                const productList = document.getElementById("product-list");

                toggleBtn.addEventListener("click", function () {
                    const isCollapsed = sidebar.classList.contains("collapsed");

                    sidebar.classList.toggle("collapsed");
                    store.classList.toggle("full-width");

                    if (isCollapsed) {
                        productList.classList.remove("grid-5-cols");
                        productList.classList.add("grid-3-cols");
                        toggleBtn.innerHTML = '<i class="fas fa-filter"></i> Ẩn Bộ Lọc';
                    } else {
                        productList.classList.remove("grid-3-cols");
                        productList.classList.add("grid-5-cols");
                        toggleBtn.innerHTML = '<i class="fas fa-filter"></i> Hiện Bộ Lọc';
                    }
                });
            });
        function toggleSidebar() {
            const wrapper = document.querySelector('.store-wrapper');
            wrapper.classList.toggle('hide-sidebar');
        }
        // Hàm lọc sản phẩm
        function filterProducts() {
            const nameFilter = document.getElementById('filter-name').value.toLowerCase();
            const statusFilter = document.getElementById('filter-status').value;
            const categoryFilter = document.getElementById('filter-category').value;
            const priceFrom = parseFloat(document.getElementById('price-min').value) || 0;
            const priceTo = parseFloat(document.getElementById('price-max').value) || Infinity;

            // Lấy sizes được chọn
            const selectedSizes = [];
            document.querySelectorAll('.filter-size:checked').forEach(checkbox => {
                selectedSizes.push(checkbox.value);
            });

            // Lấy colors được chọn
            const selectedColors = [];
            document.querySelectorAll('.filter-color:checked').forEach(checkbox => {
                selectedColors.push(checkbox.value);
            });

            const items = document.querySelectorAll('.product-item');
            items.forEach(item => {
                const name = item.getAttribute('data-name').toLowerCase();
                const status = item.getAttribute('data-status');
                const category = item.getAttribute('data-category');
                const price = parseFloat(item.getAttribute('data-price'));
                const itemSizes = item.getAttribute('data-sizes').split(',');
                const itemColors = item.getAttribute('data-colors').split(',');

                const matchesName = nameFilter ? name.includes(nameFilter) : true;
                const matchesStatus = statusFilter ? status === statusFilter : true;
                const matchesCategory = categoryFilter ? category === categoryFilter : true;
                const matchesPrice = price >= priceFrom && price <= priceTo;

                // Kiểm tra xem có size phù hợp không
                let matchesSize = true;
                if (selectedSizes.length > 0) {
                    matchesSize = selectedSizes.some(size => itemSizes.includes(size));
                }

                // Kiểm tra xem có màu phù hợp không
                let matchesColor = true;
                if (selectedColors.length > 0) {
                    matchesColor = selectedColors.some(color => itemColors.includes(color));
                }

                if (matchesName && matchesStatus && matchesCategory && matchesPrice && matchesSize && matchesColor) {
                    item.style.display = '';
                    // Thêm hiệu ứng fade in
                    item.style.opacity = '0';
                    setTimeout(() => {
                        item.style.transition = 'opacity 0.5s ease';
                        item.style.opacity = '1';
                    }, 50);
                } else {
                    item.style.display = 'none';
                    item.style.opacity = '0';
                }
            });
        }

        // Thêm sự kiện cho tất cả các filter input
        const filterInputs = document.querySelectorAll('.filter-input, .filter-size, .filter-color');
        filterInputs.forEach(input => {
            if (input.type === 'checkbox') {
                input.addEventListener('change', filterProducts);
            } else {
                input.addEventListener('input', filterProducts);
            }
        });

        // Xử lý chuyển trang chi tiết sản phẩm
        function redirectToDetail(productId) {
            window.location.href = `/productDetail?id=${productId}`;
        }

        // Khởi tạo filter ban đầu
        document.addEventListener('DOMContentLoaded', function() {
            // Đặt sự kiện cho nút +/- của price filters
            document.querySelectorAll('.qty-up').forEach(btn => {
                btn.addEventListener('click', function() {
                    const input = this.parentElement.querySelector('input');
                    input.value = parseInt(input.value) + 1;
                    filterProducts();
                });
            });

            document.querySelectorAll('.qty-down').forEach(btn => {
                btn.addEventListener('click', function() {
                    const input = this.parentElement.querySelector('input');
                    if (parseInt(input.value) > 0) {
                        input.value = parseInt(input.value) - 1;
                        filterProducts();
                    }
                });
            });
        });
    </script>
}
else
{
    <!-- HOT DEAL SECTION -->
    <div class="section">
        <!-- container -->
        <div class="container">
            <!-- row -->
            <div class="row">
                <div class="col-md-12">
                    <div class="hot-deal">
                        <ul class="hot-deal-countdown">
                            <li>
                                <div>
                                    <h3>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" fill="currentColor" class="bi bi-emoji-frown" viewBox="0 0 16 16">
                                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                                            <path d="M4.285 12.433a.5.5 0 0 0 .683-.183A3.5 3.5 0 0 1 8 10.5c1.295 0 2.426.703 3.032 1.75a.5.5 0 0 0 .866-.5A4.5 4.5 0 0 0 8 9.5a4.5 4.5 0 0 0-3.898 2.25.5.5 0 0 0 .183.683M7 6.5C7 7.328 6.552 8 6 8s-1-.672-1-1.5S5.448 5 6 5s1 .672 1 1.5m4 0c0 .828-.448 1.5-1 1.5s-1-.672-1-1.5S9.448 5 10 5s1 .672 1 1.5" />
                                        </svg>
                                    </h3>
                                </div>
                            </li>
                        </ul>
                        <h2 class="text-uppercase">Xin lỗi!</h2>
                        <p>Không tìm thấy sản phẩm bạn muốn mua!</p>
                        <a class="primary-btn cta-btn" href="Store">Quay lại cửa hàng</a>
                    </div>
                </div>
            </div>
            <!-- /row -->
        </div>
        <!-- /container -->
    </div>
    <!-- /HOT DEAL SECTION -->
}