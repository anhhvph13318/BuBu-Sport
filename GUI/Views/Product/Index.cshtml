@model GUI.Models.DTOs.Product_DTO.Views.IndexObject

@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";
}

<div class="container-fluid px-4 mt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">
            <i class="bi bi-bag-fill me-2"></i>Danh Sách Sản Phẩm
        </h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i>Tạo mới
        </a>
    </div>

    <!-- Card tìm kiếm -->
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-header bg-light">
            <i class="bi bi-search me-1"></i>
            Tìm kiếm sản phẩm
        </div>
        <div class="card-body">
            <form asp-controller="Product" asp-action="Index" method="get" class="row g-3">
                <div class="col-md-4">
                    <label for="name" class="form-label">Tên sản phẩm</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-tag"></i></span>
                        <input type="text" class="form-control" id="name" name="name" value="@ViewBag.CurrentName" placeholder="Nhập tên sản phẩm">
                    </div>
                </div>
                <div class="col-md-4">
                    <label for="categoryId" class="form-label">Danh mục</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-collection"></i></span>
                        <select class="form-select" id="categoryId" name="categoryId">
                            <option value="">-- Tất cả danh mục --</option>
                            @foreach (var category in ViewBag.Categories)
                            {
                                @if (ViewBag.CurrentCategoryId == category.Id)
                                {
                                    <option value="@category.Id" selected>@category.Name</option>
                                }
                                else
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <label for="status" class="form-label">Trạng thái</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-toggle-on"></i></span>
                        <select class="form-select" id="status" name="status">
                            <option value="0">Tất cả</option>
                            <option value="1" >Hoạt động</option>
                            <option value="2" >Ngừng hoạt động</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <label for="priceFrom" class="form-label">Giá từ</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                        <input type="number" class="form-control" id="priceFrom" name="priceFrom" value="@ViewBag.CurrentPriceFrom" placeholder="Giá từ">
                    </div>
                </div>
                <div class="col-md-6">
                    <label for="priceTo" class="form-label">Đến giá</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                        <input type="number" class="form-control" id="priceTo" name="priceTo" value="@ViewBag.CurrentPriceTo" placeholder="Đến giá">
                    </div>
                </div>
                <div class="col-12 mt-3">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-search me-1"></i> Tìm kiếm
                    </button>
                    <a href="@Url.Action("Index", "Product")" class="btn btn-secondary">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Danh sách sản phẩm -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
            <i class="bi bi-table me-1"></i>
            Kết quả tìm kiếm
        </div>
        <div class="card-body table-responsive">
            <table class="table table-hover table-striped">
                <thead class="table-primary">
                    <tr>
                        <th class="text-center" style="width: 50px;">STT</th>
                        <th>Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Giá Khuyến mãi</th>
                        <th class="text-end">Giá bán</th>
                        <th>Danh mục</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Hình ảnh</th>
                        <th class="text-center" style="width: 150px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Data is not null && Model.Data.LstProduct is not null && Model.Data.LstProduct.Any())
                    {
                        var index = 1;
                        @foreach (var item in Model.Data.LstProduct)
                        {
                            <tr>
                                <td class="text-center">@index</td>
                                <td><span class="badge bg-secondary">@item.Code</span></td>
                                <td>@item.Name</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.PriceSale.ToString("N0") đ</td>
                                <td class="text-end">@item.Price.ToString("N0") đ</td>
                                <td>@item.CategoryName</td>
                                <td class="text-center">
                                    <span class="badge @(item.Status == "Hoạt động" ? "bg-success" : "bg-danger")">
                                        <i class="bi @(item.Status == "Hoạt động" ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-center">
                                    <img src="@item.Image" alt="@item.Name" 
                                         class="img-thumbnail" style="width: 80px; height: 80px; object-fit: cover;">
                                </td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        @* <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">
                                            <i class="bi bi-info-circle"></i>
                                        </a> *@
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4">
                                <div class="text-secondary">
                                    <i class="bi bi-inbox-fill" style="font-size: 3rem;"></i>
                                    <p class="mt-2">Không tìm thấy sản phẩm nào.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-light d-flex justify-content-between align-items-center">
            <div>
                <span class="text-muted">Hiển thị @(Model.Data?.LstProduct?.Count() ?? 0) sản phẩm</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Hiệu ứng hover cho các hàng trong bảng
            $('table tbody tr').hover(
                function () {
                    $(this).addClass('table-active');
                },
                function () {
                    $(this).removeClass('table-active');
                }
            );
        });
    </script>
}