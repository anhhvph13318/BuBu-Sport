@model GUI.Models.DTOs.Product_DTO.DetailProductResponse

@{
    ViewData["Title"] = "Xác nhận Xóa";
}

<div class="card shadow-sm border-danger">
    <div class="card-header bg-danger text-white text-center">
        <h4>Bạn có chắc muốn xóa sản phẩm này?</h4>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <strong>Tên sản phẩm:</strong> @Model.Name
        </div>
        <div class="mb-3">
            <strong>Mã sản phẩm:</strong> @Model.Code
        </div>
        <div class="mb-3">
            <strong>Giá sản phẩm:</strong> @Model.Price VNĐ
        </div>
    </div>
    <div class="card-footer text-center">
        <form asp-action="ConfirmDelete" method="post">
            <input type="hidden" name="Id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Xóa</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>