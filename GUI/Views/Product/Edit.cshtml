@model GUI.Models.DTOs.Product_DTO.DetailProductResponse

@{
    ViewData["Title"] = "Edit";
}

<div class="container mt-5">
    <form asp-action="Edit" enctype="multipart/form-data" class="bg-light p-4 rounded shadow-sm">
        <h2 class="text-center mb-4">Chỉnh sửa sản phẩm</h2>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <!-- Cột hiển thị thông tin sản phẩm -->
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="Code" class="form-label">Mã sản phẩm</label>
                    <input asp-for="Code" class="form-control" placeholder="Nhập mã sản phẩm" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Name" class="form-label">Tên sản phẩm</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Price" class="form-label">Giá sản phẩm</label>
                    <input asp-for="Price" class="form-control" placeholder="Nhập giá sản phẩm" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Description" class="form-label">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" placeholder="Nhập mô tả"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="CategoryId" class="form-label">Danh mục</label>
                    <select id="categorySelect" asp-for="CategoryId" class="form-select">
                        <option value="">Chọn danh mục</option>
                        @foreach (var item in ViewBag.Categories)
                        {
                            if (Model.CategoryId == item.Id)
                            {
                                <option value="@item.Id" selected>@item.Name</option>
                            }
                            else
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <!-- Nút Save và Quay trở lại -->
                <div class="form-group d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Quay trở lại</a>
                    <button type="button" class="btn btn-primary" id="saveButton">
                        <span class="spinner-border spinner-border-sm" id="spinner" role="status" aria-hidden="true" style="display:none;"></span>
                        Save
                    </button>
                </div>
            </div>

            <!-- Cột hiển thị ảnh sản phẩm -->
            <div class="col-md-6 d-flex justify-content-center align-items-center">
                <div>
                    <div class="form-group">
                        <label asp-for="UrlImage" class="form-label">Ảnh sản phẩm</label>
                        <input type="file" id="fileInput" class="form-control" accept="image/*" onchange="previewImage();" />
                        <img id="imagePreview"
                             src="@Model.Image"
                             alt="Image preview"
                             style="display:none; width: 250px; height: 250px; object-fit: cover;"
                             class="mt-3 img-thumbnail" />
                        <input type="hidden" asp-for="UrlImage" value="@Model.Image" id="urlImage" />
                    </div>
                    <a asp-controller="ProductDetail" asp-action="CreateDetail" asp-route-productId="@Model.Id" class="btn btn-secondary mt-2">Thêm biến thể</a>
                </div>
            </div>
        </div>
    </form>

    <!-- Bảng biến thể với bộ lọc -->
    <div class="bg-light p-4 rounded shadow-sm mt-4">
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Lọc theo màu sắc</label>
                <select id="colorFilter" class="form-select">
                    <option value="">Tất cả màu sắc</option>
                    @if (Model.DetailDataFinal != null && Model.DetailDataFinal.Any())
                    {
                        var uniqueColors = Model.DetailDataFinal.Select(d => d.ColorName).Distinct();
                        foreach (var color in uniqueColors)
                        {
                            <option value="@color">@color</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Lọc theo size</label>
                <select id="sizeFilter" class="form-select">
                    <option value="">Tất cả size</option>
                    @if (Model.DetailDataFinal != null && Model.DetailDataFinal.Any())
                    {
                        var uniqueSizes = Model.DetailDataFinal.Select(d => d.SizeName).Distinct();
                        foreach (var size in uniqueSizes)
                        {
                            <option value="@size">@size</option>
                        }
                    }
                </select>
            </div>
        </div>

        <table class="table table-bordered" id="variantTable">
            <thead class="table-dark">
                <tr>
                    <th>Ảnh</th>
                    <th>Số lượng</th>
                    <th>Màu sắc</th>
                    <th>Size</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DetailDataFinal is not null && Model.DetailDataFinal.Any())
                {
                    @foreach (var item in Model.DetailDataFinal)
                    {
                        <tr>
                            <td>
                                <img src="@item.UrlImage" alt="Hình ảnh" style="width: 68px; height: 48px; object-fit: cover;" />
                            </td>
                            <td>
                                <input type="number" class="form-control quantity-input" value="@item.Quantity" data-id="@item.Id" min="0" />
                            </td>
                            <td>@item.ColorName</td>
                            <td>@item.SizeName</td>
                            <td>
                                <button type="button" class="btn btn-success btn-save-quantity" data-id="@item.Id">Lưu</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">Không có sản phẩm nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    (function ($) {
        $('#fileInput').on("change", function (e) {
            let file = e.target.files[0];
            let form = new FormData();

            form.append("api_key", "284335524597493");
            form.append("upload_preset", "vanh2204");
            form.append("public_id", new Date().toISOString().replace(/[-:.]/g, ""));
            form.append("file", file);

            var settings = {
                "async": true,
                "crossDomain": true,
                "url": "https://api.cloudinary.com/v1_1/dnvuz3evz/image/upload",
                "method": "POST",
                "processData": false,
                "contentType": false,
                "mimeType": "multipart/form-data",
                "data": form
            };

            $.ajax(settings).done(function (response) {
                let data = JSON.parse(response);
                console.log(data);
                if (data) {
                    let url = data.secure_url ?? data.url;
                    console.log(url);
                    if (url) {
                        $("#imagePreview").attr("src", url);
                        $("#imagePreview").show();
                        $('#urlImage').val(url);
                    } else {
                        $("#imagePreview").hide();
                    }
                }
            });
        });

        let a = $("#imagePreview").attr("src");
        if (a) {
            $("#imagePreview").show();
        }
    })(jQuery);

    // Hiển thị preview ảnh sau khi chọn file
    function previewImage() {
        const fileInput = document.getElementById('fileInput');
        const preview = document.getElementById('imagePreview');
        const urlImage = document.getElementById('urlImage');

        if (fileInput.files && fileInput.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
            };
            reader.readAsDataURL(fileInput.files[0]);
        } else {
            preview.style.display = 'none';
        }
    }

    document.getElementById('saveButton').addEventListener('click', function () {
        const isConfirmed = confirm('Bạn có chắc muốn lưu không?');
        if (isConfirmed) {
            const spinner = document.getElementById('spinner');
            spinner.style.display = 'inline-block'; // Hiện spinner khi nhấn nút
            this.closest('form').submit(); // Gửi form
        }
    });

    // Lọc bảng theo size và màu sắc
    $(document).ready(function () {
        console.log("jQuery loaded, binding filter events");

        $('#colorFilter, #sizeFilter').on('change', function () {
            const colorFilter = $('#colorFilter').val().toLowerCase().trim();
            const sizeFilter = $('#sizeFilter').val().toLowerCase().trim();

            console.log("Color filter:", colorFilter);
            console.log("Size filter:", sizeFilter);

            $('#variantTable tbody tr').each(function () {
                const row = $(this);
                const color = row.data('color') ? row.data('color').toString().toLowerCase().trim() : '';
                const size = row.data('size') ? row.data('size').toString().toLowerCase().trim() : '';

                console.log("Row color:", color, "Row size:", size);

                const colorMatch = !colorFilter || color === colorFilter;
                const sizeMatch = !sizeFilter || size === sizeFilter;

                if (colorMatch && sizeMatch) {
                    console.log("Showing row:", row);
                    row.show();
                } else {
                    console.log("Hiding row:", row);
                    row.hide();
                }
            });
        });
    });

    //sua so luong bien the san pham
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".btn-save-quantity").forEach(button => {
            button.addEventListener("click", function () {
                let id = this.getAttribute("data-id");
                let inputField = document.querySelector(`.quantity-input[data-id='${id}']`);
                let newQuantity = inputField.value;

                fetch("/Product/UpdateDetailQuantity", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-CSRF-TOKEN": document.querySelector("input[name='__RequestVerificationToken']").value
                    },
                    body: JSON.stringify({ id: id, quantity: newQuantity })
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert("Cập nhật thành công!");
                        } else {
                            alert("Cập nhật thất bại!");
                        }
                    })
                    .catch(error => console.error("Lỗi:", error));
            });
        });
    });
</script>