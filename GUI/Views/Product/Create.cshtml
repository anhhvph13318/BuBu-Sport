@model GUI.Models.DTOs.Product_DTO.CreateProductRequest

@{
    ViewData["Title"] = "Thêm sản phẩm";

    // Sắp xếp sizes từ lớn đến bé - cách an toàn không dùng LINQ
    var sortedSizes = new List<dynamic>(ViewBag.Sizes);
    sortedSizes.Sort((a, b) => string.Compare(b.SizeName, a.SizeName));
}

<div class="container mt-5">
    <form asp-action="Create" enctype="multipart/form-data" class="bg-white p-4 rounded shadow" id="createProductForm" novalidate>
        <h2 class="text-center mb-4 fw-bold text-primary">Thêm sản phẩm mới</h2>
        <hr class="mb-4">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- Section 1: Thông tin cơ bản -->
        <div id="infoSection">
            <div class="row">
                <!-- Cột trái: Form nhập liệu -->
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Code" class="form-label fw-semibold">Mã sản phẩm</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                            <input asp-for="Code" class="form-control" id="productCode" placeholder="SP00001" required maxlength="7" pattern="SP\d{5}" title="Mã sản phẩm phải là 'SP' theo sau bởi đúng 5 chữ số (ví dụ: SP00001)" />
                        </div>
                        <span asp-validation-for="Code" class="text-danger" id="codeValidationMessage"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Tên sản phẩm</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-tag"></i></span>
                            <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm" required maxlength="100" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Price" class="form-label fw-semibold">Giá sản phẩm</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                            <input asp-for="Price" class="form-control" id="priceInput" placeholder="Nhập giá sản phẩm" type="number" required min="0" step="1000" title="Giá phải là số không âm, tối thiểu 0" />

                        </div>
                        <div class="form-text" id="priceFormatted">0 ₫</div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Danh mục</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-folder"></i></span>
                            <select asp-for="CategoryId" class="form-select" required>
                                <option value="" disabled selected>Chọn danh mục</option>
                                @foreach (var item in ViewBag.Categories)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                </div>

                <!-- Cột phải: Mô tả -->
                <div class="col-md-6">
                    <div class="form-group mb-3 h-90">
                        <label asp-for="Description" class="form-label fw-semibold">Mô tả</label>
                        <div class="input-group h-100">
                            <span class="input-group-text"><i class="bi bi-file-text"></i></span>
                            <textarea asp-for="Description" class="form-control " placeholder="Nhập mô tả sản phẩm..." rows="9" required maxlength="500" title="Mô tả không được để trống và tối đa 500 ký tự"></textarea>
                        </div>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Nút tiếp tục -->
            <div class="form-group text-center mt-4">
                <button type="button" class="btn btn-primary px-4 py-2 mt-4" id="nextStep">
                    <i class="bi bi-arrow-right-circle me-2"></i>Tiếp tục
                </button>
            </div>
        </div>

        <!-- Section 2: Màu sắc, Size và Ảnh -->
        <div id="imageSection" style="display: none;">
            <div class="row">
                <!-- Cột trái: Màu sắc và Size -->
                <div class="col-md-6">
                    <div class="form-group mb-4">
                        <label asp-for="Color" class="form-label fw-semibold d-flex justify-content-between align-items-center">
                            <span>Màu sắc</span>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="addColorButton">
                                <i class="fas fa-plus me-1"></i>Thêm màu sắc
                            </button>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-palette"></i></span>
                            <select id="categorySelect" asp-for="Color" class="form-select">
                                <option selected value="">Chọn màu sắc</option>
                                @foreach (var item in ViewBag.Colors)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="Color" class="text-danger"></span>
                    </div>

                    <!-- Phần chọn size đã được tối ưu -->
                    <div class="form-group mb-4">
                        <label class="form-label fw-semibold d-flex justify-content-between align-items-center">
                            <span>Size & Số Lượng</span>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-circle" id="toggleSizeTable" title="Ẩn/hiện bảng size">
                                <i class="bi bi-chevron-up" id="toggleIcon"></i>
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="addSizeButton"><i class="fas fa-plus me-1"></i>Thêm size</button>

                        </label>
                        <div class="card border" id="sizeTableContainer">
                            <div class="card-body p-2">
                                <div class="row g-2" id="sizeGridContainer">
                                    @foreach (var item in sortedSizes)
                                    {
                                        <div class="col-md-4 col-6">
                                            <div class="size-item border rounded p-2 d-flex align-items-center">
                                                <div class="form-check me-2">
                                                    <input type="checkbox" class="form-check-input sizeCheckbox" id="size_@item.Id" data-size-id="@item.Id">
                                                    <label class="form-check-label fw-bold" for="size_@item.Id">@item.SizeName</label>
                                                </div>
                                                <div class="input-group input-group-sm flex-grow-1">
                                                    <input type="number" class="form-control form-control-sm quantityInput"
                                                           id="quantity_@item.Id" min="0" value="0" disabled>
                                                    <input type="hidden" class="sizeIdInput" value="@item.Id">
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cột phải: Upload ảnh -->
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="UrlImage" class="form-label fw-semibold">Ảnh sản phẩm</label>
                        <div class="card border bg-light">
                            <div class="card-body text-center">
                                <img id="imagePreview" src="/path/to/default-image.jpg" alt="Xem trước hình ảnh" class="mb-3 img-fluid img-thumbnail" style="max-height: 250px; max-width: 100%;">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-image"></i></span>
                                    <input type="file" id="fileInput" class="form-control" accept="image/*" required title="Vui lòng chọn một ảnh sản phẩm" />
                                </div>
                                <input type="hidden" asp-for="UrlImage" id="urlImage" />
                                <span asp-validation-for="UrlImage" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nút quay lại và thêm mới -->
            <div class="form-group d-flex justify-content-between mt-4">
                <button type="button" class="btn btn-outline-secondary px-4 py-2" id="prevStep">
                    <i class="bi bi-arrow-left-circle me-2"></i>Quay lại
                </button>
                <button type="submit" class="btn btn-success px-4 py-2" id="submitButton">
                    <i class="bi bi-plus-circle me-2"></i>Thêm mới
                </button>
            </div>
        </div>
    </form>
</div>
<!-- Modal thêm size-->
<input type="hidden" id="sizeValidation" name="sizeValidation" required>

<div class="modal fade" id="addSizeModal" tabindex="-1" aria-labelledby="addSizeLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="addSizeLabel"><i class="fas fa-ruler me-2"></i>Thêm size</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label for="newSizeName" class="form-label">Tên size</label>
                <input type="text" id="newSizeName" class="form-control" placeholder="Nhập size (VD: 40, 40.5)"
                       pattern="^\d{1,2}(\.5)?$"
                       title="Size phải là số nguyên hoặc số thập phân .5 (VD: 40, 40.5, 41, 41.5)" required>
                <input type="hidden" id="modalProductIdSize" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Đóng</button>
                <button type="button" class="btn btn-primary" id="saveNewSize"><i class="fas fa-save me-1"></i>Lưu</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal thêm màu sắc -->
<div class="modal fade" id="addColorModal" tabindex="-1" aria-labelledby="addColorLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addColorLabel">Thêm màu sắc mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="newColorName" class="form-label">Tên màu sắc</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-palette"></i></span>
                        <input type="text" id="newColorName" class="form-control" placeholder="Nhập tên màu"
                               pattern="^[A-Za-zÀ-ỹ\s]+$"
                               title="Tên màu chỉ được chứa chữ cái và khoảng trắng" required>
                    </div>
                    <input type="hidden" id="modalProductId" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="saveNewColor">
                    <i class="bi bi-save me-1"></i>Lưu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- CSS cho phần size -->
<style>
    .size-item {
        background-color: #f8f9fa;
        transition: all 0.2s ease;
    }

        .size-item:hover {
            background-color: #e9ecef;
        }

    .form-check-input:checked + .form-check-label {
        color: #0d6efd;
    }
</style>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const sectionId = localStorage.getItem("scrollToSection");
        if (sectionId) {
            const section = document.getElementById(sectionId);
            if (section) {
                section.scrollIntoView({ behavior: "smooth", block: "start" });
            }
            localStorage.removeItem("scrollToSection"); // cleanup
        }
    });
</script>
<script>
    function saveSection1Data() {
        // Lưu dữ liệu từ các trường trong section 1
        localStorage.setItem("productCode", document.getElementById("productCode").value);
        localStorage.setItem("productName", document.getElementById("Name").value);
        localStorage.setItem("productPrice", document.getElementById("priceInput").value);
        localStorage.setItem("productCategory", document.getElementById("CategoryId").value);
        localStorage.setItem("productDescription", document.getElementById("Description").value);
    }
    function restoreSection1Data() {
        // Khôi phục dữ liệu cho các trường trong section 1
        const productCode = localStorage.getItem("productCode");
        const productName = localStorage.getItem("productName");
        const productPrice = localStorage.getItem("productPrice");
        const productCategory = localStorage.getItem("productCategory");
        const productDescription = localStorage.getItem("productDescription");

        // Điền lại dữ liệu vào form nếu có
        if (productCode) document.getElementById("productCode").value = productCode;
        if (productName) document.getElementById("Name").value = productName;
        if (productPrice) {
            document.getElementById("priceInput").value = productPrice;
            // Cập nhật lại định dạng giá (nếu có)
            if (typeof updatePriceFormat === 'function') {
                updatePriceFormat();
            }
        }
        if (productCategory) document.getElementById("CategoryId").value = productCategory;
        if (productDescription) document.getElementById("Description").value = productDescription;
    }
    function clearSection1Data() {
        localStorage.removeItem("productCode");
        localStorage.removeItem("productName");
        localStorage.removeItem("productPrice");
        localStorage.removeItem("productCategory");
        localStorage.removeItem("productDescription");
    }
    function confirmAction() {

        Swal.fire({
            title: 'Cảnh báo',
            text: "Bạn có chắc chắn muốn thực hiện hành động này?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Có, lưu lại!',
            cancelButtonText: 'Không, hủy bỏ!'
        }).then((result) => {
            if (result.isConfirmed) {
                // Nếu người dùng chọn "Đồng ý", submit form
                document.querySelector('form').submit(); // Submit form sau khi xác nhận
            }
        });

        return false; // Ngừng submit form nếu chưa xác nhận
    }
    // Lưu màu sắc mới

    async function saveNewColor() {
        const Name = document.getElementById("newColorName").value.trim();
        const letterOnlyRegex = /^[A-Za-zÀ-ỹ\s]+$/;

        if (!Name) {
            Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Vui lòng nhập tên màu sắc' });
            return null;
        }

        if (!letterOnlyRegex.test(Name)) {
            Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Tên màu chỉ được chứa chữ cái và khoảng trắng' });
            return null;
        }

        try {
            saveSection1Data();
            localStorage.setItem("activeSection", "imageSection");

            const response = await fetch("/ProductDetail/CreateColorDetail", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name: Name })
            });

            if (!response.ok) {
                const errorData = await response.json();
                throw new Error(errorData.message || "Thêm màu thất bại!");
            }

            const newColor = await response.json();
            document.getElementById("newColorName").value = "";
            bootstrap.Modal.getInstance(document.getElementById('addColorModal')).hide();
            window.location.reload();
            return newColor;
        } catch (error) {
            Swal.fire({ icon: 'error', title: 'Lỗi', text: error.message });
            return null;
        }
    }

    // Color confirmation click handler
    document.getElementById("saveNewColor").addEventListener("click", async function () {
        const result = await Swal.fire({
            title: 'Xác nhận thực hiện hành động',
            text: "Bạn có chắc chắn muốn thực hiện hành động này?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Có, lưu lại!',
            cancelButtonText: 'Không, hủy bỏ!'
        });

        if (result.isConfirmed) {
            await saveNewColor(); // This now correctly saves section state
        }
    });

    // DOMContentLoaded event handler
    document.addEventListener("DOMContentLoaded", function () {
        const infoSection = document.getElementById("infoSection");
        const imageSection = document.getElementById("imageSection");
        const section = localStorage.getItem("activeSection");

        // Kiểm tra URL hiện tại để xác định nếu đang ở trang thêm mới sản phẩm
        const currentUrl = window.location.pathname.toLowerCase();
        const isAddNewProductPage = currentUrl.includes("create") || currentUrl.includes("add");
        if (isAddNewProductPage) {
            restoreSection1Data();
        }
        // Nếu là trang thêm mới sản phẩm và KHÔNG có thao tác thêm màu/size trước đó
        // thì luôn hiển thị section 1 (mặc định)
        if (isAddNewProductPage && !section) {
            // Xóa activeSection trong localStorage nếu có
            localStorage.removeItem("activeSection");

            // Hiển thị section 1, ẩn section 2
            if (infoSection && imageSection) {
                infoSection.style.display = "block";
                imageSection.style.display = "none";
            }
        }
        // Nếu có localStorage activeSection (do thêm màu/size) thì giữ đúng section đó
        else if (section === "imageSection") {
            // Hiển thị section 2, ẩn section 1
            if (infoSection && imageSection) {
                infoSection.style.display = "none";
                imageSection.style.display = "block";
            }
        }
        // Mặc định khác hoặc khi không có activeSection
        else {
            // Hiển thị section 1, ẩn section 2
            if (infoSection && imageSection) {
                infoSection.style.display = "block";
                imageSection.style.display = "none";
            }
        }
    });

    // Xử lý khi click nút next
    document.getElementById('nextStep').addEventListener('click', function () {
        // Lưu trạng thái khi chuyển sang section 2
        localStorage.setItem("activeSection", "imageSection");

        // Hiển thị section 2, ẩn section 1
        document.getElementById('infoSection').style.display = 'none';
        document.getElementById('imageSection').style.display = 'block';
    });

    // Xử lý khi click nút quay lại
    document.getElementById('prevStep').addEventListener('click', function () {
        // Xóa trạng thái khi quay lại section 1
        localStorage.removeItem("activeSection");

        // Hiển thị section 1, ẩn section 2
        document.getElementById('infoSection').style.display = 'block';
        document.getElementById('imageSection').style.display = 'none';
    });

    // THÊM MỚI: Xử lý khi submit form thêm sản phẩm
    document.addEventListener("DOMContentLoaded", function () {
        // Tìm form thêm sản phẩm
        const productForm = document.querySelector("form");

        if (productForm) {
            productForm.addEventListener("submit", function (event) {
                // Không ngăn form submit mặc định vì chúng ta vẫn muốn nó được xử lý

                // Reset activeSection trong localStorage khi form được submit
                localStorage.removeItem("activeSection");
                clearSection1Data();

                // Có thể thêm code xử lý khác nếu cần
                console.log("Form submitted, activeSection has been reset");

                // Form tiếp tục submit bình thường
            });
        }

        // Nếu có thông báo thành công từ controller (có thể kiểm tra qua query string hoặc TempData)
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('success') || sessionStorage.getItem('productAddedSuccessfully')) {
            // Xóa thông báo thành công nếu dùng sessionStorage
            sessionStorage.removeItem('productAddedSuccessfully');

            // Đảm bảo xóa activeSection
            localStorage.removeItem("activeSection");

            // Hiển thị thông báo thành công nếu cần
            if (urlParams.has('success')) {
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công!',
                    text: 'Sản phẩm đã được thêm thành công.'
                });
            }
        }
    });

    // THÊM MỚI: Thêm listener cho nút submit
    document.addEventListener("DOMContentLoaded", function () {
        const submitButton = document.getElementById("submitButton");

        if (submitButton) {
            submitButton.addEventListener("click", function () {
                // Đảm bảo xóa trạng thái section và dữ liệu section 1 trước khi form submit
                localStorage.removeItem("activeSection");
                // Không xóa dữ liệu section 1 ở đây vì nếu validate fail, dữ liệu sẽ bị mất
                // Chỉ xóa dữ liệu sau khi submit thành công
            });
        }
    });
    // Mở modal thêm kích thước
    document.getElementById("addSizeButton").addEventListener("click", function () {
        new bootstrap.Modal(document.getElementById('addSizeModal')).show();
    });
    // Lưu size mới
    document.getElementById("saveNewSize").addEventListener("click", async function () {
        Swal.fire({
            title: 'Xác nhận lưu size',
            text: "Bạn có chắc chắn muốn lưu size này?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Có, lưu lại!',
            cancelButtonText: 'Không, hủy bỏ!'
        }).then((result) => {
            if (result.isConfirmed) {
                saveNewSize();
            }
        });
    });

    async function saveNewSize() {
        const SizeName = document.getElementById("newSizeName").value.trim();
        const sizeRegex = /^\d{1,2}(\.5)?$/; 

        if (!SizeName) {
            Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Vui lòng nhập tên size' });
            return;
        }

        if (!sizeRegex.test(SizeName)) {
        Swal.fire({
            icon: 'error',
            title: 'Lỗi',
            text: 'Size phải là số nguyên hoặc số thập phân .5 (VD: 40, 40.5, 41, 41.5)'
        });
        return;
    }

        try {
            saveSection1Data();
            localStorage.setItem("activeSection", "imageSection");

            const response = await fetch("/ProductDetail/CreateSizeDetail", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ SizeName: SizeName })
            });

            if (!response.ok) {
                const errorData = await response.json();
                const errorMessage = errorData.messages && errorData.messages.length > 0
                    ? errorData.messages[0].messageText
                    : "Thêm size thất bại, size đã tồn tại!";
                throw new Error(errorMessage);
            }

            const newSize = await response.json();
            const sizeGridContainer = document.getElementById("sizeGridContainer");
            const newSizeDiv = document.createElement("div");
            newSizeDiv.className = "col-md-4 col-6";
            newSizeDiv.innerHTML = `
                <div class="size-item border rounded p-2 d-flex align-items-center">
                    <div class="form-check me-2">
                        <input type="checkbox" class="form-check-input sizeCheckbox" id="size_${newSize.id}" data-size-id="${newSize.id}">
                        <label class="form-check-label fw-bold" for="size_${newSize.id}">${newSize.SizeName}</label>
                    </div>
                    <div class="input-group input-group-sm flex-grow-1">
                        <input type="number" class="form-control form-control-sm quantityInput" id="quantity_${newSize.id}" min="0" value="0" disabled>
                        <input type="hidden" class="sizeIdInput" value="${newSize.id}">
                    </div>
                </div>
            `;
            sizeGridContainer.insertBefore(newSizeDiv, sizeGridContainer.firstChild);

            const newCheckbox = newSizeDiv.querySelector(".sizeCheckbox");
            newCheckbox.addEventListener("change", function () {
                const sizeId = this.getAttribute("data-size-id");
                const quantityInput = document.getElementById(`quantity_${sizeId}`);
                if (this.checked) {
                    quantityInput.disabled = false;
                    quantityInput.value = 1;
                    quantityInput.focus();
                } else {
                    quantityInput.disabled = true;
                    quantityInput.value = 0;
                }
            });

            bootstrap.Modal.getInstance(document.getElementById('addSizeModal')).hide();
            document.getElementById("newSizeName").value = "";
            await Swal.fire({ icon: 'success', title: 'Thành công', text: 'Thêm size thành công!' });
            window.location.reload();
        } catch (error) {
            Swal.fire({ icon: 'error', title: 'Lỗi', text: error.message });
        }
    }

    // DOMContentLoaded event handler with default state
    document.addEventListener("DOMContentLoaded", function () {
        const infoSection = document.getElementById("infoSection");
        const imageSection = document.getElementById("imageSection");
        const section = localStorage.getItem("activeSection");

        // Kiểm tra URL hiện tại để xác định nếu đang ở trang thêm mới sản phẩm
        const currentUrl = window.location.pathname.toLowerCase();
        const isAddNewProductPage = currentUrl.includes("create") || currentUrl.includes("add");

        // Nếu là trang thêm mới sản phẩm và KHÔNG có thao tác thêm màu/size trước đó
        // thì luôn hiển thị section 1 (mặc định)
        if (isAddNewProductPage && !section) {
            // Xóa activeSection trong localStorage nếu có
            localStorage.removeItem("activeSection");

            // Hiển thị section 1, ẩn section 2
            if (infoSection && imageSection) {
                infoSection.style.display = "block";
                imageSection.style.display = "none";
            }
        }
        // Nếu có localStorage activeSection (do thêm màu/size) thì giữ đúng section đó
        else if (section === "imageSection") {
            // Hiển thị section 2, ẩn section 1
            if (infoSection && imageSection) {
                infoSection.style.display = "none";
                imageSection.style.display = "block";
            }
        }
        // Mặc định khác hoặc khi không có activeSection
        else {
            // Hiển thị section 1, ẩn section 2
            if (infoSection && imageSection) {
                infoSection.style.display = "block";
                imageSection.style.display = "none";
            }
        }
    });

    // Xử lý khi click nút next
    document.getElementById('nextStep').addEventListener('click', function () {
        // Lưu trạng thái khi chuyển sang section 2
        localStorage.setItem("activeSection", "imageSection");

        // Hiển thị section 2, ẩn section 1
        document.getElementById('infoSection').style.display = 'none';
        document.getElementById('imageSection').style.display = 'block';
    });

    // Xử lý khi click nút quay lại
    document.getElementById('prevStep').addEventListener('click', function () {
        // Xóa trạng thái khi quay lại section 1
        localStorage.removeItem("activeSection");

        // Hiển thị section 1, ẩn section 2
        document.getElementById('infoSection').style.display = 'block';
        document.getElementById('imageSection').style.display = 'none';
    });

    // THÊM MỚI: Xử lý khi submit form thêm sản phẩm
    document.addEventListener("DOMContentLoaded", function () {
        // Tìm form thêm sản phẩm
        const productForm = document.querySelector("form");

        if (productForm) {
            productForm.addEventListener("submit", function (event) {
                // Không ngăn form submit mặc định vì chúng ta vẫn muốn nó được xử lý

                // Reset activeSection trong localStorage khi form được submit
                localStorage.removeItem("activeSection");

                // Có thể thêm code xử lý khác nếu cần
                console.log("Form submitted, activeSection has been reset");

                // Form tiếp tục submit bình thường
            });
        }

        // Nếu có thông báo thành công từ controller (có thể kiểm tra qua query string hoặc TempData)
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('success') || sessionStorage.getItem('productAddedSuccessfully')) {
            // Xóa thông báo thành công nếu dùng sessionStorage
            sessionStorage.removeItem('productAddedSuccessfully');

            // Đảm bảo xóa activeSection
            localStorage.removeItem("activeSection");

            // Hiển thị thông báo thành công nếu cần
            if (urlParams.has('success')) {
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công!',
                    text: 'Sản phẩm đã được thêm thành công.'
                });
            }
        }
    });

    // THÊM MỚI: Thêm listener cho nút submit
    document.addEventListener("DOMContentLoaded", function () {
        const submitButton = document.getElementById("submitButton");

        if (submitButton) {
            submitButton.addEventListener("click", function () {
                // Đảm bảo xóa trạng thái section trước khi form submit
                localStorage.removeItem("activeSection");
            });
        }
    });

    document.getElementById("addColorButton").addEventListener("click", function() {
        new bootstrap.Modal(document.getElementById('addColorModal')).show();
    });

    document.getElementById('nextStep').addEventListener('click', function () {
        // Save state when moving to section 2
        localStorage.setItem("activeSection", "imageSection");

        // Switch sections
        document.getElementById('infoSection').style.display = 'none';
        document.getElementById('imageSection').style.display = 'block';
    });
    document.addEventListener("DOMContentLoaded", function () {
        // Format hiển thị giá khi nhập
        const priceInput = document.getElementById('priceInput');
        const priceFormatted = document.getElementById('priceFormatted');

        priceInput.addEventListener('input', function () {
            // Hiển thị giá đã định dạng bên dưới ô input
            if (this.value) {
                priceFormatted.textContent = parseInt(this.value).toLocaleString('vi-VN') + ' ₫';
            } else {
                priceFormatted.textContent = '0 ₫';
            }
        });

        // Xử lý size checkbox và quantity input
        const sizeCheckboxes = document.querySelectorAll('.sizeCheckbox');
        sizeCheckboxes.forEach(checkbox => {
            checkbox.addEventListener('change', function () {
                const sizeItem = this.closest('.size-item');
                const quantityInput = sizeItem.querySelector('.quantityInput');

                if (this.checked) {
                    sizeItem.style.backgroundColor = '#e6f2ff';
                    sizeItem.style.borderColor = '#0d6efd';
                    quantityInput.disabled = false;
                    quantityInput.value = 1; // Giá trị mặc định khi chọn
                    quantityInput.focus();
                } else {
                    sizeItem.style.backgroundColor = '#f8f9fa';
                    sizeItem.style.borderColor = '#dee2e6';
                    quantityInput.disabled = true;
                    quantityInput.value = 0;
                }
            });
        });

        // Toggle bảng size
        document.getElementById("toggleSizeTable").addEventListener("click", function () {
            const tableContainer = document.getElementById("sizeTableContainer");
            const toggleIcon = document.getElementById("toggleIcon");

            if (tableContainer.style.display === "none") {
                tableContainer.style.display = "block";
                toggleIcon.className = "bi bi-chevron-up";
            } else {
                tableContainer.style.display = "none";
                toggleIcon.className = "bi bi-chevron-down";
            }
        });

        // Validate form section trước khi chuyển đổi
        function validateInfoSection() {
            // Lấy các trường bắt buộc trong màn hình đầu tiên
            const codeInput = document.getElementById('productCode');
            const nameInput = document.querySelector('input[name="Name"]');
            const priceInput = document.getElementById('priceInput');
            const categorySelect = document.querySelector('select[name="CategoryId"]');
            const descriptionTextarea = document.querySelector('textarea[name="Description"]');

            // Kiểm tra từng trường
            let isValid = true;
            let errorMessage = "Vui lòng điền đầy đủ thông tin sau:\n";

            if (!codeInput.value || !codeInput.checkValidity()) {
                isValid = false;
                errorMessage += "- Mã sản phẩm (đúng định dạng SP + 5 chữ số)\n";
                codeInput.classList.add('is-invalid');
            } else {
                codeInput.classList.remove('is-invalid');
            }

            if (!nameInput.value) {
                isValid = false;
                errorMessage += "- Tên sản phẩm\n";
                nameInput.classList.add('is-invalid');
            } else {
                nameInput.classList.remove('is-invalid');
            }

            if (!priceInput.value || parseInt(priceInput.value) < 0) {
                isValid = false;
                errorMessage += "- Giá sản phẩm (phải là số không âm)\n";
                priceInput.classList.add('is-invalid');
            } else {
                priceInput.classList.remove('is-invalid');
            }

            if (!categorySelect.value) {
                isValid = false;
                errorMessage += "- Danh mục\n";
                categorySelect.classList.add('is-invalid');
            } else {
                categorySelect.classList.remove('is-invalid');
            }

            if (!descriptionTextarea.value) {
                isValid = false;
                errorMessage += "- Mô tả sản phẩm";
                descriptionTextarea.classList.add('is-invalid');
            } else {
                descriptionTextarea.classList.remove('is-invalid');
            }

            return { isValid, errorMessage };
        }

        // Chuyển đổi giữa các bước với validation
        document.getElementById("nextStep").addEventListener("click", function () {
            const validation = validateInfoSection();

            if (validation.isValid) {
                document.getElementById("infoSection").style.display = "none";
                document.getElementById("imageSection").style.display = "block";
            } else {
                alert(validation.errorMessage);
                // Hiện lại section 1 để người dùng sửa lỗi
                document.getElementById("infoSection").style.display = "block";
                document.getElementById("imageSection").style.display = "none";
            }
        });

        document.getElementById("prevStep").addEventListener("click", function () {
            document.getElementById("imageSection").style.display = "none";
            document.getElementById("infoSection").style.display = "block";
        });

        // Xử lý form submit với kiểm tra cả 2 màn hình
        var form = document.getElementById("createProductForm");
        form.addEventListener("submit", function (event) {
            event.preventDefault();

            // Kiểm tra section 1 trước
            const infoValidation = validateInfoSection();
            if (!infoValidation.isValid) {
                // Chuyển về màn hình 1 và hiển thị lỗi
                document.getElementById("imageSection").style.display = "none";
                document.getElementById("infoSection").style.display = "block";
                alert("Vui lòng sửa các lỗi ở thông tin sản phẩm:\n" + infoValidation.errorMessage);
                return;
            }

            // Kiểm tra section 2 (file ảnh và màu sắc)
            const fileInput = document.getElementById('fileInput');
            const colorSelect = document.getElementById('categorySelect');

            if (!fileInput.files || fileInput.files.length === 0) {
                fileInput.classList.add('is-invalid');
                alert("Vui lòng chọn ảnh sản phẩm");
                return;
            }

            if (!colorSelect.value) {
                colorSelect.classList.add('is-invalid');
                alert("Vui lòng chọn màu sắc");
                return;
            }

            // Kiểm tra có size nào được chọn không
            const sizesChecked = document.querySelectorAll('.sizeCheckbox:checked');
            if (sizesChecked.length === 0) {
                alert("Vui lòng chọn ít nhất một size");
                return;
            }

            //Nếu tất cả hợp lệ, kiểm tra mã sản phẩm
            checkCodeAvailability(document.getElementById('productCode').value).then(isAvailable => {
                if (!isAvailable) {
                    document.getElementById("imageSection").style.display = "none";
                    document.getElementById("infoSection").style.display = "block";
                    document.getElementById("codeValidationMessage").textContent = "Mã sản phẩm này đã tồn tại!";
                    return;
                }

                if (confirm("Bạn có chắc muốn thêm sản phẩm này không?")) {
                    // Xử lý giá trước khi submit
                    const priceRaw = priceInput.value.replace(/\./g, '');
                    const hiddenPrice = document.createElement('input');
                    hiddenPrice.type = 'hidden';
                    hiddenPrice.name = 'Price';
                    hiddenPrice.value = priceRaw;
                    this.appendChild(hiddenPrice);

                    // XỬ LÝ SIZE: Tạo các input động cho các size được chọn
                    // Xóa bỏ các input SizesQuantities cũ nếu có
                    document.querySelectorAll('input[name^="SizesQuantities"]').forEach(input => {
                        input.remove();
                    });

                    // Thêm mới chỉ những size được chọn với index liên tiếp
                    let index = 0;
                    let checkedSizes = document.querySelectorAll('.sizeCheckbox:checked');

                    checkedSizes.forEach(checkbox => {
                        let sizeId = checkbox.dataset.sizeId;
                        let quantity = document.getElementById('quantity_' + sizeId).value;

                        // Tạo input cho IdSize
                        let sizeIdInput = document.createElement('input');
                        sizeIdInput.type = 'hidden';
                        sizeIdInput.name = `SizesQuantities[${index}].IdSize`;
                        sizeIdInput.value = sizeId;

                        // Tạo input cho QuantitySize
                        let quantityInput = document.createElement('input');
                        quantityInput.type = 'hidden';
                        quantityInput.name = `SizesQuantities[${index}].QuantitySize`;
                        quantityInput.value = quantity;

                        // Thêm vào form
                        this.appendChild(sizeIdInput);
                        this.appendChild(quantityInput);

                        index++;
                    });

                    this.submit();
                }
            });
        });

        // Xử lý mã sản phẩm
        var codeInput = document.getElementById("productCode");
        var codeValidationMessage = document.getElementById("codeValidationMessage");

        function generateProductCode() {
            var randomNumber = Math.floor(Math.random() * 100000);
            var formattedNumber = String(randomNumber).padStart(5, '0');
            return "SP" + formattedNumber;
        }

        function checkCodeAvailability(code) {
            return new Promise((resolve) => {
                $.ajax({
                    url: '/Product/CheckProductCode',
                    type: 'POST',
                    data: { code: code },
                    success: function (response) {
                        resolve(response.isAvailable);
                    },
                    error: function () {
                        alert("Lỗi khi kiểm tra mã sản phẩm. Vui lòng thử lại.");
                        resolve(false);
                    }
                });
            });
        }

        async function setUniqueProductCode() {
            if (!codeInput.value) {
                let newCode;
                let isUnique = false;
                do {
                    newCode = generateProductCode();
                    isUnique = await checkCodeAvailability(newCode);
                } while (!isUnique);
                codeInput.value = newCode;
            }
        }

        setUniqueProductCode();

        // Xử lý thêm màu sắc
        $('#categorySelect').on('change', function () {
            if ($(this).val() === 'add_new') {
                $('#addColorModal').modal('show');
                $(this).val(''); // Reset selection
            }
        });

        // Xử lý upload ảnh
        (function ($) {
            $('#fileInput').on("change", function (e) {
                let file = e.target.files[0];
                if (file) {
                    let reader = new FileReader();
                    reader.onload = function (event) {
                        $("#imagePreview").attr("src", event.target.result).show();
                    };
                    reader.readAsDataURL(file);

                    let form = new FormData();
                    form.append("api_key", "284335524597493");
                    form.append("upload_preset", "vanh2204");
                    form.append("public_id", new Date().toISOString().replace(/[-:.]/g, ""));
                    form.append("file", file);

                    var settings = {
                        "async": true,
                        "crossDomain": true,
                        "url": "https://api.cloudinary.com/v1_1/dnvuz3evz/image/upload",
                        "method": "POST",
                        "processData": false,
                        "contentType": false,
                        "mimeType": "multipart/form-data",
                        "data": form
                    };

                    $.ajax(settings).done(function (response) {
                        let data = JSON.parse(response);
                        console.log(data);
                        if (data) {
                            let url = data.secure_url ?? data.url;
                            if (url) {
                                $("#imagePreview").attr("src", url);
                                $('#urlImage').val(url);
                            } else {
                                alert("Không thể tải ảnh lên. Vui lòng thử lại.");
                            }
                        }
                    });
                }
            });
        })(jQuery);
    });
</script>