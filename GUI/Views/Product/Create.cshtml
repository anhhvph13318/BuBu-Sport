@model GUI.Models.DTOs.Product_DTO.CreateProductRequest

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="container mt-5">
    <form asp-action="Create" enctype="multipart/form-data" class="bg-light p-4 rounded shadow-sm" id="createProductForm" novalidate>
        <h2 class="text-center mb-4">Thêm sản phẩm mới</h2>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <!-- Cột trái: Form nhập liệu -->
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="Code" class="form-label">Mã sản phẩm</label>
                    <input asp-for="Code" class="form-control" id="productCode" placeholder="Nhập mã sản phẩm" required maxlength="7" pattern="SP\d{5}" title="Mã sản phẩm phải là 'SP' theo sau bởi đúng 5 chữ số (ví dụ: SP00001)" />
                    <span asp-validation-for="Code" class="text-danger" id="codeValidationMessage"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Name" class="form-label">Tên sản phẩm</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm" required maxlength="100" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Price" class="form-label">Giá sản phẩm</label>
                    <input asp-for="Price" class="form-control" id="priceInput" placeholder="Nhập giá sản phẩm" type="number" required min="0" step="1000" title="Giá phải là số không âm, tối thiểu 0" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Description" class="form-label">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" placeholder="Nhập mô tả" rows="3" required maxlength="500" title="Mô tả không được để trống và tối đa 500 ký tự"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="CategoryId" class="form-label">Danh mục</label>
                    <select asp-for="CategoryId" class="form-select" required>
                        <option value="" disabled selected>Chọn danh mục</option>
                        @foreach (var item in ViewBag.Categories)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
            </div>

            <!-- Cột phải: Ảnh sản phẩm -->
            <div class="col-md-6 d-flex justify-content-center align-items-center">
                <div>
                    <div class="form-group">
                        <label asp-for="UrlImage" class="form-label">Ảnh sản phẩm</label>
                        <input type="file" id="fileInput" class="form-control" accept="image/*" required title="Vui lòng chọn một ảnh sản phẩm" />
                        <img id="imagePreview" src="/path/to/default-image.jpg" alt="Image preview" style="display: block; width: 250px; height: 250px; object-fit: cover;" class="mt-3 img-thumbnail" />
                        <input type="hidden" asp-for="UrlImage" id="urlImage" />
                        <span asp-validation-for="UrlImage" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Nút điều khiển -->
        <div class="form-group d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-secondary">Quay trở lại</a>
            <button type="submit" class="btn btn-primary" id="submitButton">Thêm mới</button>
        </div>
    </form>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var codeInput = document.getElementById("productCode");
        var codeValidationMessage = document.getElementById("codeValidationMessage");

       
        function generateProductCode() {
            var randomNumber = Math.floor(Math.random() * 100000); 
            var formattedNumber = String(randomNumber).padStart(5, '0'); 
            return "SP" + formattedNumber;
        }


        function checkCodeAvailability(code) {
            return new Promise((resolve) => {
                $.ajax({
                    url: '/Product/CheckProductCode', 
                    type: 'POST',
                    data: { code: code },
                    success: function (response) {
                        resolve(response.isAvailable); 
                    },
                    error: function () {
                        alert("Lỗi khi kiểm tra mã sản phẩm. Vui lòng thử lại.");
                        resolve(false); 
                    }
                });
            });
        }

        async function setUniqueProductCode() {
            if (!codeInput.value) {
                let newCode;
                let isUnique = false;
                do {
                    newCode = generateProductCode();
                    isUnique = await checkCodeAvailability(newCode);
                } while (!isUnique);
                codeInput.value = newCode;
            }
        }

        setUniqueProductCode();

        var form = document.getElementById("createProductForm");
        form.addEventListener("submit", function (event) {
            event.preventDefault(); 

           
            if (form.checkValidity()) {
                
                checkCodeAvailability(codeInput.value).then(isAvailable => {
                    if (!isAvailable) {
                        codeValidationMessage.textContent = "Mã sản phẩm này đã tồn tại!";
                        return;
                    }
                    if (confirm("Bạn có chắc muốn thêm sản phẩm này không?")) {
                        this.submit(); 
                    }
                });
            } else {

                form.reportValidity();
            }
        });
    });

    (function ($) {
        $('#fileInput').on("change", function (e) {
            let file = e.target.files[0];
            if (file) {
                let reader = new FileReader();
                reader.onload = function (event) {
                    $("#imagePreview").attr("src", event.target.result).show();
                };
                reader.readAsDataURL(file);

                let form = new FormData();
                form.append("api_key", "284335524597493");
                form.append("upload_preset", "vanh2204");
                form.append("public_id", new Date().toISOString().replace(/[-:.]/g, ""));
                form.append("file", file);

                var settings = {
                    "async": true,
                    "crossDomain": true,
                    "url": "https://api.cloudinary.com/v1_1/dnvuz3evz/image/upload",
                    "method": "POST",
                    "processData": false,
                    "contentType": false,
                    "mimeType": "multipart/form-data",
                    "data": form
                };

                $.ajax(settings).done(function (response) {
                    let data = JSON.parse(response);
                    console.log(data);
                    if (data) {
                        let url = data.secure_url ?? data.url;
                        if (url) {
                            $("#imagePreview").attr("src", url);
                            $('#urlImage').val(url);
                        } else {
                            alert("Không thể tải ảnh lên. Vui lòng thử lại.");
                        }
                    }
                });
            }
        });
    })(jQuery);
</script>