@using System.Globalization
@using GUI.Models.DTOs.Order_DTO
@model GUI.Models.DTOs.Order_DTO.OrderDetail

@{
    Layout = "_Layout";
    int productOrder = 1;
    decimal totalAmount = 0;
}


@if (string.IsNullOrEmpty(Model.Customer.Name))
{
    <p class="text-danger text-center">Lỗi không tìm thấy</p>
}
else
{
    <div class="container">
        <h2>Chi tiết hoá đơn - @Model.Code</h2>
        <hr />
        <div class="mb-3 mt-3">
            <h5>Trạng thái đơn hàng</h5>
            @{
                var currentIndex = OrderUtil.OrderStepProcessing.Keys.ToList().IndexOf(Model.Status);
                var keys = OrderUtil.OrderStepProcessing.Keys.ToList();
                var i = 0;
                var canceledKey = 3; 
                var isCanceled = Model.Status == canceledKey;
            }
            <div class="d-flex flex-wrap justify-content-between gap-2 border m-0 p-3" id="status-options" style="flex-wrap: wrap;">
                @foreach (var item in OrderUtil.OrderStepProcessing)
                {
                    var isCurrent = Model.Status == item.Key;
                    var disabled = !(isCurrent || i == currentIndex + 1);

                    if (item.Key == canceledKey && !isCanceled)
                    {
                        disabled = true;
                    }

                    <div class="form-check flex-fill text-center" style="min-width: 16%;">
                        <input class="form-check-input d-none order-status-radio"
                               type="radio"
                               name="orderStatus"
                               value="@item.Key"
                               id="status_@item.Key"
                        @(isCurrent ? "checked" : "")
                        @(disabled ? "disabled" : "") />

                        <label for="status_@item.Key"
                               class="custom-check-label @(isCurrent ? "active" : "") @(disabled ? "disabled" : "")"
                               style="cursor: pointer; display: inline-flex; align-items: center; gap: 8px; opacity: @(disabled ? "0.5" : "1")">
                            <span class="check-icon">@(isCurrent ? "✔️" : "⬜")</span>
                            @item.Value
                        </label>
                    </div>
                    i++;
                }
            </div>

            @if (Model.Status != 7)
            {
                <button type="button" class="btn btn-primary mt-3" onclick="confirmUpdateOrderStatus()">Lưu</button>
            }

            @if (!string.IsNullOrEmpty(Model.ReasionCancel))
            {
                <div class="alert alert-danger mb-3 mt-3">
                    <strong>Lý do hủy đơn hàng:</strong> @Model.ReasionCancel
                </div>
            }
        </div>
        <div style="font-weight: bold; color: #2c3e50; font-size: 16px;">
            <h5>Ngày tạo hóa đơn : @Model.Created.ToString("dd/MM/yyyy HH:mm")</h5>
        </div>

        <div class="row mb-3">
            <h5>Thông tin khách hàng</h5>
            <div class="row">
                <div class="mb-3 col-4">
                    <label>Họ và tên</label>
                    <input disabled class="form-control" value="@Model.Customer.Name" />
                </div>
                <div class="mb-3 col-4">
                    <label>Số điện thoại</label>
                    <input disabled class="form-control" value="@Model.Customer.PhoneNumber" />
                </div>
                <div class="mb-3 col-4">
                    <label>Địa chỉ</label>
                    <input disabled class="form-control" value="@Model.Customer.Address" />
                </div>
                <div class="mb-3 col-4">
                    <label>Email</label>
                    <input disabled class="form-control" value="@Model.Customer.Email" />
                </div>
            </div>
        </div>
        <div class="row mb-3 m-0">
            <h5>Thông tin giao hàng</h5>
            <div class="border row">
                @if (Model.IsCustomerTakeYourSelf)
                {
                    <p class="mb-1 p-1">Khách hàng nhận tại quầy</p>
                }
                else
                {
                    if (Model.IsSameAsCustomerAddress)
                    {
                        <p class="mb-1 p-1">Giống với thông tin khách hàng</p>
                    }
                    else
                    {
                        <div class="mb-3 col-4">
                            <label>Họ và tên</label>
                            <input disabled class="form-control" value="@Model.ShippingInfo.Name" />
                        </div>
                        <div class="mb-3 col-4">
                            <label>Số điện thoại</label>
                            <input disabled class="form-control" value="@Model.ShippingInfo.PhoneNumber" />
                        </div>
                        <div class="mb-3 col-4">
                            <label>Địa chỉ</label>
                            <input disabled class="form-control" value="@Model.ShippingInfo.Address" />
                        </div>
                    }
                }
            </div>
        </div>
        <div class="row">
            <h5>Danh sách sản phẩm</h5>
            <hr />
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Mã sản phẩm</th>
                        <th>Tên sản phẩm</th>
                        <th>Màu sắc</th>
                        <th>Kích thước</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var itemTotal = item.Price * item.Quantity;
                        totalAmount += itemTotal;
                        <tr>
                            <td>@(productOrder++)</td>
                            <td>@item.Code</td>
                            <td>@item.ProductName</td>
                            <td>@item.Color</td>
                            <td>@item.Size</td>
                            <td>@item.Price.ToString("C", CultureInfo.GetCultureInfo("vi-VN"))</td>
                            <td>@item.Quantity</td>
                            <td>@itemTotal.ToString("C", CultureInfo.GetCultureInfo("vi-VN"))</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="7" class="text-end"><strong>Tổng tiền:</strong></td>
                        <td><strong>@totalAmount.ToString("C", CultureInfo.GetCultureInfo("vi-VN"))</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="row mb-3">
            <h5>Thông tin thanh toán</h5>
            <table class="table table-bordered">
                <tbody>
                    <tr>
                        <td>Hình thức thanh toán</td>
                        <td colspan="3" class="pe-2 text-end">@Model.PaymentMethodName</td>
                    </tr>
                    <tr>
                        <td>Tạm tính</td>
                        <td colspan="3" class="pe-2 text-end">@Model.PaymentInfo.TotalAmount.ToString("C", CultureInfo.GetCultureInfo("vi-VN"))</td>
                    </tr>
                    <tr>
                        @*                         <td>Phí giao hàng</td>
                        <td colspan="3" class="pe-2 text-end">@Model.PaymentInfo.ShippingFee.ToString("C", CultureInfo.GetCultureInfo("vi-VN"))</td> *@
                    </tr>
                    <tr>
                        <td>Voucher giảm</td>
                        <td colspan="3" class="pe-2 text-end text-danger">-@Model.PaymentInfo.TotalDiscount.ToString("C", CultureInfo.GetCultureInfo("vi-VN"))</td>
                    </tr>
                    <tr>
                        <td style="text-decoration: underline;">Thành tiền</td>
                        <td colspan="3" style="color: red; font-weight: bold;" class="pe-2 text-end">
                            @((Model.PaymentInfo.TotalAmount - Model.PaymentInfo.TotalDiscount).ToString("C", CultureInfo.GetCultureInfo("vi-VN")))
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="mb-3 mt-3">
            <a class="btn btn-primary" asp-controller="Order" asp-action="Index">Trở về</a>
            @if (Model.Status == 7)
            {
                <a class="btn btn-success" asp-controller="Order" asp-action="ExportInvoicePdf" asp-route-id="@Model.Id"><i class="bi bi-cloud-download-fill"></i> Tải PDF</a>
            }
        </div>
    </div>
}
<style>
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255, 255, 255, 0.8);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        visibility: hidden;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

        .loading-overlay.active {
            visibility: visible;
            opacity: 1;
        }

    .loading-container {
        background-color: white;
        border-radius: 8px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        padding: 25px 40px;
        text-align: center;
        transform: translateY(10px);
        transition: transform 0.3s ease;
        max-width: 90%;
    }

    .loading-overlay.active .loading-container {
        transform: translateY(0);
    }

    .loading-spinner {
        display: inline-block;
        position: relative;
        width: 60px;
        height: 60px;
        margin-bottom: 15px;
    }

        .loading-spinner div {
            position: absolute;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: #3498db;
            animation: loading-spinner 1.2s linear infinite;
        }

            .loading-spinner div:nth-child(1) {
                top: 6px;
                left: 6px;
                animation-delay: 0s;
            }

            .loading-spinner div:nth-child(2) {
                top: 6px;
                left: 26px;
                animation-delay: -0.4s;
            }

            .loading-spinner div:nth-child(3) {
                top: 6px;
                left: 45px;
                animation-delay: -0.8s;
            }

            .loading-spinner div:nth-child(4) {
                top: 26px;
                left: 6px;
                animation-delay: -0.4s;
            }

            .loading-spinner div:nth-child(5) {
                top: 26px;
                left: 26px;
                animation-delay: -0.8s;
            }

            .loading-spinner div:nth-child(6) {
                top: 26px;
                left: 45px;
                animation-delay: -1.2s;
            }

            .loading-spinner div:nth-child(7) {
                top: 45px;
                left: 6px;
                animation-delay: -0.8s;
            }

            .loading-spinner div:nth-child(8) {
                top: 45px;
                left: 26px;
                animation-delay: -1.2s;
            }

            .loading-spinner div:nth-child(9) {
                top: 45px;
                left: 45px;
                animation-delay: -1.6s;
            }

    @@keyframes loading-spinner {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.3;
        }
    }

    .loading-text {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
        font-size: 16px;
        font-weight: 500;
        margin: 0;
    }

    .custom-check-label.disabled {
        pointer-events: none;
    }

    .custom-check-label.active .check-icon {
        content: "✔️";
    }

    .custom-check-label .check-icon {
        font-size: 1.2rem;
    }
</style>

<!-- HTML cho loading overlay hiện đại -->
<div class="loading-overlay" id="loadingOverlay">
    <div class="loading-container">
        <div class="loading-spinner">
            <div></div><div></div><div></div>
            <div></div><div></div><div></div>
            <div></div><div></div><div></div>
        </div>
        <p class="loading-text">Đang cập nhật trạng thái...</p>
    </div>
</div>

<script>
    const currentStatusLabel = @Html.Raw(Json.Serialize(Model.Status switch
        {
            0 => "chờ xác nhận",
            1 => "chuẩn bị hàng",
            2 => "đang vận chuyển",
            4 => "xác nhận",
            7 => "hoàn thành",
            _ => "không xác định"
        }));

    function confirmUpdateOrderStatus() {
        const selectedRadio = document.querySelector('input[name="orderStatus"]:checked');
        const selectedLabel = selectedRadio.nextElementSibling.textContent.trim();

        Swal.fire({
            title: 'Xác nhận cập nhật trạng thái',
            text: `Bạn có chắc chắn muốn cập nhật từ trạng thái "${currentStatusLabel}" sang trạng thái "${selectedLabel}" không?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Có, lưu lại!',
            cancelButtonText: 'Không, hủy bỏ!'
        }).then((result) => {
            if (result.isConfirmed) {
                saveOrderStatus();
            }
        });
    }

    async function saveOrderStatus() {
        const selectedRadio = document.querySelector('input[name="orderStatus"]:checked');
        if (!selectedRadio) {
            alert("Vui lòng chọn trạng thái đơn hàng.");
            return;
        }

        document.getElementById('loadingOverlay').classList.add('active');

        const status = parseInt(selectedRadio.value);
        const requestData = {
            id: "@Model.Id",
            status: status,
            email: "@Model.Customer.Email",
            name: "@Html.Raw(Model.Customer.Name)",
            code: "@Model.Code",
            phone: "@Model.Customer.PhoneNumber",
            products: @Html.Raw(Json.Serialize(Model.Items))
        };

        try {
            const response = await fetch("/Login/UpdateStatusONOrder", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(requestData)
            });

            if (!response.ok) {
                if (response.status === 500) {
                    document.getElementById('loadingOverlay').classList.remove('active');
                    alert("Cập nhật trạng thái đơn hàng thành công! Email thông báo không được gửi do định dạng email không hợp lệ.");
                    location.reload();
                    return;
                }
            }
            const result = await response.json();
            document.getElementById('loadingOverlay').classList.remove('active');
            if (result.success) {
                Swal.fire({
                    icon: "success",
                    title: "Thành công!",
                    text: result.message || "Cập nhật trạng thái thành công!",
                    confirmButtonText: "OK"
                }).then(() => {
                    location.reload();
                });
            } else {
                alert(result.message || "Có lỗi khi cập nhật");
            }
        } catch (err) {
            console.error("Lỗi:", err);
            document.getElementById('loadingOverlay').classList.remove('active');
            Swal.fire({
                icon: "success",
                title: "Thành công!",
                text: "Cập nhật trạng thái thành công!",
                confirmButtonText: "OK"
            }).then(() => {
                location.reload();
            });
        }
    }


</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const radios = document.querySelectorAll("input[name='orderStatus']");
        const labels = document.querySelectorAll(".custom-check-label");

        radios.forEach(radio => {
            radio.addEventListener("change", function () {
                labels.forEach(label => {
                    label.classList.remove("active");
                    label.querySelector(".check-icon").textContent = "⬜";
                });

                const selectedLabel = document.querySelector(`label[for='${radio.id}']`);
                selectedLabel.classList.add("active");
                selectedLabel.querySelector(".check-icon").textContent = "✔️";
            });
        });
    });
</script>


@section Scripts {
    <script defer>
        const confirmOrder = () => {
            fetch(ORDER_CONFIRM_API('@Model.Id'), {
                method: 'POST'
            }).then(res => {
                if (res.status == 204) {
                    alert("Xác nhận thành công");
                    window.location.href = "/orders";
                }
            });
        }
    </script>
}