@using System.Globalization
@using GUI.Models.DTOs.Order_DTO

@{
    Layout = "_Layout";
    var orders = ViewData["Orders"] as List<OrderDetail>;
}

<style>
    .table-fixed thead > tr,
    .table-fixed tbody > tr {
        display: flex;
        justify-content: space-around;
        flex: 0 0 auto;
    }

        .table-fixed thead > tr th,
        .table-fixed tbody > tr th,
        .table-fixed thead > tr td,
        .table-fixed tbody > tr td {
            flex: 1;
        }

    .table-fixed tbody {
        overflow-y: scroll;
        display: flex;
        flex-direction: column;
    }

    .table-lock-height > tbody {
        height: 200px;
    }

    .loading-overlay {
        display: none; 
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5); 
        z-index: 9999; 
        justify-content: center;
        align-items: center;
        flex-direction: column;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 5px solid #f3f3f3; 
        border-top: 5px solid #3498db; 
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0%

    {
        transform: rotate(0deg);
    }

    100% {
        transform: rotate(360deg);
    }

    }

    .loading-overlay p {
        color: white;
        font-size: 18px;
        margin-top: 10px;
    }
</style>
<link href="~/lib/toastr/toastr.css" rel="stylesheet" />

<div class="container-fluid" id="order-container">
    <div class="row">
        <div class="col-md-8 p-3">
            <div class="mb-2 p-3 border">
                <div class="accordion" id="accordionPanelsStayOpenExample">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="true"
                                    aria-controls="panelsStayOpen-collapseOne">
                                Danh sách hoá đơn tại quầy
                            </button>
                        </h2>
                        <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show">
                            <div class="accordion-body" id="orderTempSaveContainer">
                                @if (orders != null)
                                {
                                    var inStoreOrders = orders.Where(order => order.OrderTypeName == "Tại quầy" || order.OrderTypeName == "Nháp").ToList();
                                    @await Html.PartialAsync("_OrderListPartialView", inStoreOrders)
                                }
                                else
                                {
                                    <p class="text-center">Không có đơn hàng</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="border p-3 h-75">
                <form autocomplete="off" class="w-100" onsubmit="return false">
                    <div class="mb-3 autocomplete w-100">
                        <input placeholder="Tên, mã sản phẩm..." id="search" class="form-control">
                        <div class="autocomplete-items" id="autocomplete-list"></div>
                    </div>
                </form>
                <div class="d-flex justify-content-end">
                    <button id="btnShowProductList" class="btn btn-primary me-2">Danh sách sản phẩm</button>
                    <div id="tempSaveButtonContainer" class="me-2">
                        @await Html.PartialAsync("_TempSaveOrderButtonPartialView")
                    </div>
                    <button id="btnReset" class="btn btn-danger text-nowrap me-2" onclick="clearOrder()" type="button">Làm mới giỏ hàng</button>
                </div>
                <hr />
                <div id="orderItemContainer">
                    @await Html.PartialAsync("_OrderItemListPartialView", Array.Empty<OrderItem>())
                </div>
            </div>
        </div>

        <div class="col-md-4 p-3">
            <div class="p-3 border mb-3">
                <h5>Thông tin khách hàng</h5>
                <hr />
                <div id="customerInfoContainer">
                    @await Html.PartialAsync("_OrderCustomerInfoPartialView", new CustomerInfo())
                </div>
            </div>

            <div class="p-3 border mb-3">
                <h5>Thông tin giao hàng</h5>
                <hr />
                <div id="shippingInfoContainer">
                    @await Html.PartialAsync("_OrderShippingInfoPartialView", new ShippingInfo())
                </div>
            </div>

            <div id="checkout-area-2" class="p-3 border">
                <h5>Thông tin hoá đơn</h5>
                <hr />
                <div id="orderPaymentInfoContainer">
                    @await Html.PartialAsync("_OrderPaymentInfoPartialView", new PaymentInfo())
                </div>
                <hr />
                <div class="row" id="orderButtonActionContainer">
                    @await Html.PartialAsync("_OrderButtonActionPartialView", 0)
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="voucherModal" tabindex="-1" aria-labelledby="voucherModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="voucherModalLabel">Danh sách voucher khả dụng</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="voucher-list" style="max-height: 300px; overflow-y: auto">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<div id="productListModal" class="modal fade" tabindex="-1" aria-labelledby="productListModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="productListModalLabel">Danh sách sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" id="productListSearchInput" class="form-control" placeholder="Tìm theo mã hoặc tên sản phẩm...">
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Mã sản phẩm</th>
                            <th>Tên sản phẩm</th>
                            <th>Ảnh sản phẩm</th>
                            <th>Giá</th>
                            <th>Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody id="productListBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="variantSelectionModal" class="modal fade" tabindex="-1" aria-labelledby="variantSelectionModalLabel">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="variantSelectionModalLabel">Chọn biến thể cho sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Màu sắc</th>
                            <th>Kích cỡ</th>
                            <th>Số lượng</th>
                            <th>Chọn</th>
                        </tr>
                    </thead>
                    <tbody id="variantOptions"></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="btnConfirmVariant">Xác nhận chọn biến thể</button>
            </div>
        </div>
    </div>
</div>
<div id="loading-overlay" class="loading-overlay">
    <div class="spinner"></div>
    <p>Đang xử lý...</p>
</div>
@section scripts {
    <script src="~/lib/microsoft-signalr/signalr.min.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/js/product.js"></script>
    <script src="~/js/validation.js"></script>
    <script src="~/js/orderPage.js"></script>

    <script>
        function updateTableSTT(tableSelector) {
            $(`${tableSelector} tbody tr`).each(function (index) {
                $(this).find("td:first").text(index + 1);
            });
        }
    </script>

    <script>
        $(document).ready(function () {
            let fullProductList = [];

            $('#btnShowProductList').on('click', function () {
                fetch('/api/products')
                    .then(res => res.json())
                    .then(data => {
                        fullProductList = data;
                        renderProductList(data);
                        $('#productListModal').modal('show');
                    });
            });

            $('#productListModal').on('hidden.bs.modal', function () {
                $('#productListSearchInput').val('');
                renderProductList(fullProductList);
            });

            $('#productListSearchInput').on('input', function () {
                const keyword = $(this).val().toLowerCase();
                const filtered = fullProductList.filter(product =>
                    product.name.toLowerCase().includes(keyword) ||
                    product.code.toLowerCase().includes(keyword)
                );
                renderProductList(filtered);
            });

            function renderProductList(data) {
                const productListBody = $('#productListBody').empty();
                data.forEach((product, index) => {
                    if (!product.image?.trim()) return;
                    const row = `
                        <tr>
                            <td></td>
                            <td><span class="badge bg-secondary">${product.code}</span></td>
                            <td>${product.name}</td>
                            <td><img src="${product.image}" style="width: 50px; height: 50px;" /></td>
                            <td>${product.price} VNĐ</td>
                            <td><button class="btn btn-info btn-detail" data-id="${product.id}" data-name="${product.name}">Chi tiết</button></td>
                        </tr>`;
                    productListBody.append(row);
                });
                updateTableSTT('#productListModal table');
            }

            let currentProductName = '';

            $(document).on('click', '.btn-detail', function () {
                const productId = $(this).data('id');
                currentProductName = $(this).data('name') || '';
                fetch(`/api/products/${productId}/variants`)
                    .then(res => res.json())
                    .then(variants => {
                        const variantOptions = $('#variantOptions').empty();
                        variants.forEach(variant => {
                            const isDisabled = variant.quantity <= 0;
                            const row = `
                                <tr>
                                    <td></td>
                                    <td class="color-cell">${variant.color}</td>
                                    <td class="size-cell">${variant.size}</td>
                                    <td>
                                        <input type="number" class="form-control" min="1" max="${variant.quantity}" value="1"
                                            data-variant-id="${variant.id}" ${isDisabled ? 'disabled' : ''} />
                                    </td>
                                    <td>
                                        <input type="checkbox" class="form-check-input" data-variant-id="${variant.id}" ${isDisabled ? 'disabled' : ''} />
                                    </td>
                                </tr>`;
                            variantOptions.append(row);
                        });
                        updateTableSTT('#variantSelectionModal table');
                        $('#variantSelectionModal').modal('show');
                    });
            });

            $('#btnConfirmVariant').on('click', function () {
                let hasInvalidQuantity = false;

                $('#variantOptions input[type="checkbox"]:checked').each(function () {
                    const checkbox = $(this);
                    const row = checkbox.closest('tr');
                    const variantId = checkbox.data('variant-id');
                    const quantityInput = row.find('input[type="number"]');
                    const quantity = parseInt(quantityInput.val());
                    const max = parseInt(quantityInput.attr('max'));

                    if (isNaN(quantity) || quantity <= 0 || quantity > max) {
                        const color = row.find('.color-cell').text();
                        const size = row.find('.size-cell').text();
                        toastr.warning(`Sản phẩm "${currentProductName}" - Màu: ${color}, Size: ${size} có số lượng không hợp lệ hoặc vượt quá tồn kho!`);
                        hasInvalidQuantity = true;
                        return;
                    }

                    fetch(`/api/productdetails/${variantId}`)
                        .then(response => {
                            if (!response.ok) {
                                throw new Error(`Error: ${response.status} ${response.statusText}`);
                            }
                            return response.json();
                        })
                        .then(variantDetail => {
                            const orderItem = {
                                Id: variantDetail.id,
                                ProductCode: variantDetail.productCode,
                                ProductName: variantDetail.name,
                                ProductImage: variantDetail.imageUrl,
                                Color: variantDetail.color,
                                Size: variantDetail.size,
                                Quantity: quantity,
                                Price: variantDetail.price
                            };

                            const existingRow = $(`#orderItemContainer tbody tr`).filter(function () {
                                return $(this).find('button.remove-item-btn').data('id') == orderItem.Id;
                            });

                            if (existingRow.length > 0) {
                                const qtyInput = existingRow.find('.order-item-quantity');
                                const currentQty = parseInt(qtyInput.val());
                                const newQty = currentQty + orderItem.Quantity;

                                if (newQty > max) {
                                    toastr.error(`Tổng số lượng cho "${orderItem.ProductName}" - Màu: ${orderItem.Color}, Size: ${orderItem.Size} vượt quá tồn kho.`);
                                    return;
                                }

                                qtyInput.val(newQty);
                                const totalCell = existingRow.find('td').eq(8);
                                const newTotal = newQty * orderItem.Price;
                                totalCell.text(newTotal.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' }));
                            } else {
                                const itemTotal = orderItem.Price * orderItem.Quantity;
                                const row = `
                                    <tr>
                                        <td></td>
                                        <td><span class="badge bg-secondary">${orderItem.ProductCode}</span></td>
                                        <td style="width: 15%">
                                           <img src="${orderItem.ProductImage}" class="img-thumbnail" style="width: 50%" />
                                        </td>
                                        <td>${orderItem.ProductName}</td>
                                        <td>${orderItem.Color}</td>
                                        <td>${orderItem.Size}</td>
                                        <td>${orderItem.Price.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' })}</td>
                                        <td>
                                            <input class="form-control order-item-quantity" min="1" value="${orderItem.Quantity}" type="number" disabled />
                                        </td>
                                        <td>${itemTotal.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' })}</td>
                                        <td style="display: none" class="order-item-id">${orderItem.Id}</td>
                                        <td>
                                            <button class="btn btn-danger remove-item-btn" data-id="${orderItem.Id}">Xoá</button>
                                        </td>
                                    </tr>
                                `;
                                $('#orderItemContainer tbody').append(row);
                                updatePaymentInfoSummary();
                            }

                            updateTableSTT('#orderItemContainer table');
                        })
                        .catch(error => {
                            console.error('Error fetching variant details:', error);
                        });
                });

                if (!hasInvalidQuantity) {
                    $('#variantSelectionModal').modal('hide');
                    $('#productListModal').modal('hide');
                }
            });

            $(document).on('click', '.remove-item-btn', function () {
                $(this).closest('tr').remove();
                updateTableSTT('#orderItemContainer table');
                updatePaymentInfoSummary();
            });
        });

        function updateTableSTT(tableSelector) {
            $(`${tableSelector} tbody tr`).each(function (index) {
                $(this).find("td:first").text(index + 1);
            });
        }

        function updatePaymentInfoSummary() {
            let totalAmount = 0;

            $('#orderItemContainer tbody tr').each(function () {
                const quantity = parseInt($(this).find('.order-item-quantity').val()) || 0;
                const priceText = $(this).find('td').eq(6).text();
                const price = parseFloat(priceText.replace(/[^\d]/g, '')) || 0;
                totalAmount += quantity * price;
            });

            const discountText = $('#discount-amount').text().replace(/[^\d]/g, '');
            const totalDiscount = parseFloat(discountText) || 0;
            const finalAmount = totalAmount - totalDiscount;

            $('#total-amount').text(totalAmount.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' }));
            $('#discount-amount').text('- ' + totalDiscount.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' }));
            $('#orderPaymentInfoContainer p:contains("Thành tiền:")').next().text(finalAmount.toLocaleString('vi-VN', { style: 'currency', currency: 'VND' }));
        }
    </script>

}
