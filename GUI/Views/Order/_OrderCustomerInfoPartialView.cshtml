@using GUI.Models.DTOs.Order_DTO
@model CustomerInfo

<div class="mb-2">
    <label>Tên <span class="text-danger">*</span></label>
    <input class="form-control" value="@Model.Name" id="customerName" type="text" />
    <p class="text-danger" style="display:none" id="order-customer-name"></p>
</div>
<div class="mb-2">
    <label>Số điện thoại <span class="text-danger">*</span></label>
    <input class="form-control"
           value="@Model.PhoneNumber"
           id="customerPhoneNumber"
           type="text"
           maxlength="10" />
    <p class="text-danger" style="display:none" id="order-customer-phone"></p>
</div>
<div class="mb-2">
    <label>Địa chỉ <span class="text-danger">*</span></label>
    <input class="form-control" value="@Model.Address" id="customerAddress" type="text" />
    <p class="text-danger" style="display:none" id="order-customer-address"></p>
</div>
<div class="mb-2">
    <label>Email</label>
    <input class="form-control" value="@Model.Email" id="customerEmail" type="text" />
    <p class="text-danger" style="display:none" id="order-customer-email"></p>
</div>