@model IEnumerable<GUI.Models.DTOs.AccountDTO>

@{
    ViewData["Title"] = "Quản lý tài khoản";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string phoneNumber = ViewBag.PhoneNumber;
}

<div class="container mt-4">
    <h2 class="text-center text-primary fw-bold">Quản Lý Tài Khoản</h2>
    <hr />
    <!-- Thanh tìm kiếm -->
    <div class="row mb-3 justify-content-end">
        <div class="col-md-6 d-flex gap-2 justify-content-end">
            <input id="searchPhone" class="form-control border-primary" placeholder="Nhập số điện thoại..." value="@phoneNumber" style="max-width: 250px;">
            <button class="btn btn-primary shadow-sm px-3" onclick="searchAccount()">
                <i class="fas fa-search"></i> Tìm kiếm
            </button>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary shadow-sm px-3">
                <i class="fas fa-sync"></i> Reset
            </a>
        </div>
    </div>


    <!-- Bảng danh sách tài khoản -->
    <div class="table-responsive">
        <table class="table table-hover shadow-sm mt-3">
            <thead class="table-dark text-center">
                <tr>
                    <th>Mã tài khoản</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Vai trò</th>
                </tr>
            </thead>
            <tbody class="text-center align-middle">
                @foreach (var account in Model)
                {
                    <tr>
                        <td>@account.AccountCode</td>
                        <td>@account.Email</td>
                        <td>@account.PhoneNumber</td>
                        <td>
                            <span class="badge @(account.Role == "Nhân viên" ? "bg-info" : "bg-success")">
                                @account.Role
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Thanh phân trang -->
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="?page=1" aria-label="First">
                    <span>&laquo;&laquo;</span>
                </a>
            </li>
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="?page=@(currentPage - 1)" aria-label="Previous">
                    <span>&laquo;</span>
                </a>
            </li>

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i">@i</a>
                </li>
            }

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="?page=@(currentPage + 1)" aria-label="Next">
                    <span>&raquo;</span>
                </a>
            </li>
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" href="?page=@totalPages" aria-label="Last">
                    <span>&raquo;&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>

@section scripts {
    <script>
        function searchAccount() {
            let phone = document.getElementById("searchPhone").value;
            window.location.href = `@Url.Action("Index")?phoneNumber=${phone}`;
        }
    </script>
}
