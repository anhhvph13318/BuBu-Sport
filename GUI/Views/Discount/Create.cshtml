@model GUI.Models.DTOs.Discount_DTO.CreateDiscountViewModel


<form asp-action="CreateDiscount" method="post">
    <input type="hidden" asp-for="Id" />
    <div>
        <label>Tên chương trình:</label>
        <input type="text" name="Name" required  value="@Model.Name"/>
    </div>
    <div>
        <label>Kiểu giảm giá:</label>
        <select name="DiscountType" id="discountType" onchange="toggleMaxAmountField()">
            <option value="percent" selected="@(Model.DiscountType == "percent")">Giảm theo %</option>
            <option value="fixed" selected="@(Model.DiscountType == "fixed")">Giảm cố định</option>
        </select>
    </div>
    <div>
        <label>Giá trị giảm:</label>
        <input type="number" name="DiscountValue" value="@Model.DiscountValue" required />
    </div>
    <div id="maxAmountField" style="display:none;">
        <label>Số tiền giảm tối đa:</label>
        <input type="number" name="MaxDiscountAmount" value="@Model.MaxDiscountAmount" />
    </div>
    <div>
        <label>Ngày bắt đầu:</label>
        <input type="datetime-local" name="StartDate"
               value="@(Model.StartDate.HasValue ? Model.StartDate.Value.ToString("yyyy-MM-ddTHH:mm") : "")"
               required />
    </div>
    <div>
        <label>Ngày kết thúc:</label>
        <input type="datetime-local" name="EndDate"
               value="@(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("yyyy-MM-ddTHH:mm") : "")"
               required />
    </div>

    <hr />

    <h4>Chọn sản phẩm áp dụng:</h4>
    <table>
        <thead>
            <tr>
                <th>Chọn</th>
                <th>Tên sản phẩm</th>
                <th>Giá gốc</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>
                        <input type="checkbox"
                               name="ProductIds"
                               value="@product.Id"
                        @(Model.ProductIds != null && Model.ProductIds.Contains(product.Id) ? "checked" : "") />
                    </td>
                    <td>@product.Name</td>
                    <td>@product.Price.ToString("N0") đ</td>
                </tr>
            }
        </tbody>
    </table>

    @{
        var actionName = ViewContext.RouteData.Values["action"]?.ToString();
    }
    @if (actionName == "Edit" || actionName == "Details" || actionName == "CreateOrUpdateDiscount")
    {
        <button type="submit" name="actionType" value="update">Cập nhật chương trình giảm giá</button>
    }
    else
    {
        <button type="submit" name="actionType" value="create">Tạo chương trình giảm giá</button>
    }
</form>

<script>
    function toggleMaxAmountField() {
        const type = document.getElementById("discountType").value;
        document.getElementById("maxAmountField").style.display = type === "percent" ? "block" : "none";
    }

    window.onload = toggleMaxAmountField;
</script>
