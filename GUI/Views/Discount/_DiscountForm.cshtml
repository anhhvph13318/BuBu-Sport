@model GUI.Models.DTOs.Discount_DTO.CreateDiscountViewModel

<div class="p-4 bg-light rounded-3 shadow-sm">
    <form asp-controller="Discount" asp-action="CreateDiscount" method="post" onsubmit="return confirmAction()">
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="actionType" value="@(Model.Id != Guid.Empty ? "update" : "create")" />

        <div class="row g-3">
            <!-- Cột trái -->
            <div class="col-md-6">
                <div class="mb-2">
                    <label class="form-label">Tên chương trình</label>
                    <input asp-for="Name" class="form-control form-control-sm" required />
                </div>
                <div class="mb-2">
                    <label class="form-label">Kiểu giảm giá</label>
                    <select asp-for="DiscountType" class="form-select form-select-sm" onchange="toggleMaxDiscount()" id="discountType">
                        <option value="percent">Giảm theo %</option>
                        <option value="fixed">Giảm cố định</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label">Giá trị giảm</label>
                    <input asp-for="DiscountValue" class="form-control form-control-sm" type="number" min="1" />
                </div>
                <div class="mb-2" id="maxDiscountAmountDiv">
                    <label class="form-label">Giảm tối đa</label>
                    <input asp-for="MaxDiscountAmount" class="form-control form-control-sm" type="number" />
                </div>
            </div>

            <!-- Cột phải -->
            <div class="col-md-6">
                @{
                    var currentDateTime = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
                }

                <div class="mb-2 row g-2">
                    <div class="col-6">
                        <label class="form-label">Bắt đầu</label>
                        <input asp-for="StartDate" class="form-control form-control-sm" type="datetime-local" min="@currentDateTime" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">Kết thúc</label>
                        <input asp-for="EndDate" class="form-control form-control-sm" type="datetime-local" min="@currentDateTime" />
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label">Sản phẩm áp dụng</label>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <select class="form-select form-select-sm w-auto" id="categoryFilter" onchange="filterProducts()">
                            <option value="">-- Tất cả danh mục --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>

                        <input type="text" id="productSearch" class="form-control form-control-sm w-auto" placeholder="Tìm theo tên..." onkeyup="filterProducts()" />
                    </div>

                    <div class="overflow-auto border rounded p-2" style="max-height: 200px;">
                        @foreach (var product in Model.Products)
                        {
                            <div class="form-check" data-category="@product.CategoryId">
                                <input class="form-check-input" type="checkbox"
                                       name="ProductIds" value="@product.Id"
                                @(Model.ProductIds != null && Model.ProductIds.Contains(product.Id) ? "checked" : "") />
                                <label class="form-check-label">@product.Name (@product.Price.ToString("N0") đ)</label>
                            </div>
                        }

                        <div id="noProductMessage" class="text-muted small text-center mt-2" style="display:none;">
                            Không có sản phẩm nào phù hợp.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-3">
            <button type="submit" class="btn btn-sm me-2 @(Model.Id != Guid.Empty ? "btn-success" : "btn-primary")">
                @(Model.Id != Guid.Empty ? "Cập nhật" : "Tạo")
            </button>
            <a class="btn btn-sm btn-danger" asp-action="Index">Quay lại</a>
        </div>
    </form>
</div>

<style>
    .btn-sm {
        padding: 0.35rem 1rem;
        border-radius: 8px;
        font-weight: 500;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .btn-sm:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
    }

    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
    @if (TempData["RegisterSuccess"] != null)
    {
        <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công!',
                    text: '@Html.Raw(TempData["RegisterSuccess"])',
                    confirmButtonText: 'OK'
                });
        </text>
    }
        });
    function toggleMaxDiscount() {
        const selected = document.getElementById("discountType").value;
        document.getElementById("maxDiscountAmountDiv").style.display = selected === "percent" ? "block" : "none";
    }
    window.onload = function () {
        toggleMaxDiscount();
        filterProducts(); // Gọi luôn lọc khi load nếu có giá trị sẵn
    };

    function confirmAction() {
        const actionType = document.querySelector('input[name="actionType"]').value;
        if (actionType === "create") {
            return confirm("Bạn có chắc chắn muốn tạo chương trình khuyến mại này?");
        } else if (actionType === "update") {
            return confirm("Bạn có chắc chắn muốn cập nhật chương trình khuyến mại này?");
        }
        return true;
    }

    function filterProducts() {
        const categoryId = document.getElementById("categoryFilter").value;
        const searchTerm = document.getElementById("productSearch").value.toLowerCase();
        const items = document.querySelectorAll(".form-check[data-category]");
        let visibleCount = 0;

        items.forEach(item => {
            const label = item.querySelector("label").textContent.toLowerCase();
            const itemCat = item.getAttribute("data-category");

            const matchCategory = !categoryId || itemCat === categoryId;
            const matchName = label.includes(searchTerm);

            if (matchCategory && matchName) {
                item.style.display = "block";
                visibleCount++;
            } else {
                item.style.display = "none";
            }
        });

        document.getElementById("noProductMessage").style.display = visibleCount === 0 ? "block" : "none";
    }
</script>

