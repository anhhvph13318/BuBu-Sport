@model GUI.Model_DTO.User_DTO.DetailUserResponse

@{
    ViewData["Title"] = "Edit";
}

<div class="container mt-5">
    <form asp-action="Edit" class="bg-light p-4 rounded shadow-sm">
        <h2 class="text-center mb-4">Chỉnh sửa nhân viên</h2>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <!-- Cột hiển thị thông tin nhân viên -->
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="UserName" class="form-label">Số điện thoại</label>
                    <input asp-for="UserName" class="form-control" placeholder="Nhập số điện thoại" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Nhập email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label for="Position" class="form-label">Vị trí</label>
                    <select asp-for="Position" class="form-select">
                        <option value="">Chọn vị trí</option>
                        <option value="1">Nhân viên</option>
                        <option value="2">Admin</option>
                    </select>
                    <span asp-validation-for="Position" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="FullName" class="form-label">Họ tên</label>
                    <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="UserCode" class="form-label">Mã Nhân Viên</label>
                    <input asp-for="UserCode" class="form-control" placeholder="Nhập mã nhân viên" />
                    <span asp-validation-for="UserCode" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="InActive" class="form-label">Hoạt động</label>
                    <input type="checkbox" asp-for="InActive" class="form-check-input" />
                    <span asp-validation-for="InActive" class="text-danger"></span>
                </div>

                <!-- Nút Save và Quay trở lại -->
                <div class="form-group d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Quay trở lại</a>
                    <button type="button" class="btn btn-primary" id="saveButton">
                        <span class="spinner-border spinner-border-sm" id="spinner" role="status" aria-hidden="true" style="display:none;"></span>
                        Save
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    document.getElementById('saveButton').addEventListener('click', function () {
        const isConfirmed = confirm('Bạn có chắc muốn lưu không?');
        if (isConfirmed) {
            const spinner = document.getElementById('spinner');
            spinner.style.display = 'inline-block'; // Hiện spinner khi nhấn nút
            this.closest('form').submit(); // Gửi form
        }
    });
</script>
