@model GUI.Model_DTO.User_DTO.CreateUserRequest

@{
    ViewData["Title"] = "Tạo mới";
}

<h3 class="mb-4" style="margin-top: 20px;">Tạo tài khoản mới</h3>

<hr />
<div class="row">
    <div class="col-md-6 offset-md-3">
        <form asp-action="Create" id="createUserForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Số điện thoại -->
            <div class="form-group mb-3">
                <label asp-for="UserName" class="control-label">Số điện thoại<span class="text-danger">*</span></label>
                <input asp-for="UserName" class="form-control" placeholder="Nhập số điện thoại" maxlength="10" required />
                <span asp-validation-for="UserName" class="text-danger"></span>
                <div class="invalid-feedback">Vui lòng nhập số điện thoại.</div>
            </div>

            <!-- Mật khẩu -->
            <div class="form-group mb-3">
                <label asp-for="Password" class="control-label">Mật khẩu</label>
                <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" type="password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- Email -->
            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label">Email<span class="text-danger">*</span></label>
                <input asp-for="Email" class="form-control" placeholder="Nhập email" type="email" required />
                <span asp-validation-for="Email" class="text-danger"></span>
                <div class="invalid-feedback">Vui lòng nhập email hợp lệ.</div>
            </div>

            <!-- Vị trí -->
            <div class="form-group mb-3">
                <label for="Position">Vị trí</label>
                <select asp-for="Position" class="form-select">
                    <option value="">Chọn vị trí</option>
                    <option value="1">Nhân viên</option>
                    <option value="2">Admin</option>
                </select>
                <span asp-validation-for="Position" class="text-danger"></span>
            </div>

            <!-- Họ tên -->
            <div class="form-group mb-3">
                <label asp-for="FullName" class="control-label">Họ tên<span class="text-danger">*</span></label>
                <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên" required />
                <span asp-validation-for="FullName" class="text-danger"></span>
                <div class="invalid-feedback">Vui lòng nhập họ tên.</div>
            </div>

            <!-- Mã nhân viên -->
            <div class="form-group mb-3">
                <label asp-for="UserCode" class="control-label">Mã Nhân Viên</label>
                <input asp-for="UserCode" class="form-control" placeholder="Nhập mã nhân viên" id="userCode" readonly />
                <span asp-validation-for="UserCode" class="text-danger"></span>
            </div>

            <!-- Hoạt động -->
            <div class="form-group mb-4">
                <label asp-for="InActive" class="control-label">Hoạt động</label>
                <div class="form-check">
                    <input type="checkbox" asp-for="InActive" class="form-check-input" />
                    <label class="form-check-label" for="InActive">Đánh dấu nếu không hoạt động</label>
                </div>
                <span asp-validation-for="InActive" class="text-danger"></span>
            </div>

            <!-- Submit Button -->
            <button type="button" class="btn btn-primary" id="saveButton">
                <span class="spinner-border spinner-border-sm" id="spinner" role="status" aria-hidden="true" style="display:none;"></span>
                Thêm mới
            </button>
        </form>
        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function validateForm() {
            var isValid = true;
            var form = document.getElementById('createUserForm');

            var phoneInput = form.querySelector('[name="UserName"]');
            if (!phoneInput.value.trim()) {
                phoneInput.classList.add('is-invalid');
                var errorDiv = phoneInput.parentElement.querySelector('.invalid-feedback');
                if (errorDiv) errorDiv.textContent = 'Vui lòng nhập số điện thoại.';
                isValid = false;
            } else if (phoneInput.value.trim().length !== 10 || !/^\d+$/.test(phoneInput.value.trim())) {
                phoneInput.classList.add('is-invalid');
                var errorDiv = phoneInput.parentElement.querySelector('.invalid-feedback');
                if (errorDiv) errorDiv.textContent = 'Số điện thoại phải có đúng 10 chữ số.';
                isValid = false;
            } else {
                phoneInput.classList.remove('is-invalid');
                phoneInput.classList.add('is-valid');
            }

            var emailInput = form.querySelector('[name="Email"]');
            if (!emailInput.value.trim()) {
                emailInput.classList.add('is-invalid');
                var errorDiv = emailInput.parentElement.querySelector('.invalid-feedback');
                if (errorDiv) errorDiv.textContent = 'Vui lòng nhập email.';
                isValid = false;
            } else if (!validateEmail(emailInput.value.trim())) {
                emailInput.classList.add('is-invalid');
                var errorDiv = emailInput.parentElement.querySelector('.invalid-feedback');
                if (errorDiv) errorDiv.textContent = 'Email không đúng định dạng.';
                isValid = false;
            } else {
                emailInput.classList.remove('is-invalid');
                emailInput.classList.add('is-valid');
            }

            var nameInput = form.querySelector('[name="FullName"]');
            if (!nameInput.value.trim()) {
                nameInput.classList.add('is-invalid');
                var errorDiv = nameInput.parentElement.querySelector('.invalid-feedback');
                if (errorDiv) errorDiv.textContent = 'Vui lòng nhập họ tên.';
                isValid = false;
            } else {
                nameInput.classList.remove('is-invalid');
                nameInput.classList.add('is-valid');
            }

            return isValid;
        }

        function validateEmail(email) {
            if (!email) return false;

            var atIndex = email.indexOf(String.fromCharCode(64));
            if (atIndex <= 0 || atIndex === email.length - 1) return false;

            var localPart = email.substring(0, atIndex);
            var domainPart = email.substring(atIndex + 1);
            if (!localPart || !domainPart) return false;
            var dotIndex = domainPart.indexOf('.');
            if (dotIndex <= 0 || dotIndex === domainPart.length - 1) return false;
            var tld = domainPart.substring(dotIndex + 1);
            if (tld.length < 2) return false;

            return true;
        }

        window.onload = function () {
            var randomCode = 'nv' + Math.floor(1000 + Math.random() * 9000);
            document.getElementById('userCode').value = randomCode;
        }

        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('createUserForm');
            var inputs = form.querySelectorAll('input[required]');

            for (var i = 0; i < inputs.length; i++) {
                inputs[i].addEventListener('input', function () {
                    if (this.value.trim()) {
                        this.classList.remove('is-invalid');
                    }
                });
            }


            document.getElementById('saveButton').addEventListener('click', function () {

                if (!validateForm()) {
                    return false;
                }

                Swal.fire({
                    title: 'Bạn có chắc muốn thêm mới không?',
                    text: "Thao tác này sẽ cập nhật dữ liệu!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        document.getElementById('spinner').style.display = 'inline-block';
                        document.getElementById('createUserForm').submit();
                    }
                });
            });
        });
    </script>
}