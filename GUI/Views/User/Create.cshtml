@model GUI.Model_DTO.User_DTO.CreateUserRequest

@{
    ViewData["Title"] = "Tạo mới";
}

<h3 class="mb-4" style="margin-top: 20px;">Tạo tài khoản mới</h3>

<hr />
<div class="row">
    <div class="col-md-6 offset-md-3">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Số điện thoại -->
            <div class="form-group mb-3">
                <label asp-for="UserName" class="control-label">Số điện thoại</label>
                <input asp-for="UserName" class="form-control" placeholder="Nhập số điện thoại" maxlength="10" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <!-- Mật khẩu -->
            <div class="form-group mb-3">
                <label asp-for="Password" class="control-label">Mật khẩu</label>
                <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" type="password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- Email -->
            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="Nhập email" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <!-- Vị trí -->
            <div class="form-group mb-3">
                <label for="Position">Vị trí</label>
                <select asp-for="Position" class="form-select">
                    <option value="">Chọn vị trí</option>
                    <option value="1">Nhân viên</option>
                    <option value="2">Admin</option>
                </select>
                <span asp-validation-for="Position" class="text-danger"></span>
            </div>

            <!-- Họ tên -->
            <div class="form-group mb-3">
                <label asp-for="FullName" class="control-label">Họ tên</label>
                <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <!-- Mã nhân viên -->
            <div class="form-group mb-3">
                <label asp-for="UserCode" class="control-label">Mã Nhân Viên</label>
                <input asp-for="UserCode" class="form-control" placeholder="Nhập mã nhân viên" id="userCode" readonly />
                <span asp-validation-for="UserCode" class="text-danger"></span>
            </div>

            <!-- Hoạt động -->
            <div class="form-group mb-4">
                <label asp-for="InActive" class="control-label">Hoạt động</label>
                <div class="form-check">
                    <input type="checkbox" asp-for="InActive" class="form-check-input" />
                    <label class="form-check-label" for="InActive">Đánh dấu nếu không hoạt động</label>
                </div>
                <span asp-validation-for="InActive" class="text-danger"></span>
            </div>

            <!-- Submit Button -->
            <button type="button" class="btn btn-primary" id="saveButton">
                <span class="spinner-border spinner-border-sm" id="spinner" role="status" aria-hidden="true" style="display:none;"></span>
                Thêm mới
            </button>
        </form>
        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </div>

</div>



@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script>
    document.getElementById('saveButton').addEventListener('click', function () {
        Swal.fire({
            title: 'Bạn có chắc muốn thêm mới không?',
            text: "Thao tác này sẽ cập nhật dữ liệu!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Đồng ý',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('spinner').style.display = 'inline-block';
                document.querySelector('form').submit(); // submit form HTML
            }
        });
    });
    window.onload = function () {
        // Tạo mã nhân viên có định dạng 'nv' + 4 số ngẫu nhiên
        var randomCode = 'nv' + Math.floor(1000 + Math.random() * 9000);
        document.getElementById('userCode').value = randomCode;
    }
</script>
