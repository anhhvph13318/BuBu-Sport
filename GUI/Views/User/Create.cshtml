@model GUI.Model_DTO.User_DTO.CreateUserRequest

@{
    ViewData["Title"] = "Create";
}

<style>
    .row {
        max-width: 900px;
        margin: 30px auto;
        padding: 20px;
    }

    .form-container {
        background-color: #ffffff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    h2 {
        text-align: center;
        color: #007bff;
        font-size: 28px;
        margin-bottom: 10px;
    }

    hr {
        border: none;
        border-top: 1px solid #e0e0e0;
    }

    .column-wrapper {
        display: flex;
        flex-wrap: wrap;
        gap: 30px;
        width: 100%;
    }

    .column {
        flex: 1;
        min-width: 300px;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .control-label {
        font-weight: 500;
        margin-bottom: 4px;
        display: block;
    }

    .form-control, .form-select {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid #ccc;
        border-radius: 6px;
        transition: border-color 0.3s, box-shadow 0.3s;
    }

        .form-control:focus, .form-select:focus {
            border-color: #007bff;
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.1);
            outline: none;
        }

    .input-group {
        display: flex;
        align-items: center;
    }

    .input-group-text {
        background-color: #f0f0f0;
        border: 1px solid #ccc;
        border-right: none;
        border-radius: 6px 0 0 6px;
        padding: 8px 12px;
        font-size: 16px;
    }

    .input-group .form-control {
        border-radius: 0 6px 6px 0;
        border-left: none;
    }

    .form-check-input {
        margin-right: 8px;
        transform: scale(1.2);
    }

    .text-danger {
        font-size: 13px;
        margin-top: 4px;
        color: #dc3545;
    }

    .button-container {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 10px;
    }

    a {
        color: #007bff;
        text-decoration: none;
        padding: 8px 16px;
        border: 1px solid transparent;
        border-radius: 6px;
        transition: background-color 0.2s;
    }

        a:hover {
            background-color: #e6f0ff;
        }

    .btn-primary {
        background-color: #007bff;
        border: none;
        padding: 10px 20px;
        border-radius: 6px;
        color: white;
        transition: background-color 0.2s;
    }

        .btn-primary:hover {
            background-color: #0069d9;
        }
</style>

<div class="row">
    <form asp-action="Create">
        <div class="form-container">
            <h2 class="text-primary fw-bold">
                Tạo Mới
            </h2>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="column-wrapper">
                <div class="column">
                    <div class="form-group">
                        <label asp-for="UserName" class="control-label">Số điện thoại</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            <input asp-for="UserName" class="form-control" />
                        </div>
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Password" class="control-label">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" type="password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Email" class="control-label">Email</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group d-flex align-items-center">
                        <input type="checkbox" asp-for="InActive" class="form-check-input" />
                        <label asp-for="InActive" class="control-label ms-2">Hoạt động</label>
                        <span asp-validation-for="InActive" class="text-danger"></span>
                    </div>
                </div>
                <div class="column">
                    <div class="form-group">
                        <label asp-for="FullName" class="control-label">Họ tên</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="FullName" class="form-control" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="UserCode" class="control-label">Mã Nhân Viên</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-upc"></i></span>
                            <input asp-for="UserCode" class="form-control" />
                        </div>
                        <span asp-validation-for="UserCode" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Position" class="control-label">Vị trí</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-briefcase"></i></span>
                            <select asp-for="Position" class="form-select">
                                <option value="">Chọn vị trí</option>
                                <option value="1">Nhân viên</option>
                                <option value="2">Admin</option>
                            </select>
                        </div>
                        <span asp-validation-for="Position" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="button-container">
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                <input type="submit" value="Thêm mới" class="btn btn-primary" />
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

