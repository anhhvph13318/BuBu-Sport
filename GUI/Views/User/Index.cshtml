@model GUI.Models.DTOs.User_DTO.Views.IndexObject

@{
    ViewData["Title"] = "Danh sách nhân viên";
}

<div class="container mt-4">
    <h2 class="text-center text-primary fw-bold">Danh Sách Nhân Viên</h2>
    <hr />
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="Create" class="btn btn-success">Tạo mới</a>
        <form asp-controller="User" asp-action="Index" method="get" class="d-flex" style="max-width: 700px; width: 100%;">
            <div class="d-flex me-2" style="flex: 3;">
                <input type="text" name="userName" class="form-control me-2" placeholder="Tên" value="@ViewBag.FullName" />
                <input type="text" name="phoneNumber" class="form-control me-2" placeholder="SĐT" value="@ViewBag.UserName" />
                <input type="text" name="userCode" class="form-control" placeholder="Mã NV" value="@ViewBag.UserCode" />
            </div>
            <div class="d-flex" style="flex: 1;">
                <a href="@Url.Action("Index")" class="btn btn-secondary me-2">
                    <i class="fas fa-undo"></i> Xóa
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search"></i> Tìm
                </button>
            </div>
        </form>
    </div>



    <div class="table-responsive">
        <table class="table table-hover shadow-sm mt-3 text-center align-middle table-striped">
            <thead class="table-dark table-striped">
                <tr>
                    <th>STT</th>
                    <th>Mã nhân viên</th>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Chức vụ</th>
                    <th>Trạng thái</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @{var index = 1;}
                @foreach (var item in Model.Data.listUser)
                {
                    <tr>
                        <td>@index</td>
                        <td>@item.UserCode</td>
                        <td>@item.FullName</td>
                        <td>@item.Email</td>
                        <td>@item.UserName</td>
                        <td>
                            <span class="badge @(item.Position == "1" ? "bg-info" : item.Position == "2" ? "bg-warning" : "bg-secondary")">
                                @(item.Position == "1" ? "Nhân viên" : item.Position == "2" ? "Admin" : "Không xác định")
                            </span>
                        </td>
                        <td>
                            <span class="badge @(item.InActive ? "bg-success" : "bg-danger")">
                                @(item.InActive ? "Đang hoạt động" : "Không hoạt động")
                            </span>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i> Sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash-alt"></i> Xóa
                            </a>
                        </td>
                    </tr>
                    index++;
                }
            </tbody>
        </table>
    </div>
</div>
