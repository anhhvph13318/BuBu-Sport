@model GUI.Models.DTOs.ProductDetail_DTO.CreateProductDetailRequest

@{
    ViewData["Title"] = "Thêm chi tiết sản phẩm";
    var sortedSizes = ((IEnumerable<dynamic>)ViewBag.Sizes).OrderByDescending(s => s.SizeName).ToList();
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<div class="container my-4">
    <h1 class="text-primary"><i class="fas fa-box-open me-2"></i>Thêm chi tiết sản phẩm</h1>
    <hr class="border-primary" />
    <form asp-action="CreateDetail" method="post" class="needs-validation" novalidate>
        <div class="row g-4">
            <div class="col-md-6">
                <input type="hidden" asp-for="ProductID" />

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary bg-opacity-10">
                        <h5 class="card-title mb-0"><i class="fas fa-palette me-2"></i>Màu sắc</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-group">
                            <select id="colorSelect" asp-for="Color" class="form-select shadow-sm" required>
                                <option value="">Chọn màu sắc</option>
                                @foreach (var item in ViewBag.Colors)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                                <option value="add_new"><i class="fas fa-plus me-1"></i>Thêm màu sắc</option>
                            </select>
                            <div class="invalid-feedback">Vui lòng chọn màu sắc</div>
                            <span asp-validation-for="Color" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <input type="hidden" id="productId" asp-for="ProductID" />

                <div class="modal fade" id="addColorModal" tabindex="-1" aria-labelledby="addColorLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title" id="addColorLabel"><i class="fas fa-palette me-2"></i>Thêm màu sắc</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <label for="newColorName" class="form-label">Tên màu sắc</label>
                                <input type="text" id="newColorName" class="form-control" placeholder="Nhập tên màu">
                                <input type="hidden" id="modalProductId" />
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Đóng</button>
                                <button type="button" class="btn btn-primary" id="saveNewColor"><i class="fas fa-save me-1"></i>Lưu</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary bg-opacity-10 d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0"><i class="fas fa-ruler me-2"></i>Chọn Size & Số Lượng</h5>
                        <div>
                            <button type="button" class="btn btn-primary btn-sm me-2" id="toggleSizeTable"><i class="fas fa-angle-up"></i></button>
                            <button type="button" class="btn btn-outline-primary btn-sm" id="addSizeButton"><i class="fas fa-plus me-1"></i>Thêm size</button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" id="sizeTableContainer" style="max-height: 450px; overflow-y: auto;">
                            <table class="table table-bordered table-hover table-sm mb-0">
                                <thead class="table-primary sticky-top">
                                    <tr>
                                        <th class="text-center" style="width: 50%;">Size</th>
                                        <th class="text-center" style="width: 50%;">Số lượng</th>
                                    </tr>
                                </thead>
                                <tbody id="sizeTableBody">
                                    @{
                                        int index = 0;
                                    }
                                    @foreach (var item in sortedSizes)
                                    {
                                        <tr>
                                            <td class="align-middle">
                                                <div class="form-check">
                                                    <input type="checkbox" class="form-check-input sizeCheckbox" data-size-id="@item.Id" id="size_@item.Id">
                                                    <label class="form-check-label" for="size_@item.Id">@item.SizeName</label>
                                                </div>
                                            </td>
                                            <td class="align-middle text-center">
                                                <input type="number" class="form-control form-control-sm quantityInput" name="SizesQuantities[@index].QuantitySize"
                                                       id="quantity_@item.Id" min="0" value="0" style="width: 100px; margin: 0 auto;" disabled>
                                                <input type="hidden" name="SizesQuantities[@index].IdSize" value="@item.Id">
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div id="sizeValidationMsg" class="invalid-feedback text-center" style="display: none;">
                            Vui lòng chọn ít nhất một size và nhập số lượng
                        </div>
                    </div>
                </div>

                <input type="hidden" id="sizeValidation" name="sizeValidation" required>

                <div class="modal fade" id="addSizeModal" tabindex="-1" aria-labelledby="addSizeLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title" id="addSizeLabel"><i class="fas fa-ruler me-2"></i>Thêm size</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <label for="newSizeName" class="form-label">Tên size</label>
                                <input type="text" id="newSizeName" class="form-control" placeholder="Nhập tên size">
                                <input type="hidden" id="modalProductIdSize" />
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Đóng</button>
                                <button type="button" class="btn btn-primary" id="saveNewSize"><i class="fas fa-save me-1"></i>Lưu</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="button" class="btn btn-primary" id="submitButton"onclick="confirmAction()"><i class="fas fa-save me-1"></i>Lưu biến thể</button>
                    <a href="@Context.Request.Headers["Referer"]" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-primary bg-opacity-10">
                        <h5 class="card-title mb-0"><i class="fas fa-image me-2"></i>Ảnh sản phẩm</h5>
                    </div>
                    <div class="card-body d-flex flex-column align-items-center justify-content-center">
                        <div class="form-group w-100">
                            <div class="input-group mb-3">
                                <span class="input-group-text"><i class="fas fa-upload"></i></span>
                                <input type="file" id="fileInput" class="form-control" accept="image/*" required title="Vui lòng chọn một ảnh sản phẩm" />
                            </div>
                            <div class="text-center">
                                <img id="imagePreview" src="/path/to/default-image.jpg" alt="Image preview" style="width: 300px; height: 300px; object-fit: cover;" class="mt-3 img-thumbnail shadow-sm" />
                                <input type="hidden" asp-for="UrlImage" id="urlImage" />
                                <span asp-validation-for="UrlImage" class="text-danger d-block mt-2"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function confirmAction() {

        Swal.fire({
            title: 'Cảnh báo',
            text: "Bạn có chắc chắn muốn thực hiện hành động này?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Có, lưu lại!',
            cancelButtonText: 'Không, hủy bỏ!'
        }).then((result) => {
            if (result.isConfirmed) {
                // Nếu người dùng chọn "Đồng ý", submit form
                document.querySelector('form').submit(); // Submit form sau khi xác nhận
            }
        });

        return false; // Ngừng submit form nếu chưa xác nhận
    }
    document.addEventListener("DOMContentLoaded", function () {
        // Xử lý checkbox kích thước
        document.querySelectorAll(".sizeCheckbox").forEach(checkbox => {
            checkbox.addEventListener("change", function () {
                const sizeId = this.getAttribute("data-size-id");
                const quantityInput = document.getElementById(`quantity_${sizeId}`);
                if (this.checked) {
                    quantityInput.disabled = false;
                    quantityInput.value = 1;
                    quantityInput.focus();
                } else {
                    quantityInput.disabled = true;
                    quantityInput.value = 0;
                }
                validateSizeSelection();
            });
        });

        // Hàm kiểm tra kích thước
        function validateSizeSelection() {
            let anySizeSelected = false;
            document.querySelectorAll(".sizeCheckbox").forEach(checkbox => {
                if (checkbox.checked) {
                    const sizeId = checkbox.getAttribute("data-size-id");
                    const quantityInput = document.getElementById(`quantity_${sizeId}`);
                    if (parseInt(quantityInput.value) > 0) {
                        anySizeSelected = true;
                    }
                }
            });
            const sizeValidation = document.getElementById("sizeValidation");
            sizeValidation.value = anySizeSelected ? "valid" : "";
            document.getElementById("sizeValidationMsg").style.display = anySizeSelected ? "none" : "block";
            return anySizeSelected;
        }

        // Theo dõi thay đổi số lượng
        document.querySelectorAll(".quantityInput").forEach(input => {
            input.addEventListener("change", validateSizeSelection);
            input.addEventListener("input", validateSizeSelection);
        });

        // Xử lý submit form
        document.querySelector("form").addEventListener("submit", function (e) {
            e.preventDefault();

            // Kiểm tra màu sắc
            const colorSelect = document.getElementById("colorSelect");
            if (!colorSelect.value) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Lỗi',
                    text: 'Vui lòng chọn màu sắc cho sản phẩm',
                    confirmButtonColor: '#3085d6'
                });
                colorSelect.focus();
                return;
            }

            // Kiểm tra kích thước và số lượng
            const selectedSizes = [];
            document.querySelectorAll("#sizeTableBody tr").forEach(row => {
                const checkbox = row.querySelector(".sizeCheckbox");
                const quantityInput = row.querySelector(".quantityInput");
                const sizeId = checkbox.getAttribute("data-size-id");
                const quantity = parseInt(quantityInput.value);
                if (checkbox.checked && quantity > 0) {
                    selectedSizes.push({ sizeId, quantity });
                }
            });

            if (selectedSizes.length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Lỗi',
                    text: 'Vui lòng chọn ít nhất một size và nhập số lượng',
                    confirmButtonColor: '#3085d6'
                });
                document.getElementById("sizeValidationMsg").style.display = "block";
                return;
            }

            // Kiểm tra ảnh
            const urlImage = document.getElementById("urlImage").value.trim();
            if (!urlImage) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Lỗi',
                    text: 'Vui lòng chọn và tải lên ảnh sản phẩm',
                    confirmButtonColor: '#3085d6'
                });
                document.getElementById("fileInput").focus();
                return;
            }

            // Xóa các input ẩn cũ
            document.querySelectorAll('input[name^="SizesQuantities"]').forEach(input => input.remove());

            // Thêm kích thước và số lượng đã chọn
            selectedSizes.forEach((size, i) => {
                const quantityInput = document.createElement('input');
                quantityInput.type = 'hidden';
                quantityInput.name = `SizesQuantities[${i}].QuantitySize`;
                quantityInput.value = size.quantity;

                const sizeIdInput = document.createElement('input');
                sizeIdInput.type = 'hidden';
                sizeIdInput.name = `SizesQuantities[${i}].IdSize`;
                sizeIdInput.value = size.sizeId;

                this.appendChild(quantityInput);
                this.appendChild(sizeIdInput);
            });

            this.submit();
        });

        // Thu gọn/bỏ thu gọn bảng kích thước
        document.getElementById("toggleSizeTable").addEventListener("click", function () {
            const tableContainer = document.getElementById("sizeTableContainer");
            const iconElement = this.querySelector("i");
            tableContainer.style.display = tableContainer.style.display === "none" ? "block" : "none";
            iconElement.className = tableContainer.style.display === "none" ? "fas fa-angle-down" : "fas fa-angle-up";
        });

        // Mở modal thêm màu sắc
        document.getElementById("colorSelect").addEventListener("change", function () {
            if (this.value === "add_new") {
                this.value = "";
                document.getElementById("modalProductId").value = document.getElementById("productId").value;
                new bootstrap.Modal(document.getElementById('addColorModal')).show();
            }
        });

        // Mở modal thêm kích thước
        document.getElementById("addSizeButton").addEventListener("click", function () {
            document.getElementById("modalProductIdSize").value = document.getElementById("productId").value;
            new bootstrap.Modal(document.getElementById('addSizeModal')).show();
        });

        // Lưu màu sắc mới
        document.getElementById("saveNewColor").addEventListener("click", function () {
            Swal.fire({
                title: 'Xác nhận lưu màu sắc',
                text: "Bạn có chắc chắn muốn lưu màu sắc này?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Có, lưu lại!',
                cancelButtonText: 'Không, hủy bỏ!'
            }).then((result) => {
                if (result.isConfirmed) {
                    saveColor();
                }
            });
        });

        async function saveColor() {
            const newColorName = document.getElementById("newColorName").value.trim();
            const productId = document.getElementById("modalProductId").value;

            if (!newColorName) {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Vui lòng nhập tên màu sắc' });
                return;
            }

            try {
                const response = await fetch("/ProductDetail/CreateColorDetail", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ name: newColorName, productId })
                });

                if (!response.ok) throw new Error("Thêm màu thất bại!");

                const newColor = await response.json();
                const select = document.getElementById("colorSelect");
                const newOption = document.createElement("option");
                newOption.value = newColor.id;
                newOption.textContent = newColor.name;
                newOption.selected = true;
                select.insertBefore(newOption, select.lastElementChild);

                bootstrap.Modal.getInstance(document.getElementById('addColorModal')).hide();
                document.getElementById("newColorName").value = "";
                window.location.reload();
            } catch (error) {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: error.message });
            }
        }

        // Lưu kích thước mới
        document.getElementById("saveNewSize").addEventListener("click", function () {
            Swal.fire({
                title: 'Xác nhận lưu size',
                text: "Bạn có chắc chắn muốn lưu size này?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Có, lưu lại!',
                cancelButtonText: 'Không, hủy bỏ!'
            }).then((result) => {
                if (result.isConfirmed) {
                    saveSize();
                }
            });
        });

        async function saveSize() {
            const newSizeName = document.getElementById("newSizeName").value.trim();
            const productId = document.getElementById("modalProductIdSize").value;

            if (!newSizeName) {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Vui lòng nhập tên size' });
                return;
            }

            try {
                const response = await fetch("/ProductDetail/CreateSizeDetail", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ SizeName: newSizeName, productId })
                });

                if (!response.ok) throw new Error("Thêm size thất bại!");

                const newSize = await response.json();
                const tableBody = document.getElementById("sizeTableBody");
                const newRow = document.createElement("tr");
                newRow.innerHTML = `
                <td class="align-middle">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input sizeCheckbox" data-size-id="${newSize.id}" id="size_${newSize.id}">
                        <label class="form-check-label" for="size_${newSize.id}">${newSize.SizeName}</label>
                    </div>
                </td>
           
            `;
                tableBody.insertBefore(newRow, tableBody.firstChild);
                const newCheckbox = newRow.querySelector(".sizeCheckbox");
                newCheckbox.addEventListener("change", function () {
                    const sizeId = this.getAttribute("data-size-id");
                    const quantityInput = document.getElementById(`quantity_${sizeId}`);
                    if (this.checked) {
                        quantityInput.disabled = false;
                        quantityInput.value = 1;
                        quantityInput.focus();
                    } else {
                        quantityInput.disabled = true;
                        quantityInput.value = 0;
                    }
                    validateSizeSelection();
                });

                bootstrap.Modal.getInstance(document.getElementById('addSizeModal')).hide();
                document.getElementById("newSizeName").value = "";

                // Hiển thị thông báo thành công
                await Swal.fire({ icon: 'success', title: 'Thành công', text: 'Thêm size thành công!' });

                window.location.reload();
            } catch (error) {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: error.message });
            }
        }

        // Xử lý tải ảnh
        $('#fileInput').on("change", function (e) {
            const file = e.target.files[0];
            if (!file) return;

            const submitButton = document.getElementById("submitButton");
            submitButton.disabled = true; // Vô hiệu hóa nút lưu khi đang tải ảnh

            const reader = new FileReader();
            reader.onload = function (event) {
                $("#imagePreview").attr("src", event.target.result);
            };
            reader.readAsDataURL(file);

            $("#imagePreview").attr("src", "https://i.gifer.com/origin/34/34338d26023e5515f6cc8969aa027bca.gif");

            const form = new FormData();
            form.append("api_key", "284335524597493");
            form.append("upload_preset", "vanh2204");
            form.append("public_id", new Date().toISOString().replace(/[-:.]/g, ""));
            form.append("file", file);

            $.ajax({
                async: true,
                crossDomain: true,
                url: "https://api.cloudinary.com/v1_1/dnvuz3evz/image/upload",
                method: "POST",
                processData: false,
                contentType: false,
                mimeType: "multipart/form-data",
                data: form
            }).done(function (response) {
                const data = JSON.parse(response);
                if (data && data.secure_url) {
                    $("#imagePreview").attr("src", data.secure_url);
                    $('#urlImage').val(data.secure_url);
                    submitButton.disabled = false; // Kích hoạt lại nút lưu
                } else {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Không thể tải ảnh lên. Vui lòng thử lại.' });
                    $("#imagePreview").attr("src", "/path/to/default-image.jpg");
                    submitButton.disabled = false;
                }
            }).fail(function (error) {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Lỗi khi tải ảnh lên: ' + error.statusText });
                $("#imagePreview").attr("src", "/path/to/default-image.jpg");
                submitButton.disabled = false;
            });
        });
    });
</script>