@model GUI.Models.DTOs.ProductDetail_DTO.CreateProductDetailRequest

@{
    ViewData["Title"] = "Thêm chi tiết sản phẩm";
}

<div class="container">
    <h1>Thêm sản phẩm mới</h1>
    <hr /> 
    <form asp-action="CreateDetail" method="post">
        <input type="hidden" asp-for="ProductID" /> <!-- Thêm trường ẩn -->
@*         <div class="form-group mb-3">
            <label asp-for="Price" class="control-label">Giá sản phẩm</label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div> *@

        <div class="form-group mb-3">
            <label asp-for="Quantity" class="control-label">Số lượng</label>
            <input asp-for="Quantity" class="form-control" id="priceInput" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="Color" class="control-label">Màu sắc</label>
            <select id="categorySelect" asp-for="Color" class="form-select">
                <option selected value="">Chọn màu sắc</option>
                @foreach (var item in ViewBag.Colors)
                {
                    <option value="@item.Id">@item.Name</option>
                }
                <option value="add_new">➕ Thêm màu sắc</option>
            </select>
            <span asp-validation-for="Color" class="text-danger"></span>
        </div>

        <!-- Input ẩn chứa ProductID -->
        <input type="hidden" id="productId" asp-for="ProductID" />

        <!-- Modal thêm màu sắc -->
        <div class="modal fade" id="addColorModal" tabindex="-1" aria-labelledby="addColorLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addColorLabel">Thêm màu sắc</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <label for="newColorName" class="form-label">Tên màu sắc</label>
                        <input type="text" id="newColorName" class="form-control" placeholder="Nhập tên màu">
                        <input type="hidden" id="modalProductId" /> <!-- Input ẩn trong modal -->
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="button" class="btn btn-primary" id="saveNewColor">Lưu</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group mb-3">
            <label asp-for="SizeName" class="control-label">Size</label>
            <select id="categorySelect" asp-for="SizeName" class="form-select">
                <option selected value="">Chọn Size</option>
                @foreach (var item in ViewBag.Sizes)
                {
                    <option value="@item.Id">@item.SizeName</option>
                }
            </select>
            <span asp-validation-for="SizeName" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Lưu biến thể</button>
    </form>

    <div class="mt-3">
        <a href="@Context.Request.Headers["Referer"]" class="btn btn-secondary">Quay lại</a>
    </div>

</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    document.getElementById("categorySelect").addEventListener("change", function () {
        if (this.value === "add_new") {
            this.value = ""; // Reset dropdown

            // Lấy ProductID từ input ẩn và đặt vào modal
            document.getElementById("modalProductId").value = document.getElementById("productId").value;

            var modal = new bootstrap.Modal(document.getElementById('addColorModal'));
            modal.show();
        }
    });

    document.getElementById("saveNewColor").addEventListener("click", async function () {
        var newColorName = document.getElementById("newColorName").value.trim();
        var productId = document.getElementById("modalProductId").value; // Lấy ProductID

        if (!newColorName) return; // Kiểm tra không nhập rỗng

        try {
            let response = await fetch("/ProductDetail/CreateColorDetail", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name: newColorName, productId: productId }) // Gửi dữ liệu
            });

            if (!response.ok) throw new Error("Thêm màu thất bại!");

            let newColor = await response.json(); // Lấy dữ liệu từ API

            // Thêm vào dropdown
            let select = document.getElementById("categorySelect");
            let newOption = document.createElement("option");
            newOption.value = newColor.id;
            newOption.textContent = newColor.name;
            newOption.selected = true; // Chọn luôn màu vừa thêm

            select.insertBefore(newOption, select.lastElementChild); // Thêm trước "Thêm màu sắc"

            // Ẩn modal và reset input
            bootstrap.Modal.getInstance(document.getElementById('addColorModal')).hide();
            document.getElementById("newColorName").value = "";
        } catch (error) {
            alert(error.message); // Hiển thị lỗi nếu có
        }
    });
    document.getElementById("addColorButton").addEventListener("click", async function () {
        const productId = document.getElementById("ProductID").value; // Lấy ProductID từ input hidden
        const colorName = document.getElementById("colorInput").value; // Lấy màu từ input (nếu có)

        const data = { ProductID: productId, Name: colorName };

        try {
            const response = await fetch("/CreateColorDetail", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (result.success) {
                // Chuyển hướng + F5 lại trang
                window.location.href = result.url;
                setTimeout(() => {
                    window.location.reload();
                }, 500); // Reload sau 0.5s để đảm bảo trang đã load
            } else {
                alert("Lỗi: " + result.message);
            }
        } catch (error) {
            alert("Có lỗi xảy ra, vui lòng thử lại!");
        }
    });
</script>