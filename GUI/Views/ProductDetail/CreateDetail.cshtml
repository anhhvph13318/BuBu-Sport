@model GUI.Models.DTOs.ProductDetail_DTO.CreateProductDetailRequest

@{
    ViewData["Title"] = "Thêm chi tiết sản phẩm";
    var sortedSizes = ((IEnumerable<dynamic>)ViewBag.Sizes).OrderByDescending(s => s.SizeName).ToList();
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<div class="container my-4">
    <h1 class="text-primary"><i class="fas fa-box-open me-2"></i>Thêm chi tiết sản phẩm</h1>
    <hr class="border-primary" />
    <form asp-action="CreateDetail" method="post">
        <div class="row g-4">
            <div class="col-md-6">
                <input type="hidden" asp-for="ProductID" />

                <div class="form-group mb-3">
                    <label asp-for="Color" class="control-label fw-bold"><i class="fas fa-palette me-2"></i>Màu sắc</label>
                    <select id="categorySelect" asp-for="Color" class="form-select shadow-sm">
                        <option selected value="">Chọn màu sắc</option>
                        @foreach (var item in ViewBag.Colors)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                        <option value="add_new"><i class="fas fa-plus me-1"></i>Thêm màu sắc</option>
                    </select>
                    <span asp-validation-for="Color" class="text-danger"></span>
                </div>

                <input type="hidden" id="productId" asp-for="ProductID" />

                <div class="modal fade" id="addColorModal" tabindex="-1" aria-labelledby="addColorLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title" id="addColorLabel"><i class="fas fa-palette me-2"></i>Thêm màu sắc</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <label for="newColorName" class="form-label">Tên màu sắc</label>
                                <input type="text" id="newColorName" class="form-control" placeholder="Nhập tên màu">
                                <input type="hidden" id="modalProductId" />
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Đóng</button>
                                <button type="button" class="btn btn-primary" id="saveNewColor"><i class="fas fa-save me-1"></i>Lưu</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="control-label fw-bold"><i class="fas fa-ruler me-2"></i>Chọn Size & Số Lượng</label>
                    <div class="d-flex align-items-center mb-2">
                        <button type="button" class="btn btn-primary btn-sm me-2" id="toggleSizeTable"><i class="fas fa-angle-up"></i></button>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="addSizeButton"><i class="fas fa-plus me-1"></i>Thêm size</button>
                    </div>
                    <div class="table-responsive mt-2 shadow-sm rounded" id="sizeTableContainer" style="max-height: 450px; overflow-y: auto;">
                        <table class="table table-bordered table-hover table-sm">
                            <thead class="table-primary sticky-top">
                                <tr>
                                    <th class="text-center" style="width: 50%;">Size</th>
                                    <th class="text-center" style="width: 50%;">Số lượng</th>
                                </tr>
                            </thead>
                            <tbody id="sizeTableBody">
                                @{
                                    int index = 0;
                                }
                                @foreach (var item in sortedSizes)
                                {
                                    <tr>
                                        <td class="align-middle">
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input sizeCheckbox" data-size-id="@item.Id" id="size_@item.Id">
                                                <label class="form-check-label" for="size_@item.Id">@item.SizeName</label>
                                            </div>
                                        </td>
                                        <td class="align-middle">
                                            <input type="number" class="form-control form-control-sm quantityInput" name="SizesQuantities[@index].QuantitySize"
                                                   id="quantity_@item.Id" min="0" value="0" style="width: 80px; margin: 0 auto;">
                                            <input type="hidden" name="SizesQuantities[@index].IdSize" value="@item.Id">
                                        </td>
                                    </tr>
                                    index++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <input type="hidden" id="productId" asp-for="ProductID" />

                <div class="modal fade" id="addSizeModal" tabindex="-1" aria-labelledby="addSizeLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header bg-primary text-white">
                                <h5 class="modal-title" id="addSizeLabel"><i class="fas fa-ruler me-2"></i>Thêm size</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <label for="newSizeName" class="form-label">Tên size</label>
                                <input type="text" id="newSizeName" class="form-control" placeholder="Nhập tên size">
                                <input type="hidden" id="modalProductIdSize" />
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Đóng</button>
                                <button type="button" class="btn btn-primary" id="saveNewSize"><i class="fas fa-save me-1"></i>Lưu</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Lưu biến thể</button>
                    <a href="@Context.Request.Headers["Referer"]" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
                </div>
            </div>
            <div class="col-md-6 d-flex justify-content-center align-items-center">
                <div class="card shadow-sm p-3">
                    <div class="form-group">
                        <label asp-for="UrlImage" class="form-label fw-bold"><i class="fas fa-image me-2"></i>Ảnh sản phẩm</label>
                        <input type="file" id="fileInput" class="form-control" accept="image/*" required title="Vui lòng chọn một ảnh sản phẩm" />
                        <img id="imagePreview"
                             src="/path/to/default-image.jpg"
                             alt="Image preview"
                             style="display: block; width: 250px; height: 250px; object-fit: cover;"
                             class="mt-3 img-thumbnail" />
                        <input type="hidden" asp-for="UrlImage" id="urlImage" />
                        <span asp-validation-for="UrlImage" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelector("form").addEventListener("submit", function (e) {
            let rows = document.querySelectorAll("#sizeTableBody tr");

            rows.forEach((row) => {
                let checkbox = row.querySelector(".sizeCheckbox");
                let quantityInput = row.querySelector(".quantityInput");
                let sizeIdInput = row.querySelector("input[type=hidden]");

                let quantity = parseInt(quantityInput.value);

                if (!checkbox.checked || quantity <= 0) {
                    sizeIdInput.remove();
                    quantityInput.remove();
                }
            });
        });
    });

    document.getElementById("toggleSizeTable").addEventListener("click", function () {
        var tableContainer = document.getElementById("sizeTableContainer");
        if (tableContainer.style.display === "none") {
            tableContainer.style.display = "block";
            this.innerHTML = '<i class="fas fa-angle-up"></i>';
        } else {
            tableContainer.style.display = "none";
            this.innerHTML = '<i class="fas fa-angle-down"></i>';
        }
    });

    document.getElementById("categorySelect").addEventListener("change", function () {
        if (this.value === "add_new") {
            this.value = "";
            document.getElementById("modalProductId").value = document.getElementById("productId").value;
            var modal = new bootstrap.Modal(document.getElementById('addColorModal'));
            modal.show();
        }
    });

    document.getElementById("addSizeButton").addEventListener("click", function () {
        document.getElementById("modalProductIdSize").value = document.getElementById("productId").value;
        var modal = new bootstrap.Modal(document.getElementById('addSizeModal'));
        modal.show();
    });

    document.getElementById("saveNewColor").addEventListener("click", async function () {
        var newColorName = document.getElementById("newColorName").value.trim();
        var productId = document.getElementById("modalProductId").value;

        if (!newColorName) return;

        try {
            let response = await fetch("/ProductDetail/CreateColorDetail", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ name: newColorName, productId: productId })
            });

            if (!response.ok) throw new Error("Thêm màu thất bại!");

            let newColor = await response.json();
            let select = document.getElementById("categorySelect");
            let newOption = document.createElement("option");
            newOption.value = newColor.id;
            newOption.textContent = newColor.name;
            newOption.selected = true;
            select.insertBefore(newOption, select.lastElementChild);

            bootstrap.Modal.getInstance(document.getElementById('addColorModal')).hide();
            document.getElementById("newColorName").value = "";
            window.location.reload();
        } catch (error) {
            alert(error.message);
        }
    });

    document.getElementById("saveNewSize").addEventListener("click", async function () {
        var newSizeName = document.getElementById("newSizeName").value.trim();
        var productId = document.getElementById("modalProductIdSize").value;

        if (!newSizeName) return;

        try {
            let response = await fetch("/ProductDetail/CreateSizeDetail", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ SizeName: newSizeName, productId: productId })
            });

            if (!response.ok) throw new Error("Thêm size thất bại!");

            let newSize = await response.json();
            let tableBody = document.getElementById("sizeTableBody");
            let newRow = document.createElement("tr");
            newRow.innerHTML = `
                <td class="align-middle">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input sizeCheckbox" data-size-id="${newSize.id}" id="size_${newSize.id}">
                        <label class="form-check-label" for="size_${newSize.id}">${newSize.SizeName}</label>
                    </div>
                </td>
                <td class="align-middle">
                    <input type="number" class="form-control form-control-sm quantityInput" name="SizesQuantities[${tableBody.children.length}].QuantitySize"
                           id="quantity_${newSize.id}" min="0" value="0" style="width: 80px; margin: 0 auto;">
                    <input type="hidden" name="SizesQuantities[${tableBody.children.length}].IdSize" value="${newSize.id}">
                </td>
            `;
            tableBody.insertBefore(newRow, tableBody.firstChild); // Thêm vào đầu để giữ thứ tự lớn -> bé

            bootstrap.Modal.getInstance(document.getElementById('addSizeModal')).hide();
            document.getElementById("newSizeName").value = "";
            window.location.reload();
        } catch (error) {
            alert(error.message);
        }
    });

    (function ($) {
        $('#fileInput').on("change", function (e) {
            let file = e.target.files[0];
            if (file) {
                let reader = new FileReader();
                reader.onload = function (event) {
                    $("#imagePreview").attr("src", event.target.result).show();
                };
                reader.readAsDataURL(file);

                let form = new FormData();
                form.append("api_key", "284335524597493");
                form.append("upload_preset", "vanh2204");
                form.append("public_id", new Date().toISOString().replace(/[-:.]/g, ""));
                form.append("file", file);

                var settings = {
                    "async": true,
                    "crossDomain": true,
                    "url": "https://api.cloudinary.com/v1_1/dnvuz3evz/image/upload",
                    "method": "POST",
                    "processData": false,
                    "contentType": false,
                    "mimeType": "multipart/form-data",
                    "data": form
                };

                $.ajax(settings).done(function (response) {
                    let data = JSON.parse(response);
                    console.log(data);
                    if (data) {
                        let url = data.secure_url ?? data.url;
                        if (url) {
                            $("#imagePreview").attr("src", url);
                            $('#urlImage').val(url);
                        } else {
                            alert("Không thể tải ảnh lên. Vui lòng thử lại.");
                        }
                    }
                });
            }
        });
    })(jQuery);
</script>